{
  "name": "after/travel",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/asset": "6.4.*",
    "symfony/cache": "6.4.*",
    "symfony/config": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dependency-injection": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/error-handler": "6.4.*",
    "symfony/event-dispatcher": "6.4.*",
    "symfony/filesystem": "6.4.*",
    "symfony/finder": "6.4.*",
    "symfony/framework-bundle": "6.4.*",
    "symfony/http-foundation": "6.4.*",
    "symfony/http-kernel": "6.4.*",
    "symfony/routing": "6.4.*",
    "symfony/runtime": "6.4.*",
    "symfony/string": "6.4.*",
    "symfony/twig-bridge": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/var-dumper": "6.4.*",
    "symfony/var-exporter": "6.4.*",
    "symfony/yaml": "6.4.*",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "php bin/console cache:clear",
      "assets:install public": "php bin/console assets:install public"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
      "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
