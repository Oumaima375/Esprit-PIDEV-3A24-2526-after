{% extends 'base.html.twig' %}

{% block title %}After Travel - Ajouter un Voyage{% endblock %}

{% block body %}

<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">Ajouter un Voyage</h1>
            <p class="text-white fs-5">Créez un nouveau voyage pour vos clients</p>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-light rounded p-5">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

                <div class="mb-4">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        {{ form_label(form.date_debut) }}
                        {{ form_widget(form.date_debut) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.date_fin) }}
                        {{ form_widget(form.date_fin) }}
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        {{ form_label(form.prix) }}
                        {{ form_widget(form.prix) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.nb_places) }}
                        {{ form_widget(form.nb_places) }}
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Image</label>
                    <div class="input-group">
                        <input type="text" name="voyage_type[image]"
                               class="form-control rounded-start-pill"
                               placeholder="https://images.unsplash.com/..."
                               value="">
                        <label class="btn btn-primary rounded-end-pill mb-0" style="cursor:pointer;">
                            <i class="fa fa-folder-open me-1"></i> Choisir
                            <input type="file" name="voyage_type[imageFile]"
                                   accept="image/*"
                                   style="display:none;"
                                   onchange="document.querySelector('input[name=\'voyage_type[image]\']').value = this.files[0].name">
                        </label>
                    </div>
                    <small class="text-muted">Collez une URL ou choisissez depuis votre PC</small>
                </div>

                <div class="mb-4">
                    {{ form_label(form.id_destination) }}
                    {{ form_widget(form.id_destination) }}
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill py-2 px-5">
                        <i class="fa fa-save me-2"></i>Enregistrer
                    </button>
                    <a href="{{ path('app_voyage') }}" class="btn btn-outline-secondary rounded-pill py-2 px-4">
                        <i class="fa fa-times me-2"></i>Annuler
                    </a>
                </div>

                {{ form_end(form, {'render_rest': false}) }}
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block">
                    <i class="fas fa-envelope me-2"></i>contact@aftertravel.com
                </a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>

{% endblock %}