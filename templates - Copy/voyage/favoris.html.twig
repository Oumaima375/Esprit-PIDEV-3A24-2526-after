{% extends 'base.html.twig' %}

{% block title %}After Travel - Mes Favoris{% endblock %}

{% block body %}

<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">❤ Mes Favoris</h1>
            <p class="text-white fs-5">Vos voyages préférés sauvegardés ici</p>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        {% for voyage in voyages %}
        <div class="col-lg-4 col-md-6">
            <div class="blog-item h-100">
                <div class="blog-img">
                    <div class="blog-img-inner">
                        {% if voyage.image %}
                            <img class="img-fluid w-100 rounded-top" style="height: 220px; object-fit: cover;" src="{{ voyage.image }}" alt="{{ voyage.titre }}">
                        {% else %}
                            <img class="img-fluid w-100 rounded-top" style="height: 220px; object-fit: cover;" src="{{ asset('img/blog-1.jpg') }}" alt="Image">
                        {% endif %}
                    </div>
                    <div class="blog-info d-flex align-items-center border border-start-0 border-end-0">
                        <small class="flex-fill text-center border-end py-2">
                            <i class="fa fa-calendar-alt text-primary me-1"></i>
                            {{ voyage.date_debut ? voyage.date_debut|date('d/m/Y') : 'N/A' }}
                        </small>
                        <small class="flex-fill text-center border-end py-2">
                            <i class="fa fa-tag text-primary me-1"></i>{{ voyage.prix }} TND
                        </small>
                        <small class="flex-fill text-center py-2">
                            <i class="fa fa-users text-primary me-1"></i>{{ voyage.nb_places }} places
                        </small>
                    </div>
                </div>
                <div class="blog-content border border-top-0 rounded-bottom p-4">
                    <h4 class="mb-2">{{ voyage.titre }}</h4>
                    <p class="text-muted mb-3">{{ voyage.description|slice(0,100) }}...</p>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_voyage') }}" class="btn btn-primary rounded-pill py-1 px-3">
                            <i class="fa fa-eye me-1"></i>Voir
                        </a>
                        <a href="{{ path('app_voyage_toggle_favori', {'id': voyage.id_voyage}) }}" class="btn btn-danger rounded-pill py-1 px-3">
                            <i class="fa fa-heart-broken me-1"></i>Retirer
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <i class="fa fa-heart fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Aucun voyage en favoris</h4>
            <p class="text-muted">Ajoutez des voyages à vos favoris depuis la page Voyages</p>
            <a href="{{ path('app_voyage') }}" class="btn btn-primary rounded-pill mt-3">Voir les Voyages</a>
        </div>
        {% endfor %}
    </div>
</div>
<!-- Footer -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block"><i class="fas fa-envelope me-2"></i>contact@aftertravel.com</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>
{% endblock %}