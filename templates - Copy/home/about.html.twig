{% extends 'base.html.twig' %}

{% block title %}After Travel - About{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">About Us</h1>
        </div>
    </div>
</div>
<div class="container-fluid about py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <div class="h-100" style="border: 50px solid; border-color: transparent #13357B transparent #13357B;">
                    <img src="{{ asset('img/about-img.jpg') }}" class="img-fluid w-100 h-100" alt="">
                </div>
            </div>
            <div class="col-lg-7">
                <h5 class="section-about-title pe-3">About Us</h5>
                <h1 class="mb-4">Bienvenue sur <span class="text-primary">After Travel</span></h1>
                <p class="mb-4">After Travel est votre plateforme de voyage complète. Notre application vous permet de découvrir, planifier et organiser vos voyages en toute simplicité.</p>
                <p class="mb-4">Développée dans le cadre d'un projet universitaire à ESPRIT, cette application combine une app desktop JavaFX et une application web Symfony pour offrir une expérience complète aux voyageurs.</p>
                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Gestion des Voyages</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Gestion des Destinations</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Système de Réservation</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Gestion des Dépenses</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Planning d'Activités</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Recommandations Intelligentes</p>
                    </div>
                </div>
                <a class="btn btn-primary rounded-pill py-3 px-5 mt-2" href="{{ path('app_voyage') }}">Découvrir nos Voyages</a>
            </div>
        </div>
    </div>
</div>
<!-- Footer -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block"><i class="fas fa-envelope me-2"></i>contact@aftertravel.com</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>
{% endblock %}