{% extends 'base.html.twig' %}

{% block title %}Nouveau Service{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">Ajouter un Service</h1>
            <p class="text-white fs-5">Créez un nouveau service pour vos clients</p>
        </div>
    </div>
</div>
<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header" style="background-color: #1a3a6e; color: white;">
                    <h4 class="mb-0">➕ Ajouter un Service</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_widget(form) }}
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="{{ path('app_service_index') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{{ include('_footer.html.twig') }}
{% endblock %}
