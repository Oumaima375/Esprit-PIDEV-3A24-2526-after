{% extends 'base.html.twig' %}
{% block title %}Modifier — {{ offre.titre }}{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <h1 class="text-white display-3 mb-0">✏️ Modifier l'Offre</h1>
        <p class="text-white opacity-75">{{ offre.titre }}</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header text-white" style="background-color: #1a3a6e;">
                    <h5 class="mb-0">Modifier l'offre #{{ offre.id }}</h5>
                </div>
                <div class="card-body">
                    {{ include('offre/_form.html.twig') }}
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2">
                    <a href="{{ path('app_offre_show', {id: offre.id}) }}" class="btn btn-secondary">← Retour</a>
                    <div class="ms-auto">
                        {{ include('offre/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ include('_footer.html.twig') }}
{{ include('offre/_geo_script.html.twig') }}
{% endblock %}
