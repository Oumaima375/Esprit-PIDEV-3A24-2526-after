{% extends 'base.html.twig' %}

{% block title %}Offre — {{ offre.titre }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header" style="background-color: #1a3a6e; color: white;">
            <h4 class="mb-0">{{ offre.titre }}</h4>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tr><th>ID</th><td>{{ offre.id }}</td></tr>
                <tr><th>Titre</th><td>{{ offre.titre }}</td></tr>
                <tr><th>Prix</th><td>{{ offre.prix }} €</td></tr>
                <tr><th>Durée</th><td>{{ offre.duree }} jours</td></tr>
                <tr><th>Service</th><td>{{ offre.service.titre }}</td></tr>
                <tr><th>Créé le</th><td>{{ offre.createdAt|date('d/m/Y') }}</td></tr>
            </table>
            <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="btn btn-warning">Modifier</a>
            <a href="{{ path('app_offre_index') }}" class="btn btn-secondary">Retour</a>
            {{ include('offre/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}