{% extends 'base.html.twig' %}
{% block title %}Nouvelle offre{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <h1 class="text-white display-3 mb-0">➕ Nouvelle Offre</h1>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header text-white" style="background-color: #1a3a6e;">
                    <h5 class="mb-0">Créer une nouvelle offre</h5>
                </div>
                <div class="card-body">
                    {{ include('offre/_form.html.twig') }}
                </div>
                <div class="card-footer bg-white border-0">
                    <a href="{{ path('app_offre_index') }}" class="btn btn-secondary">← Retour</a>
                </div>
            </div>
        </div>
    </div>
</div>

{{ include('_footer.html.twig') }}
{{ include('offre/_geo_script.html.twig') }}
{% endblock %}
