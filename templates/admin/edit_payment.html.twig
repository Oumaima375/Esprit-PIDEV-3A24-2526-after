{% extends 'base.html.twig' %}

{% block title %}Modifier Paiement{% endblock %}

{% block stylesheets %}
<style>
.edit-shell {
    min-height: 100vh;
    padding: 28px;
    background: linear-gradient(180deg, #f7fbff 0%, #edf4fa 100%);
}
.edit-card {
    max-width: 1040px;
    margin: 24px auto;
    border-radius: 28px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 24px 60px -30px rgba(0, 86, 137, 0.28);
}
.edit-hero {
    padding: 34px 40px;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(135deg, #0f5b8d 0%, #0c4d78 100%);
}
.edit-icon {
    width: 46px;
    height: 32px;
    margin: 0 auto 18px;
    border-radius: 8px;
    background: #3a332e;
}
.edit-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
}
.edit-subtitle {
    margin: 10px 0 0;
    font-size: 1.05rem;
    color: rgba(255,255,255,.82);
}
.edit-body {
    padding: 30px 38px 34px;
}
.edit-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 26px;
}
.edit-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.edit-field--full {
    grid-column: 1 / -1;
}
.edit-label {
    font-size: .98rem;
    font-weight: 700;
    color: #0f5b8d;
}
.edit-input,
.edit-select,
.edit-textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #e4d5c3;
    border-radius: 18px;
    font: inherit;
    color: #14213d;
    background: #fffdfa;
    outline: none;
}
.edit-input:focus,
.edit-select:focus,
.edit-textarea:focus {
    border-color: #1d8fd6;
    box-shadow: 0 0 0 3px rgba(29, 143, 214, 0.12);
}
.edit-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
}
.edit-cancel {
    color: #5f54c6;
    font-weight: 600;
    text-decoration: none;
}
.edit-save {
    border: 0;
    border-radius: 18px;
    padding: 14px 34px;
    background: #1789d0;
    color: #ffffff;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 16px 30px -18px rgba(23, 137, 208, .8);
}
.edit-save:hover {
    background: #0f7dc1;
}
@media (max-width: 820px) {
    .edit-shell {
        padding: 16px;
    }
    .edit-body {
        padding: 22px 18px 24px;
    }
    .edit-form {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="edit-shell">
    <div class="edit-card">
        <div class="edit-hero">
            <div class="edit-icon"></div>
            <h1 class="edit-title">Modifier Paiement #{{ payment.id }}</h1>
            <p class="edit-subtitle">Veuillez remplir les details ci-dessous.</p>
        </div>

        <div class="edit-body">
            <form method="post" action="{{ submitPath }}" class="edit-form">
                <label class="edit-field edit-field--full">
                    <span class="edit-label">Reference</span>
                    <input class="edit-input" name="reference" type="text" value="{{ payment.reference }}" required>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Montant</span>
                    <input class="edit-input" name="montant" type="number" step="0.01" min="0" value="{{ payment.montant }}" required>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Devise</span>
                    <select class="edit-select" name="devise">
                        <option value="TND" {{ payment.devise == 'TND' ? 'selected' : '' }}>TND</option>
                        <option value="EUR" {{ payment.devise == 'EUR' ? 'selected' : '' }}>EUR</option>
                    </select>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Methode</span>
                    <select class="edit-select" name="methode">
                        <option value="Carte" {{ payment.methode == 'Carte' ? 'selected' : '' }}>Carte</option>
                        <option value="Virement" {{ payment.methode == 'Virement' ? 'selected' : '' }}>Virement</option>
                        <option value="Especes" {{ payment.methode == 'Especes' ? 'selected' : '' }}>Especes</option>
                        <option value="Espèces" {{ payment.methode == 'Espèces' ? 'selected' : '' }}>Especes</option>
                    </select>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Statut</span>
                    <select class="edit-select" name="statut">
                        <option value="Paye" {{ payment.status == 'Paye' ? 'selected' : '' }}>Paye</option>
                        <option value="Payé" {{ payment.status == 'Payé' ? 'selected' : '' }}>Paye</option>
                        <option value="payé" {{ payment.status == 'payé' ? 'selected' : '' }}>Paye</option>
                        <option value="En attente" {{ payment.status == 'En attente' ? 'selected' : '' }}>En attente</option>
                        <option value="Rembourse" {{ payment.status == 'Rembourse' ? 'selected' : '' }}>Rembourse</option>
                        <option value="Remboursé" {{ payment.status == 'Remboursé' ? 'selected' : '' }}>Rembourse</option>
                    </select>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Reservation #</span>
                    <input class="edit-input" name="id_reservation" type="number" value="{{ payment.reservationId }}" required>
                </label>
                <label class="edit-field">
                    <span class="edit-label">Date</span>
                    <input class="edit-input" name="date_paiement" type="date" value="{{ payment.datePaiement ? payment.datePaiement|slice(0,10) : '' }}" required>
                </label>
                <div class="edit-actions">
                    <a class="edit-cancel" href="{{ cancelPath }}">Annuler</a>
                    <button class="edit-save" type="submit">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
