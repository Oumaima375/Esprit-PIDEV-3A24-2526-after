function exportCSV() {
  let rows = [["ID","Titre","Destination","Prix","Places","Statut"]];
  document.querySelectorAll("#voyagesTable tbody tr").forEach(r => {
    let c = r.children;
    if (c.length >= 7) rows.push([c[0].innerText.trim(), c[1].innerText.trim(), c[2].innerText.trim(), c[3].innerText.trim(), c[4].innerText.trim(), c[6].innerText.trim()]);
  });
  let csv = rows.map(r => r.map(v => '"' + String(v).replace(/"/g,'""') + '"').join(",")).join("\n");
  let a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob(["\uFEFF" + csv], {type:'text/csv;charset=utf-8;'}));
  a.download = "voyages_" + new Date().toISOString().slice(0,10) + ".csv";
  a.click();
}

