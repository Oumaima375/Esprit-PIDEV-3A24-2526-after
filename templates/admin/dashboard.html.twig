  width: 56px; height: 56px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  border: none; cursor: pointer; box-shadow: 0 6px 22px rgba(79,142,247,.45);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; transition: transform .25s, box-shadow .25s;
  animation: cb-pulse 3s infinite;
}
#cb-toggle:hover { transform: scale(1.12); box-shadow: 0 10px 32px rgba(79,142,247,.6); animation: none; }
@keyframes cb-pulse { 0%,100%{box-shadow:0 6px 22px rgba(79,142,247,.45)} 50%{box-shadow:0 6px 32px rgba(124,92,252,.7)} }

/* ─── Chatbot panel ─── */
#cb-panel {
  position: fixed; bottom: 96px; right: 28px; z-index: 8999;
  width: 380px; max-height: 560px; display: flex; flex-direction: column;
  background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0,0,0,.55); overflow: hidden;
  transform: scale(.9) translateY(20px); opacity: 0; pointer-events: none;
  transition: transform .22s cubic-bezier(.34,1.56,.64,1), opacity .22s;
}
#cb-panel.open { transform: scale(1) translateY(0); opacity: 1; pointer-events: all; }

/* ─── Panel header ─── */
.cb-header {
  padding: 16px 18px; background: linear-gradient(135deg,rgba(79,142,247,.12),rgba(124,92,252,.12));
  border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; flex-shrink: 0;
}
.cb-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;
}
.cb-info { flex: 1 }
.cb-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; }
.cb-status { font-size: 11px; color: var(--success); display: flex; align-items: center; gap: 4px; }
.cb-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); animation: pulse 2s infinite; }
.cb-close { background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer; line-height: 1; padding: 4px; border-radius: 6px; transition: .2s; }
.cb-close:hover { background: var(--surface2); color: var(--text); }

/* ─── Quick chips ─── */
.cb-chips { display: flex; gap: 6px; flex-wrap: wrap; padding: 10px 14px 0; flex-shrink: 0; }
.cb-chip {
  background: var(--surface2); border: 1px solid var(--border); border-radius: 20px;
  padding: 4px 11px; font-size: 11.5px; color: var(--muted); cursor: pointer;
  transition: .2s; white-space: nowrap;
}
.cb-chip:hover { background: rgba(79,142,247,.15); border-color: var(--accent); color: var(--accent); }

/* ─── Messages ─── */
#cb-messages {
  flex: 1; overflow-y: auto; padding: 14px;
  display: flex; flex-direction: column; gap: 10px;
}
.cb-msg { max-width: 86%; animation: msgIn .18s ease; }
@keyframes msgIn { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:translateY(0)} }
.cb-msg.bot { align-self: flex-start; }
.cb-msg.user { align-self: flex-end; }
.cb-bubble {
  padding: 10px 14px; border-radius: 16px; font-size: 13.5px; line-height: 1.5;
  white-space: pre-wrap; word-break: break-word;
}
.cb-msg.bot .cb-bubble {
  background: var(--surface2); border: 1px solid var(--border);
  border-bottom-left-radius: 4px; color: var(--text);
}
.cb-msg.user .cb-bubble {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; border-bottom-right-radius: 4px;
}
.cb-time { font-size: 10px; color: var(--muted); margin-top: 3px; }
.cb-msg.user .cb-time { text-align: right; }

/* ─── Typing indicator ─── */
.cb-typing { display: flex; gap: 4px; align-items: center; padding: 10px 14px; }
.cb-typing span {
  width: 7px; height: 7px; border-radius: 50%; background: var(--muted);
  animation: cb-bounce .8s infinite;
}
.cb-typing span:nth-child(2) { animation-delay: .15s; }
.cb-typing span:nth-child(3) { animation-delay: .30s; }
@keyframes cb-bounce { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-6px)} }

/* ─── Input row ─── */
.cb-input-row {
  display: flex; gap: 8px; padding: 12px 14px;
  border-top: 1px solid var(--border); flex-shrink: 0; align-items: flex-end;
}
#cb-input {
  flex: 1; background: var(--surface2); border: 1px solid var(--border);
  border-radius: 12px; padding: 9px 13px; color: var(--text); font-size: 13.5px;
  font-family: inherit; outline: none; resize: none; max-height: 100px; overflow-y: auto;
  transition: border .2s;
}
#cb-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(79,142,247,.12); }
#cb-input::placeholder { color: var(--muted); }
#cb-send {
  width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  border: none; cursor: pointer; color: #fff; font-size: 16px;
  display: flex; align-items: center; justify-content: center; transition: .2s;
}
#cb-send:hover { opacity: .85; transform: scale(1.06); }
#cb-send:disabled { opacity: .45; transform: none; cursor: default; }

@media(max-width:768px) {
  #cb-panel { width: calc(100vw - 32px); right: 16px; }
  #cb-toggle { right: 16px; bottom: 16px; }
}
</style>

{# ── Toggle button ── #}
<button id="cb-toggle" title="AfterTravelBot — Assistant IA" onclick="toggleChatbot()">🤖</button>

{# ── Chatbot panel ── #}
<div id="cb-panel">
  <div class="cb-header">
    <div class="cb-avatar">🤖</div>
    <div class="cb-info">
      <div class="cb-name">AfterTravelBot</div>
      <div class="cb-status"><span class="cb-dot"></span> En ligne · IA connectée à la DB</div>
    </div>
    <button class="cb-close" onclick="toggleChatbot()" title="Fermer">✕</button>
  </div>

  <div class="cb-chips" id="cb-chips">
    <span class="cb-chip" onclick="cbAsk('Montre-moi tous les voyages')">🗺️ Voyages</span>
    <span class="cb-chip" onclick="cbAsk('Liste les destinations')">📍 Destinations</span>
    <span class="cb-chip" onclick="cbAsk('Combien de réservations en attente ?')">📅 Réservations</span>
    <span class="cb-chip" onclick="cbAsk('Quel est le revenu total ?')">💰 Revenus</span>
    <span class="cb-chip" onclick="cbAsk('Montre-moi les activités disponibles')">🎯 Activités</span>
    <span class="cb-chip" onclick="cbAsk('Quels utilisateurs sont admins ?')">👥 Admins</span>
  </div>

  <div id="cb-messages"></div>

  <div class="cb-input-row">
    <textarea id="cb-input" rows="1" placeholder="Posez une question sur l'app…"
      oninput="cbAutoResize(this)"
      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();cbSend();}"></textarea>
    <button id="cb-send" onclick="cbSend()" title="Envoyer">➤</button>
  </div>
</div>

{# ── Chatbot script ── #}
<script>
(function() {
  const history = [];
  let open = false;
  let busy = false;

  function toggleChatbot() {
    open = !open;
    document.getElementById('cb-panel').classList.toggle('open', open);
    if (open && history.length === 0) {
      cbAddMsg('bot',
        '👋 Bonjour ! Je suis **AfterTravelBot**, votre assistant IA connecté en direct à la base de données.\n\n' +
        'Je peux répondre à toutes vos questions sur :\n' +
        '🗺️ Voyages & Destinations\n📅 Réservations & Paiements\n👥 Utilisateurs\n🎯 Activités & Planning\n💼 Services & Offres\n📄 Documents\n\n' +
        'Que souhaitez-vous savoir ?'
      );
    }
    if (open) setTimeout(() => document.getElementById('cb-input').focus(), 120);
  }
  window.toggleChatbot = toggleChatbot;

  function cbAsk(text) {
    document.getElementById('cb-input').value = text;
    cbSend();
  }
  window.cbAsk = cbAsk;

  function cbSend() {
    const input = document.getElementById('cb-input');
    const text = input.value.trim();
    if (!text || busy) return;
    input.value = '';
    cbAutoResize(input);

    cbAddMsg('user', text);
    history.push({ role: 'user', content: text });
    cbShowTyping();
    busy = true;
    document.getElementById('cb-send').disabled = true;

    fetch('/admin/chatbot/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: history })
    })
    .then(r => r.json())
    .then(data => {
      cbHideTyping();
      busy = false;
      document.getElementById('cb-send').disabled = false;
      if (data.error) {
        cbAddMsg('bot', '❌ Erreur : ' + data.error);
      } else {
        const reply = data.response || '🤔 Aucune réponse reçue.';
        cbAddMsg('bot', reply);
        history.push({ role: 'assistant', content: reply });
        // keep history manageable (last 20 turns)
        if (history.length > 40) history.splice(0, 2);
      }
    })
    .catch(err => {
      cbHideTyping();
      busy = false;
      document.getElementById('cb-send').disabled = false;
      cbAddMsg('bot', '❌ Erreur réseau. Vérifiez votre connexion.');
    });
  }
  window.cbSend = cbSend;

  function cbAddMsg(role, text) {
    const messages = document.getElementById('cb-messages');
    const div = document.createElement('div');
    div.className = 'cb-msg ' + role;
    const now = new Date();
    const t = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
    // render **bold** and newlines
    const formatted = text
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
    div.innerHTML = `<div class="cb-bubble">${formatted}</div><div class="cb-time">${t}</div>`;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  let typingEl = null;
  function cbShowTyping() {
    if (typingEl) return;
    const messages = document.getElementById('cb-messages');
    typingEl = document.createElement('div');
    typingEl.className = 'cb-msg bot';
    typingEl.id = 'cb-typing-ind';
    typingEl.innerHTML = '<div class="cb-bubble cb-typing"><span></span><span></span><span></span></div>';
    messages.appendChild(typingEl);
    messages.scrollTop = messages.scrollHeight;
  }

  function cbHideTyping() {
    if (typingEl) { typingEl.remove(); typingEl = null; }
  }

  function cbAutoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
  }
  window.cbAutoResize = cbAutoResize;
})();
</script>

</body>
</html>
