{% extends 'admin/base_admin.html.twig' %}
{% block title %}Dashboard — AfterTravel Admin{% endblock %}
{% block body %}

<div class="header">
    <div class="header-left">
        <h1>Dashboard</h1>
        <p class="header-subtitle">Vue d'ensemble de AfterTravel</p>
    </div>
    <div class="header-right">
        <div class="user-menu">
            <div class="user-avatar">AD</div>
            <div class="user-info">
                <span class="user-name">Admin</span>
                <span class="user-role">AfterTravel</span>
            </div>
        </div>
    </div>
</div>

{# STAT CARDS #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px">
    <div class="stat-card primary">
        <div class="stat-icon"><i class="fas fa-plane" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total Voyages</div>
            <div class="stat-value">{{ totalVoyages }}</div>
            <div class="stat-change positive">voyages actifs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-map-marker-alt" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Destinations</div>
            <div class="stat-value">{{ totalDestinations }}</div>
            <div class="stat-change positive">pays disponibles</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-coins" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Prix Moyen</div>
            <div class="stat-value">{{ prixMoyen }} TND</div>
            <div class="stat-change positive">par voyage</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-chair" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Places Totales</div>
            <div class="stat-value">{{ totalPlaces }}</div>
            <div class="stat-change">disponibles</div>
        </div>
    </div>
</div>

{# CHART + TABLE #}
<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px">

    {# Prix des voyages — bar chart SVG #}
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Prix des Voyages</h2>
        </div>
        <div style="padding:16px">
            {% set maxPrix = 0 %}
            {% for v in recentVoyages %}
                {% if v.prix > maxPrix %}{% set maxPrix = v.prix %}{% endif %}
            {% endfor %}
            <svg viewBox="0 0 500 150" style="width:100%;height:150px">
                {% for v in recentVoyages %}
                    {% set barHeight = maxPrix > 0 ? (v.prix / maxPrix * 120) : 0 %}
                    {% set x = loop.index0 * 90 + 20 %}
                    <rect x="{{ x }}" y="{{ 130 - barHeight }}"
                          width="60" height="{{ barHeight }}"
                          fill="url(#barGrad)" rx="4"/>
                    <text x="{{ x + 30 }}" y="148" text-anchor="middle"
                          fill="var(--text-secondary)" font-size="9">
                        {{ v.titre|slice(0,8) }}
                    </text>
                    <text x="{{ x + 30 }}" y="{{ 125 - barHeight }}" text-anchor="middle"
                          fill="var(--accent-copper)" font-size="9" font-weight="bold">
                        {{ v.prix }}
                    </text>
                    <defs>
                        <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" style="stop-color:#b87333"/>
                            <stop offset="100%" style="stop-color:#c9845a"/>
                        </linearGradient>
                    </defs>
                {% endfor %}
            </svg>
        </div>
    </div>

    {# Top destinations #}
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Top Destinations</h2>
        </div>
        <div style="padding:8px 16px">
        {% for stat in statsDestinations %}
            <div style="display:flex;justify-content:space-between;align-items:center;
                        padding:8px 0;border-bottom:1px solid var(--border)">
                <span style="color:var(--text-primary);font-size:13px">
                    <i class="fas fa-map-pin" style="color:var(--accent-copper);margin-right:6px"></i>
                    {{ stat.pays }}
                </span>
                <div style="display:flex;align-items:center;gap:8px">
                    <div style="background:var(--border);border-radius:4px;width:60px;height:6px;overflow:hidden">
                        <div style="background:var(--accent-copper);height:100%;
                                    width:{{ statsDestinations[0].count > 0 ? (stat.count / statsDestinations[0].count * 100)|round : 0 }}%">
                        </div>
                    </div>
                    <span style="background:var(--accent-copper);color:white;
                                 padding:2px 8px;border-radius:20px;font-size:11px">
                        {{ stat.count }}
                    </span>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>

{# RECENT VOYAGES TABLE #}
<div class="card" style="margin-bottom:24px">
    <div class="card-header">
        <h2 class="card-title">Derniers Voyages</h2>
        <a href="{{ path('admin_voyage_index') }}" class="view-all">Voir tout</a>
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
            <tr style="border-bottom:1px solid var(--border)">
                <th style="padding:10px;text-align:left;color:var(--text-secondary)">Titre</th>
                <th style="padding:10px;text-align:left;color:var(--text-secondary)">Destination</th>
                <th style="padding:10px;text-align:right;color:var(--text-secondary)">Prix</th>
                <th style="padding:10px;text-align:right;color:var(--text-secondary)">Places</th>
                <th style="padding:10px;text-align:center;color:var(--text-secondary)">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for v in recentVoyages %}
            <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:10px">
                    <div style="display:flex;align-items:center;gap:8px">
                        {% if v.image and v.image starts with 'http' %}
                            <img src="{{ v.image }}" style="width:32px;height:32px;border-radius:6px;object-fit:cover">
                        {% endif %}
                        <span style="color:var(--text-primary);font-weight:500">{{ v.titre }}</span>
                    </div>
                </td>
                <td style="padding:10px;color:var(--text-secondary)">
                    {{ v.id_destination ? v.id_destination.pays : 'N/A' }}
                </td>
                <td style="padding:10px;text-align:right;color:var(--gain);font-weight:600">{{ v.prix }} TND</td>
                <td style="padding:10px;text-align:right;color:var(--text-secondary)">{{ v.nb_places }}</td>
                <td style="padding:10px;text-align:center">
                    <a href="{{ path('admin_voyage_edit', {id: v.id_voyage}) }}"
                       style="color:var(--accent-copper);text-decoration:none;
                              border:1px solid var(--accent-copper);padding:3px 10px;border-radius:6px;font-size:12px">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# QUICK ACTIONS #}
<div class="card">
    <div class="card-header"><h2 class="card-title">Actions Rapides</h2></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;padding:8px 0">
        <a href="{{ path('admin_voyage_new') }}"
           style="background:var(--accent-gradient);color:white;padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-weight:600;font-size:13px">
            <i class="fas fa-plus"></i> Ajouter Voyage
        </a>
        <a href="{{ path('admin_voyage_index') }}"
           style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
            <i class="fas fa-plane"></i> Gerer Voyages
        </a>
        <a href="{{ path('admin_destination_new') }}"
           style="background:var(--accent-gradient);color:white;padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-weight:600;font-size:13px">
            <i class="fas fa-plus"></i> Ajouter Destination
        </a>
        <a href="{{ path('admin_destination_index') }}"
           style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
            <i class="fas fa-map-marker-alt"></i> Gerer Destinations
        </a>
        <a href="{{ path('app_home') }}"
           style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
            <i class="fas fa-arrow-left"></i> Retour au site
        </a>
    </div>
</div>

{% endblock %}