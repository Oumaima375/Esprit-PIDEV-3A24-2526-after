      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Libellé</th><th>Description</th><th>Actions</th></tr></thead>
          <tbody>
            {% if categories is defined and categories|length > 0 %}
              {% for cat in categories %}
                <tr>
                  <td>{{ cat.idCategorie }}</td>
                  <td><strong>{{ cat.libelle }}</strong></td>
                  <td style="color:var(--muted);font-size:13px">{{ cat.description ?? '—' }}</td>
                  <td>
                    <div class="td-actions">
                      <button onclick="openEditCategorie({{ cat.idCategorie }},'{{ cat.libelle|e('js') }}','{{ cat.description|e('js') }}')" class="btn btn-secondary btn-sm">✏️</button>
                      <form method="post" action="{{ path('app_categorie_document_delete',{idCategorie:cat.idCategorie}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-cat-'~cat.idCategorie) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
