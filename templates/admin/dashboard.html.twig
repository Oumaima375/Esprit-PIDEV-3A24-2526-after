{% extends 'base_admin.html.twig' %}
{% block title %}Dashboard Admin - Gestion Document{% endblock %}

{% block body %}

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div style="background:#22c55e; color:white; padding:12px 20px; border-radius:8px; margin:10px 20px;">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div style="background:#ef4444; color:white; padding:12px 20px; border-radius:8px; margin:10px 20px; font-weight:bold;">
        {{ message }}
    </div>
{% endfor %}

<!-- Header -->
<div style="background:white; border-radius:16px; padding:25px 30px; margin:20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h1 style="font-size:22px; font-weight:bold; color:#1a2744; margin:0;">
        🗂 ADMIN DOCUMENT DASHBOARD
    </h1>
    <p style="color:#94a3b8; margin:4px 0 0 0; font-size:14px;">Gestion complète des documents de voyage</p>
</div>

<!-- Stats Cards -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin:0 20px 20px 20px;">

    <div style="background:#1a2744; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(26,39,68,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">📄</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ total }}</div>
        <div style="color:#94a3b8; font-size:14px; margin-top:4px;">Total Documents</div>
    </div>

    <div style="background:#2563eb; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(37,99,235,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">📂</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ totalCategories }}</div>
        <div style="color:#bfdbfe; font-size:14px; margin-top:4px;">Catégories</div>
    </div>

    <div style="background:#f5f5e8; border-radius:16px; padding:25px; text-align:center; border:2px solid #1a2744; box-shadow:0 4px 15px rgba(0,0,0,0.08);">
        <div style="font-size:30px; margin-bottom:8px;">⚠️</div>
        <div style="font-size:36px; font-weight:bold; color:#1a2744;">{{ expiresSoon }}</div>
        <div style="color:#94a3b8; font-size:14px; margin-top:4px;">Expirent dans 30j</div>
    </div>

    <div style="background:#ef4444; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(239,68,68,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">❌</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ expires }}</div>
        <div style="color:#fecaca; font-size:14px; margin-top:4px;">Expirés</div>
    </div>

</div>

<!-- Charts Row -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin:0 20px 20px 20px;">

    <div style="background:white; border-radius:16px; padding:25px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0;">🗂 Documents par catégorie</h3>
        <canvas id="pieChart" width="400" height="300"></canvas>
    </div>

    <div style="background:white; border-radius:16px; padding:25px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0;">📈 Uploads par mois</h3>
        <canvas id="barChart" width="400" height="300"></canvas>
    </div>

</div>

<!-- Gestion Catégories -->
<div style="background:white; border-radius:16px; padding:25px; margin:0 20px 20px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0; text-align:center;">🗂 Gestion des catégories</h3>

    <div style="display:flex; gap:12px; justify-content:center; margin-bottom:20px;">
        <input type="text" id="categorieInput" placeholder="Nom catégorie..."
               style="padding:10px 16px; border:2px solid #e2e8f0; border-radius:10px; font-size:14px; width:300px; outline:none;">
        <a href="{{ path('app_categorie_document_new') }}"
           style="background:#2563eb; color:white; padding:10px 20px; border-radius:10px; text-decoration:none; font-size:14px; font-weight:bold; display:flex; align-items:center; gap:6px;">
            ➕ Ajouter
        </a>
        <button onclick="modifierCategorie()"
                style="background:#1a2744; color:white; padding:10px 20px; border-radius:10px; border:none; font-size:14px; font-weight:bold; cursor:pointer;">
            ✏️ Modifier
        </button>
        <button onclick="supprimerCategorie()"
                style="background:#ef4444; color:white; padding:10px 20px; border-radius:10px; border:none; font-size:14px; font-weight:bold; cursor:pointer;">
            🗑 Supprimer
        </button>
    </div>

    <div style="border:2px solid #e2e8f0; border-radius:12px; overflow:hidden;">
        {% for cat in categories %}
        <div class="cat-item"
             data-id="{{ cat.idCategorie }}"
             data-nom="{{ cat.libelle|e('html_attr') }}"
             data-token="{{ csrf_token('delete' ~ cat.idCategorie) }}"
             style="padding:12px 20px; border-bottom:1px solid #e2e8f0; cursor:pointer; color:#1a2744; font-weight:500; font-size:14px; background:white;"
             onmouseover="if(!this.classList.contains('selected')){this.style.background='#dbeafe'; this.style.color='#2563eb';}"
             onmouseout="if(!this.classList.contains('selected')){this.style.background='white'; this.style.color='#1a2744';}">
            {{ cat.libelle }}
        </div>
        {% endfor %}
    </div>

    {% if expires > 0 %}
    <div style="text-align:center; margin-top:20px;">
        <a href="{{ path('app_admin_archiver_expires') }}"
           style="background:#ef4444; color:white; padding:12px 30px; border-radius:10px; text-decoration:none; font-size:14px; font-weight:bold;"
           onclick="return confirm('Archiver et supprimer tous les documents expirés ?')">
            🗑 Supprimer documents expirés ({{ expires }})
        </a>
    </div>
    {% endif %}
</div>

<!-- Documents Expirés -->
{% if expires > 0 %}
<div style="background:white; border-radius:16px; padding:25px; margin:0 20px 20px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h3 style="color:#ef4444; font-size:16px; margin:0 0 20px 0;">❌ Documents expirés</h3>
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#f8fafc;">
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Nom</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Catégorie</th>
                    {# TODO after merge — décommentez #}
                    {# <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Utilisateur</th> #}
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Expiré le</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in documentsExpires %}
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:12px; color:#1a2744; font-weight:500;">{{ doc.nomDocument }}</td>
                    <td style="padding:12px;">
                        <span style="background:#fee2e2; color:#ef4444; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;">
                            {{ doc.categorie ? doc.categorie.libelle : 'N/A' }}
                        </span>
                    </td>
                    {# TODO after merge — décommentez pour afficher l'email du user #}
                    {# <td style="padding:12px; color:#64748b; font-size:13px;">
                        {{ doc.user ? doc.user.email : 'N/A' }}
                    </td> #}
                    <td style="padding:12px; color:#ef4444; font-weight:bold;">
                        {{ doc.dateExpiration ? doc.dateExpiration|date('d/m/Y') : 'N/A' }}
                    </td>
                    <td style="padding:12px;">
                        <form method="post"
                              action="{{ path('app_document_crud_delete', {'idDocument': doc.idDocument}) }}"
                              onsubmit="return confirm('Supprimer ?')" style="display:inline">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ doc.idDocument) }}">
                            <button style="background:#ef4444; color:white; border:none; padding:6px 12px; border-radius:8px; cursor:pointer; font-size:13px;">
                                🗑
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<!-- Tous les Documents — Vue Admin -->
<div style="background:white; border-radius:16px; padding:25px; margin:0 20px 20px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0;">📋 Tous les Documents</h3>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#f8fafc;">
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">#</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Nom</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Catégorie</th>
                    {# TODO after merge — décommentez pour afficher l'utilisateur #}
                    {# <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Utilisateur</th> #}
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">
                        Utilisateur
                        <small style="color:#cbd5e1; font-weight:normal;">(après intégration)</small>
                    </th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Date Ajout</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Date Expiration</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Fichier</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Statut</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">
                        Actions
                        <small style="color:#cbd5e1; font-weight:normal;">(lecture seule après merge)</small>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for doc in allDocuments %}
                <tr style="border-bottom:1px solid #f1f5f9; transition:background 0.2s;"
                    onmouseover="this.style.background='#f8fafc'"
                    onmouseout="this.style.background='white'">

                    <td style="padding:12px; color:#94a3b8; font-size:13px;">{{ doc.idDocument }}</td>

                    <td style="padding:12px; color:#1a2744; font-weight:600;">{{ doc.nomDocument }}</td>

                    <td style="padding:12px;">
                        <span style="background:#dbeafe; color:#2563eb; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;">
                            {{ doc.categorie ? doc.categorie.libelle : 'N/A' }}
                        </span>
                    </td>

                    {# Colonne Utilisateur — actuellement vide, active après merge #}
                    <td style="padding:12px;">
                        {# TODO after merge — remplacez par : {{ doc.user ? doc.user.email : 'N/A' }} #}
                        <span style="background:#f1f5f9; color:#94a3b8; padding:4px 10px; border-radius:20px; font-size:11px;">
                            🔒 Après intégration
                        </span>
                    </td>

                    <td style="padding:12px; color:#64748b; font-size:13px;">
                        {{ doc.dateAjout ? doc.dateAjout|date('d/m/Y') : 'N/A' }}
                    </td>

                    <td style="padding:12px; font-size:13px;
                        {% if doc.dateExpiration and doc.dateExpiration < date() %}
                            color:#ef4444; font-weight:bold;
                        {% else %}
                            color:#22c55e;
                        {% endif %}">
                        {{ doc.dateExpiration ? doc.dateExpiration|date('d/m/Y') : 'N/A' }}
                    </td>

                    <td style="padding:12px;">
                        {% if doc.cheminFichier and doc.cheminFichier != 'aucun_fichier' %}
                            {% if doc.cheminFichier starts with 'http' %}
                                <a href="{{ doc.cheminFichier }}" target="_blank"
                                   style="color:#2563eb; font-size:13px;">🔗 Voir</a>
                            {% else %}
                                <span style="color:#94a3b8; font-size:12px;">📎 {{ doc.cheminFichier|slice(0,20) }}...</span>
                            {% endif %}
                        {% else %}
                            <span style="color:#cbd5e1; font-size:12px;">Aucun</span>
                        {% endif %}
                    </td>

                    <td style="padding:12px;">
                        {% if doc.dateExpiration and doc.dateExpiration < date() %}
                            <span style="background:#fee2e2; color:#ef4444; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;">❌ Expiré</span>
                        {% else %}
                            <span style="background:#dcfce7; color:#16a34a; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;">✅ Valide</span>
                        {% endif %}
                    </td>

                    <td style="padding:12px;">
                        <div style="display:flex; gap:6px;">
                            {# Bouton Voir — toujours disponible pour l'admin #}
                            <a href="{{ path('app_document_crud_show', {'idDocument': doc.idDocument}) }}"
                               style="background:#2563eb; color:white; padding:5px 10px; border-radius:8px; text-decoration:none; font-size:12px;">
                                👁
                            </a>

                            {# TODO after merge — bloquez ces boutons pour l'admin #}
                            {# Remplacez par : #}
                            {# {% if not is_granted('ROLE_ADMIN') %} #}
                            <a href="{{ path('app_document_crud_edit', {'idDocument': doc.idDocument}) }}"
                               style="background:#f59e0b; color:white; padding:5px 10px; border-radius:8px; text-decoration:none; font-size:12px;"
                               title="Désactivé pour admin après intégration">
                                ✏️
                            </a>
                            <form method="post"
                                  action="{{ path('app_document_crud_delete', {'idDocument': doc.idDocument}) }}"
                                  onsubmit="return confirm('Supprimer ce document ?')"
                                  style="display:inline">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete' ~ doc.idDocument) }}">
                                <button style="background:#ef4444; color:white; border:none; padding:5px 10px; border-radius:8px; cursor:pointer; font-size:12px;"
                                        title="Désactivé pour admin après intégration">
                                    🗑
                                </button>
                            </form>
                            {# {% endif %} #}
                        </div>
                    </td>

                </tr>
                {% else %}
                <tr>
                    <td colspan="9" style="padding:30px; text-align:center; color:#94a3b8;">
                        Aucun document
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{{ parent() }}
<script>
    let selectedCategorieId  = null;
    let selectedCategorieNom = null;
    let selectedToken        = null;

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.cat-item').forEach(item => {
            item.addEventListener('click', function() {
                selectedCategorieId  = this.dataset.id;
                selectedCategorieNom = this.dataset.nom;
                selectedToken        = this.dataset.token;
                document.getElementById('categorieInput').value = selectedCategorieNom;

                document.querySelectorAll('.cat-item').forEach(el => {
                    el.style.background = 'white';
                    el.style.color      = '#1a2744';
                    el.classList.remove('selected');
                });

                this.style.background = '#dbeafe';
                this.style.color      = '#2563eb';
                this.classList.add('selected');
            });
        });
    });

    function modifierCategorie() {
        if (!selectedCategorieId) { alert('⚠️ Sélectionnez une catégorie !'); return; }
        window.location.href = '/categorie/document/' + selectedCategorieId + '/edit';
    }

    function supprimerCategorie() {
        if (!selectedCategorieId) { alert('⚠️ Sélectionnez une catégorie !'); return; }
        if (!confirm('Supprimer "' + selectedCategorieNom + '" ?')) return;

        const form       = document.createElement('form');
        form.method      = 'POST';
        form.action      = '/categorie/document/' + selectedCategorieId;
        const tokenInput = document.createElement('input');
        tokenInput.type  = 'hidden';
        tokenInput.name  = '_token';
        tokenInput.value = selectedToken;
        form.appendChild(tokenInput);
        document.body.appendChild(form);
        form.submit();
    }

    // Auto-refresh 30s
    setTimeout(() => window.location.reload(), 30000);

    // ===== PieChart =====
    const pieCtx = document.getElementById('pieChart').getContext('2d');
    new Chart(pieCtx, {
        type: 'pie',
        data: {
            labels: [{% for row in parCategorie %}'{{ row.libelle|e('js') }}',{% endfor %}],
            datasets: [{
                data: [{% for row in parCategorie %}{{ row.total }},{% endfor %}],
                backgroundColor: [
                    '#2563eb','#ef4444','#22c55e','#f59e0b',
                    '#8b5cf6','#06b6d4','#ec4899','#14b8a6'
                ],
                borderWidth: 2,
                borderColor: 'white'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // ===== BarChart =====
    const barCtx = document.getElementById('barChart').getContext('2d');
    new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: [{% for row in uploadsParMois %}'{{ row.month }}',{% endfor %}],
            datasets: [{
                label: 'Uploads',
                data: [{% for row in uploadsParMois %}{{ row.total }},{% endfor %}],
                backgroundColor: '#ef4444',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: { y: { beginAtZero: true } }
        }
    });
</script>
{% endblock %}