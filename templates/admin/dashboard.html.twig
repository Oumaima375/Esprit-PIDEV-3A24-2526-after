{% extends 'admin/base_admin.html.twig' %}
{% block title %}Dashboard — AfterTravel Admin{% endblock %}
{% block body %}
<div class="header">
 <div class="header-left">
 <h1>Dashboard</h1>
 <p class="header-subtitle">Vue d'ensemble de AfterTravel</p>
 </div>
 <div class="header-right">
 <div class="user-menu">
 <div class="user-avatar">AD</div>
 <div class="user-info">
 <span class="user-name">Admin</span>
 <span class="user-role">AfterTravel</span>
 </div>
 </div>
 </div>
</div>
{# STAT CARDS #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px">
 <div class="stat-card primary">
 <div class="stat-icon"><i class="fas fa-plane" style="font-size:22px"></i></div>
 <div class="stat-content">
 <div class="stat-label">Total Voyages</div>
 <div class="stat-value">{{ totalVoyages }}</div>
 <div class="stat-change">voyages actifs</div>
 </div>
 </div>
 <div class="stat-card">
 <div class="stat-icon"><i class="fas fa-map-marker-alt" style="font-size:22px"></i></div>
 <div class="stat-content">
 <div class="stat-label">Destinations</div>
 <div class="stat-value">{{ totalDestinations }}</div>
 <div class="stat-change positive">pays disponibles</div>
 </div>
 </div>
<div class="stat-card">
 <div class="stat-icon"><i class="fas fa-coins" style="font-size:22px"></i></div>
 <div class="stat-content">
 <div class="stat-label">Prix Moyen</div>
 <div class="stat-value">{{ prixMoyen }} TND</div>
 <div class="stat-change positive">par voyage</div>
 </div>
 </div>
</div>
{# TWO COLUMNS #}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
 <div class="card">
 <div class="card-header">
 <h2 class="card-title">Derniers Voyages</h2>
 <a href="{{ path('admin_voyage_index') }}" class="view-all">Voir tout</a>
 </div>
 <table style="width:100%;border-collapse:collapse;font-size:13px">
 <thead>
<tr style="border-bottom:1px solid var(--border)">
 <th style="padding:8px;text-align:left;color:var(--text-secondary)">Titre</th>
 <th style="padding:8px;text-align:right;color:var(--text-secondary)">Prix</th>
 <th style="padding:8px;text-align:right;color:var(--text-secondary)">Places</th>
 </tr>
 </thead><tbody>
 {% for v in recentVoyages %}
 <tr style="border-bottom:1px solid var(--border)">
 <td style="padding:8px;color:var(--text-primary)">{{ v.titre }}</td>
 <td style="padding:8px;text-align:right;color:var(--gain)">{{ v.prix }} TND</td>
 <td style="padding:8px;text-align:right;color:var(--text-secondary)">{{ v.nb_places }}</td>
 </tr>
 {% else %}
 <tr><td colspan="3" style="padding:16px;text-align:center;color:var(--text-muted)">Aucun voyage</td></t {% endfor %}
 </tbody>
 </table>
 </div>
 <div class="card">
 <div class="card-header">
 <h2 class="card-title">Voyages par Destination</h2>
 </div>
 <table style="width:100%;border-collapse:collapse;font-size:13px">
 <thead>
 <tr style="border-bottom:1px solid var(--border)">
 <th style="padding:8px;text-align:left;color:var(--text-secondary)">Pays</th>
 <th style="padding:8px;text-align:right;color:var(--text-secondary)">Voyages</th>
 </tr>
 </thead>
 <tbody>
 {% for stat in statsDestinations %}
 <tr style="border-bottom:1px solid var(--border)">
 <td style="padding:8px;color:var(--text-primary)">{{ stat.pays }}</td>
 <td style="padding:8px;text-align:right">
 <span style="background:var(--accent-copper);color:white;
 padding:2px 10px;border-radius:20px;font-size:11px">
 {{ stat.count }}
 </span>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
</div>
{# QUICK ACTIONS #}
<div class="card">
<div class="card-header"><h2 class="card-title">Actions Rapides</h2></div>
 <div style="display:flex;gap:12px;flex-wrap:wrap;padding:8px 0">
 <a href="{{ path('admin_voyage_new') }}"
 style="background:var(--accent-gradient);color:white;padding:10px 20px;
 border-radius:8px;text-decoration:none;font-weight:600;font-size:13px">
 <i class="fas fa-plus"></i> Ajouter Voyage
 </a>
 <a href="{{ path('admin_voyage_index') }}"
 style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
 border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
 <i class="fas fa-plane"></i> Gerer Voyages
 </a>
 <a href="{{ path('admin_destination_new') }}"
 style="background:var(--accent-gradient);color:white;padding:10px 20px;
 border-radius:8px;text-decoration:none;font-weight:600;font-size:13px">
 <i class="fas fa-plus"></i> Ajouter Destination
 </a>
 <a href="{{ path('admin_destination_index') }}"
 style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
 border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
 <i class="fas fa-map-marker-alt"></i> Gerer Destinations
 </a>
 <a href="{{ path('app_home') }}"
 style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;
 border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)">
 <i class="fas fa-arrow-left"></i> Retour au site
 </a>
 </div>
</div>
{% endblock %}