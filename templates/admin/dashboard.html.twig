  <div class="page-content" id="page-reservation">
    <div class="tabs">
      <div class="tab active" onclick="switchTab('reservation','reservations',this)">📅 Réservations</div>
      <div class="tab" onclick="switchTab('reservation','paiements',this)">💳 Paiements</div>
    </div>

    <div id="reservation-tab-reservations">
      <div class="section-header">
        <div class="section-title">Gestion des Réservations</div>
        <button class="btn btn-primary" onclick="openModal('modal-reservation-add')">＋ Ajouter Réservation</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Utilisateur</th><th>Voyage</th><th>Date</th><th>Personnes</th><th>Total</th><th>Statut</th><th>Actions</th></tr></thead>
          <tbody>
            {% if reservations is defined and reservations|length > 0 %}
              {% for r in reservations %}
                <tr>
                  <td>{{ r.id }}</td>
                  <td>#{{ r.utilisateurId }}</td>
                  <td>#{{ r.voyageId }}</td>
                  <td>{{ r.dateReservation ? r.dateReservation|date('d/m/Y') : '—' }}</td>
                  <td>{{ r.nbPersonnes ?? '—' }}</td>
                  <td><strong>{{ r.prixTotal is not null ? r.prixTotal~' TND' : '—' }}</strong></td>
                  <td>
                    {%- set s = r.statut|lower -%}
                    {%- if 'confirm' in s %}<span class="chip chip-green">Confirmé</span>
                    {%- elseif 'attente' in s %}<span class="chip chip-orange">En attente</span>
                    {%- elseif 'pay' in s %}<span class="chip chip-blue">Payé</span>
                    {%- elseif 'annul' in s %}<span class="chip chip-red">Annulé</span>
                    {%- else %}<span class="chip chip-purple">{{ r.statut }}</span>{%- endif %}
                  </td>
                  <td>
                    <div class="td-actions">
                      <button onclick="openEditReservation({{ r.id }},'{{ r.statut|e('js') }}',{{ r.nbPersonnes ?? 0 }},{{ r.prixTotal ?? 0 }})" class="btn btn-secondary btn-sm">✏️</button>
                      <form method="post" action="{{ path('app_admin_reservation_delete',{id:r.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-res-'~r.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr class="empty-row"><td colspan="8">Aucune réservation trouvée</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>

    <div id="reservation-tab-paiements" style="display:none">
      <div class="section-header">
        <div class="section-title">Gestion des Paiements</div>
        <button class="btn btn-primary" onclick="openModal('modal-paiement-add')">＋ Ajouter Paiement</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Référence</th><th>Réservation</th><th>Montant</th><th>Méthode</th><th>Date</th><th>Statut</th><th>Actions</th></tr></thead>
          <tbody>
            {% if payments is defined and payments|length > 0 %}
              {% for p in payments %}
                <tr>
                  <td>{{ p.id }}</td>
                  <td><code style="font-size:12px;color:var(--accent)">{{ p.reference }}</code></td>
                  <td>#{{ p.reservationId }}</td>
                  <td><strong>{{ p.montant }} {{ p.devise }}</strong></td>
                  <td><span class="chip chip-teal">{{ p.methode }}</span></td>
                  <td>{{ p.datePaiementObject ? p.datePaiementObject|date('d/m/Y') : '—' }}</td>
                  <td>
                    {%- set ps = p.statut|lower -%}
                    {%- if 'success' in ps or 'succès' in ps or 'complet' in ps %}<span class="chip chip-green">Succès</span>
                    {%- elseif 'pending' in ps or 'attente' in ps %}<span class="chip chip-orange">En attente</span>
                    {%- elseif 'fail' in ps or 'echec' in ps or 'échoué' in ps %}<span class="chip chip-red">Échoué</span>
                    {%- elseif 'refund' in ps or 'rembours' in ps %}<span class="chip chip-purple">Remboursé</span>
                    {%- else %}<span class="chip chip-blue">{{ p.statut }}</span>{%- endif %}
                  </td>
                  <td>
                    <div class="td-actions">
                      <button onclick="openEditPaiement({{ p.id }},'{{ p.reference|e('js') }}',{{ p.montant }},'{{ p.methode|e('js') }}','{{ p.statut|e('js') }}')" class="btn btn-secondary btn-sm">✏️</button>
                      <form method="post" action="{{ path('app_admin_payment_delete',{id:p.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-pay-'~p.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr class="empty-row"><td colspan="8">Aucun paiement trouvé</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

