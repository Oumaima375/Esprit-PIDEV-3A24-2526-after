        </table>
      </div>
    </div>
    <div id="service-tab-offres" style="display:none">
      <div class="section-header">
        <div class="section-title">Toutes les Offres</div>
        <button class="btn btn-primary" onclick="openModal('modal-offre-add')">＋ Ajouter Offre</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Titre</th><th>Prix</th><th>Durée</th><th>Actions</th></tr></thead>
          <tbody>
            {% if offres is defined and offres|length > 0 %}
              {% for o in offres %}
                <tr>
                  <td>{{ o.id }}</td>
                  <td><strong>{{ o.titre ?? '—' }}</strong></td>
                  <td>{{ o.prix is not null ? o.prix~' TND' : '—' }}</td>
                  <td>{{ o.duree is not null ? o.duree~' j' : '—' }}</td>
                  <td>
                    <div class="td-actions">
                      <button onclick="openEditOffre({{ o.id }},'{{ o.titre|e('js') }}',{{ o.prix ?? 0 }},{{ o.duree ?? 0 }})" class="btn btn-secondary btn-sm">✏️</button>
                      <form method="post" action="{{ path('app_offre_delete',{id:o.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-offre-'~o.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr class="empty-row"><td colspan="5">Aucune offre trouvée</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {# ════ DEPENSE ════ #}
  
  <div class="page-content" id="page-depense">
    <div class="section-header">
      <div class="section-title">💰 Gestion des Dépenses</div>
      <div class="btn-group">
        <a href="{{ path('depense_new') }}" class="btn btn-primary">➕ Nouvelle Dépense</a>
        <a href="{{ path('rapport_index') }}" class="btn btn-secondary">📊 Rapport</a>
        <a href="{{ path('carte_depenses') }}" class="btn btn-secondary">🗺️ Carte</a>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Titre</th><th>Catégorie</th><th>Montant</th><th>Date</th><th>Actions</th></tr></thead>
        <tbody>
          {% if depenses is defined and depenses|length > 0 %}
            {% for dep in depenses %}
              <tr>
                <td>{{ dep.idDep ?? dep.id ?? '—' }}</td>
                <td>{{ dep.titre ?? '—' }}</td>
                <td>
                  <span class="chip chip-orange">
                    {{ dep.idCategorie is not null ? dep.idCategorie.nomCategorie : '—' }}
                  </span>
                </td>
                <td><strong>{{ dep.montant is not null ? dep.montant~' TND' : '—' }}</strong></td>
                <td>{{ dep.dateDepense is not null ? dep.dateDepense|date('d/m/Y') : '—' }}</td>
                <td>
                  <div class="td-actions">
                    <a href="{{ path('depense_show', {id: dep.idDep ?? dep.id}) }}" class="btn btn-sm btn-secondary">👁️</a>
                    <a href="{{ path('depense_edit', {id: dep.idDep ?? dep.id}) }}" class="btn btn-sm btn-warning">✏️</a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          {% else %}
            <tr class="empty-row"><td colspan="6">Aucune dépense trouvée</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>

</div>
