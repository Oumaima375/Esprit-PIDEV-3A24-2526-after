<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TravelAdmin — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0d0f14; --surface: #14171f; --surface2: #1c2030; --border: #252a3a;
    --accent: #4f8ef7; --accent2: #7c5cfc; --accent3: #f7774f; --accent4: #4fd1c5;
    --success: #48bb78; --danger: #fc5c7d; --warning: #f6c94e;
    --text: #e8ecf5; --muted: #8892aa; --sidebar-w: 248px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; overflow-x: hidden; }
  #sidebar { width: var(--sidebar-w); min-height: 100vh; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; z-index: 100; }
  .sidebar-logo { padding: 24px 20px 18px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border); }
  .logo-icon { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .logo-text { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 18px; color: var(--text); letter-spacing: -.5px; }
  .logo-sub { font-size: 10px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  nav { flex: 1; padding: 14px 0; overflow-y: auto; }
  .nav-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); padding: 10px 20px 5px; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 16px; margin: 2px 8px; border-radius: 10px; cursor: pointer; transition: all .2s; color: var(--muted); font-size: 13.5px; font-weight: 500; position: relative; text-decoration: none; border: none; background: none; width: calc(100% - 16px); text-align: left; }
  .nav-item:hover { background: var(--surface2); color: var(--text); }
  .nav-item.active { background: linear-gradient(135deg,rgba(79,142,247,.15),rgba(124,92,252,.15)); color: var(--text); }
  .nav-item.active::before { content:''; position:absolute; left:0; top:50%; transform:translateY(-50%); width:3px; height:60%; background:linear-gradient(var(--accent),var(--accent2)); border-radius:0 3px 3px 0; }
  .nav-item .icon { width:30px; height:30px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; background:var(--surface2); }
  .nav-item.active .icon { background:linear-gradient(135deg,var(--accent),var(--accent2)); }
  .badge { margin-left:auto; background:var(--accent3); color:#fff; font-size:10px; padding:2px 7px; border-radius:10px; font-weight:600; }
  .sidebar-footer { padding:14px; border-top:1px solid var(--border); }
  .logout-btn { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:10px; background:rgba(252,92,125,.08); color:var(--danger); cursor:pointer; transition:.2s; font-size:13px; font-weight:500; border:1px solid rgba(252,92,125,.15); width:100%; text-decoration:none; }
  .logout-btn:hover { background:rgba(252,92,125,.18); }
  #main { margin-left: var(--sidebar-w); flex: 1; min-height: 100vh; display: flex; flex-direction: column; }
  .topbar { height:60px; background:var(--surface); border-bottom:1px solid var(--border); display:flex; align-items:center; padding:0 24px; gap:14px; position:sticky; top:0; z-index:50; }
  .topbar-title { font-family:'Syne',sans-serif; font-weight:700; font-size:17px; flex:1; }
  .topbar-search { display:flex; align-items:center; gap:8px; background:var(--surface2); border:1px solid var(--border); border-radius:10px; padding:7px 13px; width:220px; }
  .topbar-search input { background:none; border:none; outline:none; color:var(--text); font-size:13px; font-family:inherit; width:100%; }
  .topbar-search input::placeholder { color:var(--muted); }
  .avatar { width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--accent2)); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; cursor:pointer; flex-shrink:0; }
  .page-content { padding:24px; display:none; animation:fadeIn .2s ease; }
  .page-content.active { display:block; }
  @keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
  .stats-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:14px; margin-bottom:24px; }
  .stat-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:18px; display:flex; flex-direction:column; gap:8px; transition:transform .2s,box-shadow .2s; }
  .stat-card:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(0,0,0,.3); }
  .stat-icon { width:40px; height:40px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:19px; }
  .stat-num { font-family:'Syne',sans-serif; font-size:26px; font-weight:800; }
  .stat-label { font-size:12.5px; color:var(--muted); }
  .stat-trend { font-size:12px; margin-top:2px; }
  .stat-trend.up { color:var(--success); }
  .stat-trend.down { color:var(--danger); }
  .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:10px; }
  .section-title { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; }
  .btn-group { display:flex; gap:7px; flex-wrap:wrap; }
  .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 15px; border-radius:9px; font-size:13px; font-weight:500; cursor:pointer; border:none; font-family:inherit; transition:.2s; text-decoration:none; }
  .btn-primary { background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; }
  .btn-primary:hover { opacity:.88; transform:translateY(-1px); box-shadow:0 4px 14px rgba(79,142,247,.3); }
  .btn-secondary { background:var(--surface2); color:var(--text); border:1px solid var(--border); }
  .btn-secondary:hover { background:var(--border); color:var(--text); }
  .btn-danger { background:rgba(252,92,125,.12); color:var(--danger); border:1px solid rgba(252,92,125,.22); }
  .btn-danger:hover { background:rgba(252,92,125,.22); }
  .btn-success { background:rgba(72,187,120,.12); color:var(--success); border:1px solid rgba(72,187,120,.22); }
  .btn-success:hover { background:rgba(72,187,120,.22); }
  .btn-warning { background:rgba(246,201,78,.12); color:var(--warning); border:1px solid rgba(246,201,78,.22); }
  .btn-warning:hover { background:rgba(246,201,78,.22); }
  .btn-sm { padding:5px 9px; font-size:12px; border-radius:7px; }
  .table-wrap { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; margin-bottom:20px; overflow-x:auto; }
  table { width:100%; border-collapse:collapse; }
  thead th { padding:12px 14px; text-align:left; font-size:10.5px; letter-spacing:1px; text-transform:uppercase; color:var(--muted); background:var(--surface2); font-weight:600; border-bottom:1px solid var(--border); white-space:nowrap; }
  tbody tr { border-bottom:1px solid var(--border); transition:background .15s; }
  tbody tr:last-child { border-bottom:none; }
  tbody tr:hover { background:var(--surface2); }
  tbody td { padding:11px 14px; font-size:13.5px; }
  .td-actions { display:flex; gap:5px; flex-wrap:wrap; }
  .chip { display:inline-flex; align-items:center; padding:3px 9px; border-radius:20px; font-size:11px; font-weight:600; white-space:nowrap; }
  .chip-blue   { background:rgba(79,142,247,.15);  color:var(--accent);  }
  .chip-green  { background:rgba(72,187,120,.15);  color:var(--success); }
  .chip-orange { background:rgba(247,119,79,.15);  color:var(--accent3); }
  .chip-red    { background:rgba(252,92,125,.15);  color:var(--danger);  }
  .chip-purple { background:rgba(124,92,252,.15);  color:var(--accent2); }
  .chip-teal   { background:rgba(79,209,197,.15);  color:var(--accent4); }
  .chip-yellow { background:rgba(246,201,78,.15);  color:var(--warning); }
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.82); backdrop-filter:blur(6px); z-index:300; display:none; align-items:center; justify-content:center; padding:16px; }
  .modal-overlay.open { display:flex; }
  .modal { background:var(--surface); border:1px solid var(--border); border-radius:20px; padding:26px; width:100%; max-width:560px; max-height:90vh; overflow-y:auto; animation:modalIn .22s ease; }
  .modal-lg { max-width:680px; }
  @keyframes modalIn { from{opacity:0;transform:scale(.94) translateY(10px)} to{opacity:1;transform:scale(1) translateY(0)} }
  .modal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
  .modal-title { font-family:'Syne',sans-serif; font-size:17px; font-weight:700; display:flex; align-items:center; gap:8px; }
  .modal-close { width:30px; height:30px; border-radius:8px; background:var(--surface2); border:none; color:var(--muted); font-size:17px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:.2s; flex-shrink:0; }
  .modal-close:hover { background:var(--border); color:var(--text); }
  .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:13px; }
  .form-grid .full { grid-column:1/-1; }
  .form-group { display:flex; flex-direction:column; gap:5px; }
  .form-group label { font-size:11px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.6px; }
  .form-group input, .form-group select, .form-group textarea { background:var(--surface2); border:1px solid var(--border); border-radius:9px; padding:9px 12px; color:var(--text); font-size:13.5px; font-family:inherit; outline:none; transition:border .2s,box-shadow .2s; width:100%; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(79,142,247,.12); }
  .form-group textarea { resize:vertical; min-height:78px; }
  .form-group select option { background:var(--surface2); }
  .form-actions { display:flex; gap:9px; justify-content:flex-end; margin-top:18px; padding-top:16px; border-top:1px solid var(--border); }
  .tabs { display:flex; gap:3px; background:var(--surface2); border-radius:11px; padding:4px; margin-bottom:16px; width:fit-content; }
  .tab { padding:7px 16px; border-radius:8px; cursor:pointer; font-size:13px; font-weight:500; transition:.2s; color:var(--muted); }
  .tab.active { background:var(--surface); color:var(--text); box-shadow:0 2px 8px rgba(0,0,0,.3); }
  .flash-wrap { padding:14px 24px 0; }
  .flash-success { background:rgba(72,187,120,.12); border:1px solid rgba(72,187,120,.28); color:var(--success); padding:11px 16px; border-radius:10px; font-size:13.5px; }
  .flash-error   { background:rgba(252,92,125,.12); border:1px solid rgba(252,92,125,.28); color:var(--danger);  padding:11px 16px; border-radius:10px; font-size:13.5px; }
  #toast { position:fixed; bottom:24px; right:24px; background:var(--success); color:#fff; padding:11px 18px; border-radius:11px; font-size:13.5px; font-weight:500; box-shadow:0 8px 24px rgba(0,0,0,.4); display:none; z-index:999; max-width:340px; }
  .empty-row td { color:var(--muted); text-align:center; padding:22px; font-style:italic; }
  .api-banner { background:linear-gradient(135deg,rgba(79,142,247,.08),rgba(124,92,252,.08)); border:1px solid rgba(79,142,247,.2); border-radius:12px; padding:13px 17px; margin-bottom:18px; display:flex; align-items:center; gap:12px; font-size:13px; }
  .api-dot { width:8px; height:8px; border-radius:50%; background:var(--success); box-shadow:0 0 8px var(--success); flex-shrink:0; animation:pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
  .dest-api-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:14px; margin-bottom:20px; }
  .dest-api-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; transition:transform .2s,box-shadow .2s; }
  .dest-api-card:hover { transform:translateY(-3px); box-shadow:0 10px 32px rgba(0,0,0,.35); }
  .dest-api-img { width:100%; height:120px; object-fit:cover; background:var(--surface2); }
  .dest-api-img-ph { width:100%; height:120px; background:linear-gradient(135deg,var(--surface2),var(--border)); display:flex; align-items:center; justify-content:center; font-size:32px; }
  .dest-api-body { padding:13px; }
  .dest-api-name { font-family:'Syne',sans-serif; font-size:14px; font-weight:700; margin-bottom:3px; }
  .dest-api-sub { font-size:12px; color:var(--muted); margin-bottom:9px; }
  .dest-api-meta { display:flex; gap:5px; flex-wrap:wrap; }
  .weather-row { display:grid; grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:12px; margin-bottom:20px; }
  .weather-card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:14px; text-align:center; }
  .weather-icon { font-size:28px; margin-bottom:6px; }
  .weather-temp { font-family:'Syne',sans-serif; font-size:22px; font-weight:700; }
  .weather-city { font-size:12px; color:var(--muted); margin-top:2px; }
  ::-webkit-scrollbar { width:5px; height:5px; }
  ::-webkit-scrollbar-track { background:transparent; }
  ::-webkit-scrollbar-thumb { background:var(--border); border-radius:10px; }
  @media(max-width:768px) {
    #sidebar { transform:translateX(-100%); }
    #main { margin-left:0; }
    .stats-grid { grid-template-columns:1fr 1fr; }
    .form-grid { grid-template-columns:1fr; }
    .form-grid .full { grid-column:1; }
  }
</style>
</head>
<body>
{# ═══ SIDEBAR ═══ #}
<aside id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">✈️</div>
    <div>
      <div class="logo-text">ADMIN</div>
      <div class="logo-sub">AFTER TRAVEL</div>
    </div>
  </div>
  <nav>
    <div class="nav-label">Principal</div>
    <button class="nav-item active" onclick="showPage('dashboard',this)">
      <span class="icon">🏠</span> Dashboard
    </button>
    <div class="nav-label">Gestion</div>
    <button class="nav-item" onclick="showPage('users',this)">
      <span class="icon">👥</span> Utilisateurs
    </button>
    <button class="nav-item" onclick="showPage('voyage',this)">
      <span class="icon">🗺️</span> Voyages &amp; Destinations
    </button>
    <button class="nav-item" onclick="showPage('activite',this)">
      <span class="icon">🎯</span> Activités &amp; Planning
    </button>
    <button class="nav-item" onclick="showPage('document',this)">
      <span class="icon">📄</span> Documents &amp; Catégories
    </button>
    <button class="nav-item" onclick="showPage('reservation',this)">
      <span class="icon">📅</span> Réservations &amp; Paiements
      {% if reservations is defined and reservations|length > 0 %}
        <span class="badge">{{ reservations|length }}</span>
      {% endif %}
    </button>
    <button class="nav-item" onclick="showPage('service',this)">
      <span class="icon">💼</span> Services &amp; Offres
    </button>
    <button class="nav-item" onclick="showPage('depense',this)">
      <span class="icon">💰</span> Dépenses
    </button>
  </nav>
  <div class="sidebar-footer">
    <a href="{{ path('_logout_main') }}" class="logout-btn">
      <span>🔓</span> Se déconnecter
    </a>
  </div>
</aside>

{# ═══ MAIN ═══ #}
<div id="main">
  <div class="topbar">
    <div class="topbar-title" id="topbar-title">Dashboard</div>
    <div class="topbar-search">
      <span>🔍</span>
      <input type="text" placeholder="Rechercher…" oninput="filterTable(this.value)"/>
    </div>
    <div class="avatar" title="{{ app.user ? app.user.userIdentifier : 'Admin' }}">
      {{ app.user ? app.user.userIdentifier|slice(0,2)|upper : 'AD' }}
    </div>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="flash-wrap">
        <div class="flash-{{ label == 'success' ? 'success' : 'error' }}">{{ message }}</div>
      </div>
    {% endfor %}
  {% endfor %}

  {# ════ DASHBOARD ════ #}
  <div class="page-content active" id="page-dashboard">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(79,142,247,.15)">👥</div>
        <div class="stat-num" style="color:var(--accent)">{{ users is defined ? users|length : '—' }}</div>
        <div class="stat-label">Utilisateurs</div>
        <div class="stat-trend up">↑ Actifs</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(124,92,252,.15)">🗺️</div>
        <div class="stat-num" style="color:var(--accent2)">{{ voyages is defined ? voyages|length : '—' }}</div>
        <div class="stat-label">Voyages actifs</div>
        <div class="stat-trend up">↑ Disponibles</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(247,119,79,.15)">📅</div>
        <div class="stat-num" style="color:var(--accent3)">{{ reservations is defined ? reservations|length : '—' }}</div>
        <div class="stat-label">Réservations</div>
        <div class="stat-trend up">↑ Total</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(79,209,197,.15)">💰</div>
        <div class="stat-num" style="color:var(--accent4)">
          {% if stats is defined and stats.totalRevenue is defined %}{{ (stats.totalRevenue/1000)|number_format(1) }}k{% else %}—{% endif %}
        </div>
        <div class="stat-label">Revenus (TND)</div>
        <div class="stat-trend up">↑ Ce mois</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(246,201,78,.15)">📄</div>
        <div class="stat-num" style="color:var(--warning)">{{ docTotal is defined ? docTotal : '—' }}</div>
        <div class="stat-label">Documents</div>
        <div class="stat-trend {{ docExpires is defined and docExpires > 0 ? 'down' : 'up' }}">
          {% if docExpires is defined and docExpires > 0 %}↓ {{ docExpires }} expirés{% else %}↑ À jour{% endif %}
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(72,187,120,.15)">🎯</div>
        <div class="stat-num" style="color:var(--success)">{{ activites is defined ? activites|length : '—' }}</div>
        <div class="stat-label">Activités</div>
        <div class="stat-trend up">↑ Disponibles</div>
      </div>
    </div>

    <div class="section-header"><div class="section-title">🌤️ Météo Destinations</div></div>
    <div class="weather-row" id="weatherRow">
      {% if destinations is defined %}
        {% for d in destinations|slice(0,4) %}
          <div class="weather-card" data-city="{{ d.ville ?? d.pays }}">
            <div class="weather-icon" id="wi-{{ loop.index }}">⏳</div>
            <div class="weather-temp" id="wt-{{ loop.index }}">…</div>
            <div class="weather-city">{{ d.ville ?? d.pays }}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;flex-wrap:wrap">
      <div>
        <div class="section-header"><div class="section-title">Réservations récentes</div></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Utilisateur</th><th>Voyage</th><th>Statut</th></tr></thead>
            <tbody>
              {% if reservations is defined and reservations|length > 0 %}
                {% for r in reservations|slice(0,5) %}
                  <tr>
                    <td>#{{ r.utilisateurId }}</td>
                    <td>#{{ r.voyageId }}</td>
                    <td>
                      {%- set s = r.statut|lower -%}
                      {%- if 'confirm' in s %}<span class="chip chip-green">Confirmé</span>
                      {%- elseif 'attente' in s %}<span class="chip chip-orange">En attente</span>
                      {%- elseif 'pay' in s %}<span class="chip chip-blue">Payé</span>
                      {%- elseif 'annul' in s %}<span class="chip chip-red">Annulé</span>
                      {%- else %}<span class="chip chip-purple">{{ r.statut }}</span>{%- endif %}
                    </td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr class="empty-row"><td colspan="3">Aucune réservation</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <div class="section-header"><div class="section-title">Voyages récents</div></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Voyage</th><th>Destination</th><th>Prix</th></tr></thead>
            <tbody>
              {% if voyages is defined and voyages|length > 0 %}
                {% for v in voyages|slice(0,5) %}
                  <tr>
                    <td>{{ v.titre ?? '—' }}</td>
                    <td>{{ v.idDestination ? v.idDestination.pays : '—' }}</td>
                    <td><span class="chip chip-blue">{{ v.prix }} TND</span></td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr class="empty-row"><td colspan="3">Aucun voyage</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  {# ════ USERS ════ #}
  <div class="page-content" id="page-users">
    <div class="section-header">
      <div class="section-title">👥 Gestion des Utilisateurs</div>
      <button class="btn btn-primary" onclick="openModal('modal-user-add')">＋ Ajouter Utilisateur</button>
    </div>
    <div class="table-wrap">
      <table>
