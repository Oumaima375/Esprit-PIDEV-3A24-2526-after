{% extends 'base_admin.html.twig' %}
{% block title %}Dashboard Admin - Gestion Document{% endblock %}

{% block body %}

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div style="background:#22c55e; color:white; padding:12px 20px; border-radius:8px; margin:10px 20px;">
        {{ message }}
    </div>
{% endfor %}

<!-- Header -->
<div style="background:white; border-radius:16px; padding:25px 30px; margin:20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h1 style="font-size:22px; font-weight:bold; color:#1a2744; margin:0;">
        🗂 ADMIN DOCUMENT DASHBOARD
    </h1>
    <p style="color:#94a3b8; margin:4px 0 0 0; font-size:14px;">Gestion complète des documents de voyage</p>
</div>

<!-- Stats Cards -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin:0 20px 20px 20px;">

    <!-- Total Documents -->
    <div style="background:#1a2744; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(26,39,68,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">📄</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ total }}</div>
        <div style="color:#94a3b8; font-size:14px; margin-top:4px;">Total Documents</div>
    </div>

    <!-- Catégories -->
    <div style="background:#2563eb; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(37,99,235,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">📂</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ totalCategories }}</div>
        <div style="color:#bfdbfe; font-size:14px; margin-top:4px;">Catégories</div>
    </div>

    <!-- Expirent bientôt -->
    <div style="background:#f5f5e8; border-radius:16px; padding:25px; text-align:center; border:2px solid #1a2744; box-shadow:0 4px 15px rgba(0,0,0,0.08);">
        <div style="font-size:30px; margin-bottom:8px;">⚠️</div>
        <div style="font-size:36px; font-weight:bold; color:#1a2744;">{{ expiresSoon }}</div>
        <div style="color:#94a3b8; font-size:14px; margin-top:4px;">Expirent dans 30j</div>
    </div>

    <!-- Expirés -->
    <div style="background:#ef4444; border-radius:16px; padding:25px; text-align:center; box-shadow:0 4px 15px rgba(239,68,68,0.3);">
        <div style="font-size:30px; margin-bottom:8px;">❌</div>
        <div style="font-size:36px; font-weight:bold; color:white;">{{ expires }}</div>
        <div style="color:#fecaca; font-size:14px; margin-top:4px;">Expirés</div>
    </div>

</div>

<!-- Charts Row -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin:0 20px 20px 20px;">

    <!-- PieChart Documents par Catégorie -->
    <div style="background:white; border-radius:16px; padding:25px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0;">🗂 Documents par catégorie</h3>
        <canvas id="pieChart" width="400" height="300"></canvas>
    </div>

    <!-- BarChart Uploads par mois -->
    <div style="background:white; border-radius:16px; padding:25px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
        <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0;">📈 Uploads par mois</h3>
        <canvas id="barChart" width="400" height="300"></canvas>
    </div>

</div>

<!-- Gestion Catégories -->
<div style="background:white; border-radius:16px; padding:25px; margin:0 20px 20px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h3 style="color:#1a2744; font-size:16px; margin:0 0 20px 0; text-align:center;">🗂 Gestion des catégories</h3>

    <!-- Form Ajouter/Modifier -->
    <div style="display:flex; gap:12px; justify-content:center; margin-bottom:20px;">
        <input type="text" id="categorieInput" placeholder="Nom catégorie..."
               style="padding:10px 16px; border:2px solid #e2e8f0; border-radius:10px; font-size:14px; width:300px; outline:none;">
        <a href="{{ path('app_categorie_document_new') }}"
           style="background:#2563eb; color:white; padding:10px 20px; border-radius:10px; text-decoration:none; font-size:14px; font-weight:bold; display:flex; align-items:center; gap:6px;">
            ➕ Ajouter
        </a>
        <button onclick="modifierCategorie()"
                style="background:#1a2744; color:white; padding:10px 20px; border-radius:10px; border:none; font-size:14px; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:6px;">
            ✏️ Modifier
        </button>
        <button onclick="supprimerCategorie()"
                style="background:#ef4444; color:white; padding:10px 20px; border-radius:10px; border:none; font-size:14px; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:6px;">
            🗑 Supprimer
        </button>
    </div>

    <!-- Liste Catégories -->
    <div style="border:2px solid #e2e8f0; border-radius:12px; overflow:hidden;">
        {% for cat in categories %}
        <div class="cat-item"
            onclick="selectCategorie('{{ cat.idCategorie }}', '{{ cat.libelle|e('html_attr') }}')"
            style="padding:12px 20px; border-bottom:1px solid #e2e8f0; cursor:pointer; color:#1a2744; font-weight:500; font-size:14px; background:white;"
            onmouseover="this.style.background='#dbeafe'; this.style.color='#2563eb';"
            onmouseout="this.style.background='white'; this.style.color='#1a2744';">
            {{ cat.libelle }}
        </div>
        {% endfor %}
    </div>

    <!-- Bouton Supprimer Expirés -->
    {% if expires > 0 %}
    <div style="text-align:center; margin-top:20px;">
        <a href="{{ path('app_admin_archiver_expires') }}"
           style="background:#ef4444; color:white; padding:12px 30px; border-radius:10px; text-decoration:none; font-size:14px; font-weight:bold;"
           onclick=        "return confirm('Archiver et supprimer tous les documents expirés ?')">
            🗑 Supprimer documents expirés ({{ expires }})
        </a>
    </div>
    {% endif %}

</div>

<!-- Documents Expirés Liste -->
{% if expires > 0 %}
<div style="background:white; border-radius:16px; padding:25px; margin:0 20px 20px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h3 style="color:#ef4444; font-size:16px; margin:0 0 20px 0;">❌ Documents expirés</h3>
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#f8fafc;">
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Nom</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Catégorie</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Expiré le</th>
                    <th style="padding:12px; text-align:left; color:#64748b; font-size:13px;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in documentsExpires %}
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:12px; color:#1a2744; font-weight:500;">{{ doc.nomDocument }}</td>
                    <td style="padding:12px;">
                        <span style="background:#fee2e2; color:#ef4444; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;">
                            {{ doc.categorie ? doc.categorie.libelle : 'N/A' }}
                        </span>
                    </td>
                    <td style="padding:12px; color:#ef4444; font-weight:bold;">
                        {{ doc.dateExpiration ? doc.dateExpiration|date('d/m/Y') : 'N/A' }}
                    </td>
                    <td style="padding:12px;">
                        <form method="post"
                              action="{{ path('app_document_crud_delete', {'idDocument': doc.idDocument}) }}"
                              onsubmit="return confirm('Supprimer ?')" style="display:inline">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ doc.idDocument) }}">
                            <button style="background:#ef4444; color:white; border:none; padding:6px 12px; border-radius:8px; cursor:pointer; font-size:13px;">
                                🗑
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // ===== Variables =====
    let selectedCategorieId = null;
    let selectedCategorieNom = null;

    function selectCategorie(id, nom) {
        selectedCategorieId = id;
        selectedCategorieNom = nom;
        document.getElementById('categorieInput').value = nom;
        document.querySelectorAll('.cat-item').forEach(el => el.style.background = 'white');
        event.currentTarget.style.background = '#dbeafe';
    }

    function modifierCategorie() {
        if (!selectedCategorieId) { alert('Sélectionnez une catégorie !'); return; }
        window.location.href = '/categorie/document/' + selectedCategorieId + '/edit';
    }

    function supprimerCategorie() {
        if (!selectedCategorieId) { alert('Sélectionnez une catégorie !'); return; }
        if (!confirm('Supprimer "' + selectedCategorieNom + '" ?')) return;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/categorie/document/' + selectedCategorieId;
        const token = document.createElement('input');
        token.type = 'hidden';
        token.name = '_token';
        token.value = '{{ csrf_token("delete_cat") }}';
        form.appendChild(token);
        document.body.appendChild(form);
        form.submit();
    }

    // ===== PieChart =====
    const pieCtx = document.getElementById('pieChart').getContext('2d');
    new Chart(pieCtx, {
        type: 'pie',
        data: {
           labels: [{% for row in parCategorie %}'{{ row.libelle|e('js') }}',{% endfor %}],
            datasets: [{
                data: [{% for row in parCategorie %}{{ row.total }},{% endfor %}],
                backgroundColor: [
                    '#2563eb','#ef4444','#22c55e','#f59e0b',
                    '#8b5cf6','#06b6d4','#ec4899','#14b8a6'
                ],
                borderWidth: 2,
                borderColor: 'white'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // ===== BarChart =====
    const barCtx = document.getElementById('barChart').getContext('2d');
    new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: [{% for row in uploadsParMois %}'{{ row.month }}',{% endfor %}],
            datasets: [{
                label: 'Uploads',
                data: [{% for row in uploadsParMois %}{{ row.total }},{% endfor %}],
                backgroundColor: '#ef4444',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
{% endblock %}