}

// ── RestCountries API ──
async function loadDestinationsAPI() {
  const grid = document.getElementById('destApiGrid');
  if (!grid) return;
  grid.style.display = 'grid';
  grid.innerHTML = '<div style="color:var(--muted);padding:16px;grid-column:1/-1">⏳ Chargement RestCountries API…</div>';
  const rows = document.querySelectorAll('#voyage-tab-destinations tbody tr');
  const pays = [...new Set([...rows].map(r => r.children[1]?.innerText.trim()).filter(p => p && p !== '—'))];
  if (!pays.length) { grid.innerHTML = '<div style="color:var(--muted);padding:16px;grid-column:1/-1">Aucun pays à enrichir.</div>'; return; }
  const cards = await Promise.all(pays.map(async p => {
    try {
      const r = await fetch('https://restcountries.com/v3.1/name/' + encodeURIComponent(p) + '?fields=name,capital,population,currencies,flags,continents,languages');
      if (!r.ok) throw new Error();
      const data = await r.json();
      const c = data[0];
      const capital   = c.capital?.[0] ?? '—';
      const pop       = c.population ? (c.population/1e6).toFixed(1)+'M' : '—';
      const currency  = Object.values(c.currencies??{})[0]?.name ?? '—';
      const flag      = c.flags?.svg ?? c.flags?.png ?? '';
      const continent = c.continents?.[0] ?? '—';
      const langs     = Object.values(c.languages??{}).slice(0,2).join(', ') || '—';
      return `<div class="dest-api-card">
        ${flag ? `<img src="${flag}" class="dest-api-img" alt="${p}" loading="lazy">` : '<div class="dest-api-img-ph">🌍</div>'}
        <div class="dest-api-body">
          <div class="dest-api-name">${c.name.common}</div>
          <div class="dest-api-sub">🏙️ ${capital} · ${continent}</div>
          <div class="dest-api-meta">
            <span class="chip chip-blue">👥 ${pop}</span>
            <span class="chip chip-teal">💰 ${currency}</span>
            <span class="chip chip-purple">🗣️ ${langs}</span>
          </div>
        </div></div>`;
    } catch(e) {
      return `<div class="dest-api-card"><div class="dest-api-img-ph">🌍</div><div class="dest-api-body"><div class="dest-api-name">${p}</div><div class="dest-api-sub" style="color:var(--danger)">Données non disponibles</div></div></div>`;
    }
  }));
  grid.innerHTML = cards.join('');
  toast('✅ Enrichi via RestCountries API !', 'success');
}

// ── OpenWeatherMap API ──
const OWM_KEY = 'bd5e378503939ddaee76f12ad7a97608';

async function loadWeather() {
  const cards = document.querySelectorAll('#weatherRow .weather-card');
  for (let i = 0; i < cards.length; i++) {
    const city = cards[i].getAttribute('data-city');
    if (!city) continue;
    try {
      const r = await fetch(`https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(city)}&appid=${OWM_KEY}&units=metric&lang=fr`);
      if (!r.ok) throw new Error();
      const d = await r.json();
      const temp = Math.round(d.main.temp);
      const icon = weatherIcon(d.weather[0].id);
      const idx = i + 1;
      const wi = document.getElementById('wi-' + idx);
      const wt = document.getElementById('wt-' + idx);
      if (wi) wi.textContent = icon;
      if (wt) wt.textContent = temp + '°C';
    } catch(e) {
      const wi = document.getElementById('wi-' + (i+1));
      const wt = document.getElementById('wt-' + (i+1));
      if (wi) wi.textContent = '🌡️';
      if (wt) wt.textContent = '—';
    }
  }
}

function weatherIcon(code) {
  if (code >= 200 && code < 300) return '⛈️';
  if (code >= 300 && code < 500) return '🌧️';
  if (code >= 500 && code < 600) return '🌦️';
  if (code >= 600 && code < 700) return '❄️';
  if (code >= 700 && code < 800) return '🌫️';
  if (code === 800) return '☀️';
  if (code === 801) return '🌤️';
  return '☁️';
}
