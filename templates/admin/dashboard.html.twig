        <button class="btn btn-primary" onclick="openModal('modal-planning-add')">＋ Ajouter Planning</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Activité</th><th>Date</th><th>Heure début</th><th>Durée (min)</th><th>Actions</th></tr></thead>
          <tbody>
            {% set hasPlanning = false %}
            {% if activites is defined %}
              {% for a in activites %}
                {% if a.plannings is defined %}
                  {% for p in a.plannings %}
                    {% set hasPlanning = true %}
                    <tr>
                      <td>{{ p.idPlanning }}</td>
                      <td><span class="chip chip-teal">{{ a.nom ?? '—' }}</span></td>
                      <td>{{ p.dateActivite ? p.dateActivite|date('d/m/Y') : '—' }}</td>
                      <td>{{ p.heureDebut ?? '—' }}</td>
                      <td>{{ p.duree ?? '—' }}</td>
                      <td>
                        <div class="td-actions">
                          <button onclick="openEditPlanning({{ p.idPlanning }},{{ a.idActivite }},'{{ p.dateActivite ? p.dateActivite|date('Y-m-d') : '' }}','{{ p.heureDebut|e('js') }}',{{ p.duree ?? 0 }})" class="btn btn-secondary btn-sm">✏️</button>
                          <a href="{{ path('admin_planning_delete',{id:p.idPlanning}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')">🗑️</a>
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endif %}
            {% if not hasPlanning %}
              <tr class="empty-row"><td colspan="6">Aucun planning trouvé</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
