      <div class="tab active" onclick="switchTab('document','documents',this)">📄 Documents</div>
      <div class="tab" onclick="switchTab('document','categories',this)">🏷️ Catégories</div>
    </div>

    <div id="document-tab-documents">
      <div class="section-header">
        <div class="section-title">Gestion des Documents</div>
        <button class="btn btn-primary" onclick="openModal('modal-document-add')">＋ Ajouter Document</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Nom</th><th>Catégorie</th><th>Date ajout</th><th>Expiration</th><th>Statut</th><th>Actions</th></tr></thead>
          <tbody>
            {% if allDocuments is defined and allDocuments|length > 0 %}
              {% for doc in allDocuments %}
                <tr>
                  <td>{{ doc.idDocument }}</td>
                  <td>📎 {{ doc.nomDocument }}</td>
                  <td>{% if doc.categorie %}<span class="chip chip-blue">{{ doc.categorie.libelle }}</span>{% else %}<span class="chip chip-purple">Sans catégorie</span>{% endif %}</td>
                  <td>{{ doc.dateAjout is not null ? doc.dateAjout|date('d/m/Y') : '—' }}</td>
                  <td>{{ doc.dateExpiration is not null ? doc.dateExpiration|date('d/m/Y') : '—' }}</td>
                  <td>{% if doc.dateExpiration is not null and doc.dateExpiration < date() %}<span class="chip chip-red">Expiré</span>{% else %}<span class="chip chip-green">Valide</span>{% endif %}</td>
                  <td>
                    <div class="td-actions">
                      {% if doc.cheminFichier and doc.cheminFichier != 'aucun_fichier' %}
                        <a href="{{ doc.cheminFichier }}" target="_blank" class="btn btn-success btn-sm">👁️</a>
                      {% endif %}
                      <button onclick="openEditDocument({{ doc.idDocument }},'{{ doc.nomDocument|e('js') }}','{{ doc.dateExpiration ? doc.dateExpiration|date('Y-m-d') : '' }}',{{ doc.categorie ? doc.categorie.idCategorie : 'null' }})" class="btn btn-secondary btn-sm">✏️</button>
                      <form method="post" action="{{ path('app_document_crud_delete',{idDocument:doc.idDocument}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-doc-'~doc.idDocument) }}">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            {% else %}
              <tr class="empty-row"><td colspan="7">Aucun document trouvé</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
