  {# ════ VOYAGE & DESTINATION ════ #}
  <div class="page-content" id="page-voyage">
    <div class="tabs">
      <div class="tab active" onclick="switchTab('voyage','voyages',this)">🗺️ Voyages</div>
      <div class="tab" onclick="switchTab('voyage','destinations',this)">📍 Destinations</div>
    </div>

    <div id="voyage-tab-voyages">
      <div class="section-header">
        <div class="section-title">Gestion des Voyages</div>
        <div class="btn-group">
          <button onclick="exportCSV()" class="btn btn-secondary">📊 CSV</button>
          <button onclick="printTable()" class="btn btn-secondary">🖨️ Print</button>
          <button class="btn btn-primary" onclick="openModal('modal-voyage-add')">＋ Ajouter</button>
        </div>
      </div>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-num">{{ voyages is defined ? voyages|length : 0 }}</div>
          <div class="stat-label">Total voyages</div>
        </div>
        <div class="stat-card">
          {% set totalPlaces = 0 %}
          {% if voyages is defined %}{% for v in voyages %}{% set totalPlaces = totalPlaces + v.nbPlaces %}{% endfor %}{% endif %}
          <div class="stat-num">{{ totalPlaces }}</div>
          <div class="stat-label">Places totales</div>
        </div>
        <div class="stat-card">
          {% set totalRevenu = 0 %}
          {% if voyages is defined %}{% for v in voyages %}{% set totalRevenu = totalRevenu + v.prix %}{% endfor %}{% endif %}
          <div class="stat-num">{{ totalRevenu|number_format(0) }}</div>
          <div class="stat-label">Revenu potentiel (TND)</div>
        </div>
      </div>
      <div class="table-wrap">
        <table id="voyagesTable">
          <thead><tr><th>#</th><th>Titre</th><th>Destination</th><th>Prix</th><th>Places</th><th>Dates</th><th>Statut</th><th>Actions</th></tr></thead>
          <tbody>
            {% if voyages is defined %}
              {% for v in voyages %}
                {% set today = 'now'|date('Y-m-d') %}
                {% set debut = v.dateDebut ? v.dateDebut|date('Y-m-d') : null %}
                {% set fin   = v.dateFin   ? v.dateFin|date('Y-m-d')   : null %}
                {% if today < debut %}{% set status='À venir'  %}{% set col='chip-blue'  %}
                {% elseif today > fin %}{% set status='Terminé' %}{% set col='chip-red'   %}
                {% else %}{% set status='En cours' %}{% set col='chip-green' %}{% endif %}
                <tr>
                  <td>{{ v.id }}</td>
                  <td><strong>{{ v.titre }}</strong></td>
                  <td>{{ v.idDestination ? v.idDestination.pays : '—' }}</td>
                  <td><strong>{{ v.prix }} TND</strong></td>
                  <td>{{ v.nbPlaces }}</td>
                  <td style="font-size:12px;color:var(--muted)">{{ v.dateDebut ? v.dateDebut|date('d/m/Y') : '—' }}<br>→ {{ v.dateFin ? v.dateFin|date('d/m/Y') : '—' }}</td>
                  <td><span class="chip {{ col }}">{{ status }}</span></td>
                  <td class="td-actions">
                    <button onclick="openEditVoyage({{ v.id }},'{{ v.titre|e('js') }}',{{ v.prix }},'{{ v.description|e('js') }}','{{ v.dateDebut ? v.dateDebut|date('Y-m-d') : '' }}','{{ v.dateFin ? v.dateFin|date('Y-m-d') : '' }}',{{ v.nbPlaces }},'{{ v.idDestination ? v.idDestination.id : '' }}')" class="btn btn-secondary btn-sm">✏️</button>
                    <a href="{{ path('app_voyage_pdf',{id:v.id}) }}" target="_blank" class="btn btn-success btn-sm">📄</a>
                    <button onclick="showAdminQR('{{ v.titre|e('js') }}','{{ path('app_voyage_show',{id:v.id}) }}')" class="btn btn-secondary btn-sm">QR</button>
                    <form method="post" action="{{ path('admin_voyage_delete',{id:v.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce voyage ?')">
                      <button class="btn btn-danger btn-sm">🗑️</button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>

    <div id="voyage-tab-destinations" style="display:none">
      <div class="section-header">
        <div class="section-title">Gestion des Destinations</div>
        <div class="btn-group">
          <button class="btn btn-warning" onclick="loadDestinationsAPI()">🌍 Enrichir via API</button>
          <button class="btn btn-primary" onclick="openModal('modal-destination-add')">＋ Ajouter</button>
        </div>
      </div>
      <div class="api-banner">
        <div class="api-dot"></div>
        <div>Cliquez sur <strong>Enrichir via API</strong> pour charger les données pays depuis <strong>RestCountries API</strong> (capitale, population, monnaie, drapeau, langue)</div>
      </div>
      <div class="section-header"><div class="section-title">🌤️ Météo Destinations</div></div>
    <div class="weather-row" id="weatherRow">
      {% if destinations is defined %}
        {% for d in destinations|slice(0,4) %}
          <div class="weather-card" data-city="{{ d.ville ?? d.pays }}">
            <div class="weather-icon" id="wi-{{ loop.index }}">⏳</div>
            <div class="weather-temp" id="wt-{{ loop.index }}">…</div>
            <div class="weather-city">{{ d.ville ?? d.pays }}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
      <div class="dest-api-grid" id="destApiGrid" style="display:none"></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>Pays</th><th>Ville</th><th>Continent</th><th>Actions</th></tr></thead>
          <tbody>
            {% for d in destinations %}
              <tr>
                <td>{{ d.id }}</td>
                <td>{{ d.pays }}</td>
                <td>{{ d.ville }}</td>
                <td><span class="chip chip-blue">{{ d.continent }}</span></td>
                <td class="td-actions">
                  <button onclick="openEditDestination({{ d.id }},'{{ d.pays|e('js') }}','{{ d.ville|e('js') }}','{{ d.continent|e('js') }}')" class="btn btn-secondary btn-sm">✏️</button>
                  <form method="post" action="{{ path('admin_destination_delete',{id:d.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
                    <button class="btn btn-danger btn-sm">🗑️</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {# ════ ACTIVITE & PLANNING ════ #}
