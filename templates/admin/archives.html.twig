{% extends 'base_admin.html.twig' %}
{% block title %}Archives - AFTER Travel{% endblock %}

{% block body %}

<div class="header">
    <div class="header-left">
        <h1>📦 Archives Documents</h1>
        <p class="header-subtitle">Documents archivés par l'admin</p>
    </div>
</div>

<div style="padding: 24px;">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">📦 Tous les documents archivés</h2>
            <a href="{{ path('app_admin_dashboard') }}"
               style="color:var(--accent-primary); text-decoration:none; font-size:13px;">
                ← Dashboard
            </a>
        </div>
        <div style="padding:20px; overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-color);">
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Nom Document</th>
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Catégorie</th>
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Date Ajout</th>
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Date Expiration</th>
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Archivé le</th>
                        <th style="padding:10px; text-align:left; color:var(--text-secondary);">Raison</th>
                    </tr>
                </thead>
                <tbody>
                    {% for archive in archives %}
                    <tr style="border-bottom:1px solid var(--border-color);">
                        <td style="padding:10px; color:var(--text-primary);">{{ archive.nomDocument }}</td>
                        <td style="padding:10px;">
                            <span style="background:rgba(180,180,180,0.2); color:var(--text-secondary); padding:3px 8px; border-radius:12px; font-size:12px;">
                                {{ archive.categorie ?? 'N/A' }}
                            </span>
                        </td>
                        <td style="padding:10px; color:var(--text-secondary); font-size:13px;">
                            {{ archive.dateAjout ? archive.dateAjout|date('d/m/Y') : 'N/A' }}
                        </td>
                        <td style="padding:10px; color:#ef4444; font-size:13px;">
                            {{ archive.dateExpiration ? archive.dateExpiration|date('d/m/Y') : 'N/A' }}
                        </td>
                        <td style="padding:10px; color:var(--text-secondary); font-size:13px;">
                            {{ archive.dateArchivage ? archive.dateArchivage|date('d/m/Y H:i') : 'N/A' }}
                        </td>
                        <td style="padding:10px; color:#f59e0b; font-size:13px;">
                            {{ archive.raison }}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" style="padding:20px; text-align:center; color:var(--text-secondary);">
                            Aucun document archivé
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}