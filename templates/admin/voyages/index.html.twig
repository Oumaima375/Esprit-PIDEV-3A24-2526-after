{% extends 'admin/base_admin.html.twig' %}
{% block title %}Voyages — Admin{% endblock %}
{% block body %}
<div class="header">
    <div class="header-left">
        <h1>Gestion des Voyages</h1>
        <p class="header-subtitle">{{ voyages|length }} voyage(s) au total</p>
    </div>
    <div class="header-right">
        <a href="{{ path('admin_voyage_new') }}"
           style="background:var(--accent-gradient);color:white;padding:10px 20px;
                  border-radius:8px;text-decoration:none;font-weight:600;font-size:14px">
            <i class="fas fa-plus"></i> Nouveau Voyage
        </a>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Liste des Voyages</h2>
        <input type="text" id="searchInput" placeholder="Rechercher..."
               onkeyup="filterTable()"
               style="background:var(--bg-primary);border:1px solid var(--border);
                      color:var(--text-primary);padding:6px 12px;border-radius:6px;font-size:13px">
    </div>
    <div style="overflow-x:auto">
    <table id="voyagesTable" style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
            <tr style="border-bottom:2px solid var(--border)">
                <th style="padding:12px;text-align:left;color:var(--text-secondary)">#</th>
                <th style="padding:12px;text-align:left;color:var(--text-secondary)">Titre</th>
                <th style="padding:12px;text-align:left;color:var(--text-secondary)">Destination</th>
                <th style="padding:12px;text-align:right;color:var(--text-secondary)">Prix</th>
                <th style="padding:12px;text-align:right;color:var(--text-secondary)">Places</th>
                <th style="padding:12px;text-align:center;color:var(--text-secondary)">Du</th>
                <th style="padding:12px;text-align:center;color:var(--text-secondary)">Au</th>
                <th style="padding:12px;text-align:center;color:var(--text-secondary)">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for v in voyages %}
            <tr style="border-bottom:1px solid var(--border);transition:background 0.2s"
                onmouseover="this.style.background='var(--bg-card-hover)'"
                onmouseout="this.style.background='transparent'">
                <td style="padding:12px;color:var(--text-muted)">{{ v.id_voyage }}</td>
                <td style="padding:12px">
                    <div style="display:flex;align-items:center;gap:10px">
                        {% if v.image and v.image starts with 'http' %}
                            <img src="{{ v.image }}" style="width:36px;height:36px;border-radius:6px;object-fit:cover">
                        {% endif %}
                        <span style="color:var(--text-primary);font-weight:500">{{ v.titre }}</span>
                    </div>
                </td>
                <td style="padding:12px;color:var(--text-secondary)">
                    {{ v.id_destination ? v.id_destination.pays ~ ' - ' ~ v.id_destination.ville : 'N/A' }}
                </td>
                <td style="padding:12px;text-align:right;color:var(--gain);font-weight:600">{{ v.prix }} TND</td>
                <td style="padding:12px;text-align:right;color:var(--text-primary)">{{ v.nb_places }}</td>
                <td style="padding:12px;text-align:center;color:var(--text-secondary);font-size:12px">
                    {{ v.date_debut ? v.date_debut|date('d/m/Y') : 'N/A' }}
                </td>
                <td style="padding:12px;text-align:center;color:var(--text-secondary);font-size:12px">
                    {{ v.date_fin ? v.date_fin|date('d/m/Y') : 'N/A' }}
                </td>
                <td style="padding:12px;text-align:center">
                    <a href="{{ path('admin_voyage_edit', {id: v.id_voyage}) }}"
                       style="background:var(--bg-card-hover);color:var(--accent-copper);
                              padding:5px 12px;border-radius:6px;text-decoration:none;
                              font-size:12px;border:1px solid var(--accent-copper);margin-right:4px">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="{{ path('admin_voyage_delete', {id: v.id_voyage}) }}"
                       onclick="return confirm('Supprimer ce voyage ?')"
                       style="background:var(--bg-card-hover);color:var(--loss);
                              padding:5px 12px;border-radius:6px;text-decoration:none;
                              font-size:12px;border:1px solid var(--loss)">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8" style="padding:40px;text-align:center;color:var(--text-muted)">
                <i class="fas fa-plane" style="font-size:32px;margin-bottom:8px;display:block"></i>
                Aucun voyage.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}
{% block javascripts %}
<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#voyagesTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
{% endblock %}