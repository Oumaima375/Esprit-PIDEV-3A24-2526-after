<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AFTER Admin{% endblock %}</title>

    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-dashboard.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>

<button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
    <div class="hamburger"><span></span><span></span><span></span></div>
</button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="dashboard">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="logo">
            <div class="logo-icon">AT</div>
            <span class="logo-text">AFTER Admin</span>
        </div>

        <nav class="nav-section">

            <div class="nav-label">Tableau de bord</div>
            <a href="{{ path('admin_dashboard') }}"
               class="nav-item {% if app.request.attributes.get('_route') == 'admin_dashboard' %}active{% endif %}">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
                Dashboard
            </a>

            <div class="nav-label">Dépenses</div>
            <a href="{{ path('admin_categorie_index') }}"
               class="nav-item {% if app.request.attributes.get('_route') starts with 'admin_categorie' %}active{% endif %}">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                </svg>
                Catégories
            </a>

            {# ── Lien modifié : reste dans l'admin ── #}
            <a href="{{ path('admin_dashboard', {view: 'depenses'}) }}"
               class="nav-item {% if app.request.query.get('view') == 'depenses' %}active{% endif %}">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                Gérer mes dépenses
            </a>

        </nav>

        <div class="sidebar-footer">
            <a href="{{ path('app_home') }}" class="nav-item" style="margin-bottom:.5rem">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18l-6-6 6-6"/>
                </svg>
                Retour au site
            </a>
            <div class="theme-toggle">
                <div class="theme-toggle-label">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                    Light Mode
                </div>
                <div class="theme-switch" id="themeSwitch"></div>
            </div>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        {# Flash messages #}
        {% set fColors = {'success':'#6b8e6b','danger':'#c27878','warning':'#c9a878','info':'#6b9ac4'} %}
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
            <div style="display:flex;align-items:center;gap:.75rem;
                        background:var(--bg-card);
                        border:1px solid {{ fColors[type] ?? '#6b9ac4' }};
                        border-left:4px solid {{ fColors[type] ?? '#6b9ac4' }};
                        border-radius:10px;padding:.85rem 1.25rem;
                        margin-bottom:1rem;color:var(--text-primary);font-size:.9rem">
                <span style="flex:1">{{ msg }}</span>
                <button onclick="this.parentElement.remove()"
                        style="background:none;border:none;cursor:pointer;
                               color:var(--text-secondary);font-size:1.2rem;line-height:1">×</button>
            </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

        <footer class="copyright">Copyright &copy; 2026 AFTER Travel — Backoffice Admin</footer>
    </main>

</div>

<script src="{{ asset('js/templatemo-crypto-script.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>