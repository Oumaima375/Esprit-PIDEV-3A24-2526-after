{% extends 'admin/base.html.twig' %}
{% block title %}Catégories — AFTER Admin{% endblock %}

{% block body %}

{# ── En-tête ── #}
<div style="display:flex;align-items:flex-start;justify-content:space-between;
            flex-wrap:wrap;gap:1rem;margin-bottom:28px">
    <div>
        <h1 style="font-size:26px;font-weight:700;margin-bottom:6px;color:var(--text-primary)">
            Catégories de dépenses
        </h1>
        <p style="color:var(--text-secondary);font-size:15px">
            {{ categories|length }} catégorie{{ categories|length != 1 ? 's' : '' }} enregistrée{{ categories|length != 1 ? 's' : '' }}
        </p>
    </div>
    <a href="{{ path('admin_categorie_new') }}" class="btn primary"
       style="text-decoration:none;display:inline-flex;align-items:center;gap:8px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nouvelle catégorie
    </a>
</div>

{# ── Tableau ── #}
<div class="card" style="padding:0;overflow:hidden">

    {% if categories is empty %}
        <div style="text-align:center;padding:4rem 1rem;color:var(--text-secondary)">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" style="opacity:.25;display:block;margin:0 auto 1rem">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            <p style="margin-bottom:1.25rem">Aucune catégorie enregistrée.</p>
            <a href="{{ path('admin_categorie_new') }}" class="btn primary"
               style="text-decoration:none;display:inline-flex;align-items:center;gap:8px">
                Créer la première catégorie
            </a>
        </div>

    {% else %}

        {# Barre de recherche #}
        <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--border)">
            <div style="position:relative;max-width:280px">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);
                                            color:var(--text-muted);pointer-events:none">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" id="searchInput"
                       placeholder="Rechercher…"
                       class="form-input"
                       style="padding-left:40px;font-size:14px;height:42px">
            </div>
        </div>

        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse" id="catTable">
                <thead>
                    <tr style="border-bottom:1px solid var(--border)">
                        {% for label in ['#','Icône','Nom','Description','Dépenses','Actions'] %}
                        <th style="padding:13px {% if loop.last %}20px{% else %}14px{% endif %};
                                   text-align:{% if loop.last %}right{% else %}left{% endif %};
                                   font-size:11px;font-weight:700;text-transform:uppercase;
                                   letter-spacing:.08em;color:var(--text-muted);
                                   background:var(--bg-secondary);
                                   white-space:nowrap;
                                   {% if loop.first %}width:55px;padding-left:20px{% endif %}
                                   {% if loop.index == 2 %}width:55px{% endif %}
                                   {% if loop.last %}width:170px{% endif %}">
                            {{ label }}
                        </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for cat in categories %}
                    <tr class="cat-row" style="border-bottom:1px solid var(--border);transition:background .15s"
                        onmouseover="this.style.background='var(--bg-card-hover)'"
                        onmouseout="this.style.background='transparent'">

                        {# ID #}
                        <td style="padding:14px 14px 14px 20px;font-size:13px;color:var(--text-muted)">
                            {{ cat.id }}
                        </td>

                        {# Icône #}
                        <td style="padding:14px">
                            <div style="width:36px;height:36px;border-radius:9px;overflow:hidden;
                                        background:rgba(184,115,51,.12);
                                        display:flex;align-items:center;justify-content:center">
                                {% if cat.iconeUrl and cat.iconeUrl starts with 'http' %}
                                    <img src="{{ cat.iconeUrl }}" alt=""
                                         style="width:100%;height:100%;object-fit:cover">
                                {% else %}
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                         stroke="var(--accent-copper)" stroke-width="2">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
                                        <line x1="7" y1="7" x2="7.01" y2="7"/>
                                    </svg>
                                {% endif %}
                            </div>
                        </td>

                        {# Nom #}
                        <td style="padding:14px">
                            <span style="display:inline-flex;align-items:center;gap:6px;
                                         background:rgba(184,115,51,.12);
                                         color:var(--accent-copper);
                                         border-radius:50px;padding:.3em .85em;
                                         font-size:13px;font-weight:600">
                                {{ cat.nomCategorie }}
                            </span>
                        </td>

                        {# Description #}
                        <td style="padding:14px;font-size:13px;color:var(--text-secondary);max-width:240px">
                            {% if cat.description %}
                                <span style="display:-webkit-box;-webkit-line-clamp:2;
                                             -webkit-box-orient:vertical;overflow:hidden">
                                    {{ cat.description }}
                                </span>
                            {% else %}
                                <span style="color:var(--text-muted);font-style:italic">—</span>
                            {% endif %}
                        </td>

                        {# Dépenses #}
                        <td style="padding:14px">
                            {% set nb = cat.depenses|length %}
                            <span style="display:inline-flex;align-items:center;gap:5px;
                                         background:{% if nb > 0 %}rgba(107,142,107,.15){% else %}var(--bg-primary){% endif %};
                                         color:{% if nb > 0 %}var(--gain){% else %}var(--text-muted){% endif %};
                                         border-radius:50px;padding:.3em .8em;
                                         font-size:12px;font-weight:600">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                                {{ nb }} dépense{{ nb != 1 ? 's' : '' }}
                            </span>
                        </td>

                        {# Actions #}
                        <td style="padding:14px 20px 14px 14px;text-align:right;white-space:nowrap">

                            {# Modifier #}
                            <a href="{{ path('admin_categorie_edit', {id: cat.id}) }}"
                               title="Modifier"
                               style="display:inline-flex;align-items:center;justify-content:center;
                                      width:34px;height:34px;border-radius:8px;
                                      background:var(--bg-primary);border:1px solid var(--border);
                                      color:var(--text-secondary);text-decoration:none;
                                      margin-right:6px;transition:all .2s"
                               onmouseover="this.style.background='var(--bg-card-hover)';this.style.color='var(--text-primary)'"
                               onmouseout="this.style.background='var(--bg-primary)';this.style.color='var(--text-secondary)'">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </a>

                            {# Supprimer #}
                            <form method="post"
                                  action="{{ path('admin_categorie_delete', {id: cat.id}) }}"
                                  style="display:inline"
                                  onsubmit="return confirm('Supprimer « {{ cat.nomCategorie }} » ?\nLes dépenses liées seront supprimées.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cat.id) }}">
                                <button type="submit" title="Supprimer"
                                        style="display:inline-flex;align-items:center;justify-content:center;
                                               width:34px;height:34px;border-radius:8px;cursor:pointer;
                                               background:var(--bg-primary);border:1px solid var(--border);
                                               color:var(--loss);transition:all .2s"
                                        onmouseover="this.style.background='rgba(194,120,120,.15)';this.style.borderColor='var(--loss)'"
                                        onmouseout="this.style.background='var(--bg-primary)';this.style.borderColor='var(--border)'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/>
                                    </svg>
                                </button>
                            </form>
                        </td>

                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Message aucun résultat #}
        <div id="noResults" style="display:none;text-align:center;padding:2.5rem;color:var(--text-muted)">
            Aucune catégorie ne correspond à votre recherche.
        </div>

    {% endif %}
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const input = document.getElementById('searchInput');
const noRes = document.getElementById('noResults');
input?.addEventListener('input', function () {
    const q = this.value.toLowerCase();
    let visible = 0;
    document.querySelectorAll('#catTable .cat-row').forEach(row => {
        const show = row.textContent.toLowerCase().includes(q);
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    if (noRes) noRes.style.display = visible === 0 ? 'block' : 'none';
});
</script>
{% endblock %}
