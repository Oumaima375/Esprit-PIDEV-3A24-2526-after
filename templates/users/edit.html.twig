{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash flash-{{ label }}" style="margin:12px auto; max-width:600px; padding:12px 16px; border-radius:8px; font-weight:600; {% if label == 'success' %}background:#d4edda;color:#155724;{% elseif label == 'error' %}background:#f8d7da;color:#721c24;{% else %}background:#e2e3e5;color:#383d41;{% endif %}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<div class="page-header">
    <h1>Modifier l'utilisateur</h1>
    <p>Modifiez les informations de <strong>{{ user.nom }} {{ user.prenom }}</strong></p>
</div>

<div class="toolbar" style="margin-bottom: 24px;">
    <a href="{{ path('app_home') }}" class="toolbar-btn reset" style="text-decoration:none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Retour
    </a>
</div>

<div style="background:#fff; border-radius:16px; padding:32px; max-width:600px; box-shadow:0 2px 16px rgba(26,43,94,0.07);">

    <form id="standaloneEditForm" action="{{ path('user_edit', {id: user.id}) }}" method="POST" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_edit_' ~ user.id) }}">

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">

            <div class="modal-form-group" data-field-wrap>
                <label class="modal-label">Nom *</label>
                <input type="text" name="nom" class="modal-input" value="{{ user.nom }}">
            </div>

            <div class="modal-form-group" data-field-wrap>
                <label class="modal-label">Prénom *</label>
                <input type="text" name="prenom" class="modal-input" value="{{ user.prenom }}">
            </div>

            <div class="modal-form-group" style="grid-column: span 2;" data-field-wrap>
                <label class="modal-label">Email *</label>
                <input type="email" name="email" class="modal-input" value="{{ user.email }}">
            </div>

            <div class="modal-form-group" data-field-wrap>
                <label class="modal-label">Téléphone</label>
                <input type="tel" name="telephone" class="modal-input" value="{{ user.telephone is defined and user.telephone ? user.telephone : '' }}" placeholder="Numéro de téléphone">
            </div>

            <div class="modal-form-group" data-field-wrap>
                <label class="modal-label">Rôle</label>
                <select name="type_utilisateur" class="modal-select">
                    <option value="voyageur" {{ user.type_utilisateur|upper != 'ADMIN' ? 'selected' : '' }}>Voyageur</option>
                    <option value="admin" {{ user.type_utilisateur|upper == 'ADMIN' ? 'selected' : '' }}>Administrateur</option>
                </select>
            </div>

            <div class="modal-form-group" style="grid-column: span 2;" data-field-wrap>
                <label class="modal-label">Nouveau mot de passe <span style="color:#9ca3af; font-weight:400;">(laisser vide pour ne pas changer)</span></label>
                <input type="password" name="password" class="modal-input" placeholder="Nouveau mot de passe" autocomplete="new-password">
            </div>

            {% if user.photo_profil %}
            <div class="modal-form-group" style="grid-column: span 2;">
                <label class="modal-label">Photo actuelle</label>
                <img src="{{ asset('uploads/photos/' ~ user.photo_profil) }}" alt="Photo" style="width:80px; height:80px; border-radius:12px; object-fit:cover; display:block; margin-bottom:10px;" onerror="this.src='{{ asset('uploads/photos/default.png') }}'">
            </div>
            {% endif %}

            <div class="modal-form-group" style="grid-column: span 2;" data-field-wrap>
                <label class="modal-label">Changer la photo</label>
                <input type="file" name="photo_profil" accept="image/jpeg,image/png,image/webp,image/gif" style="font-size:14px; color:#1a2b5e;">
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:28px; justify-content:flex-end;">
            <a href="{{ path('app_home') }}" class="modal-btn cancel" style="text-decoration:none; padding:10px 22px;">Annuler</a>
            <button type="submit" class="modal-btn confirm">Enregistrer les modifications</button>
        </div>

    </form>

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/form-validation.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var f = document.getElementById('standaloneEditForm');
    if (!f || !window.AppFormValidation) return;
    AppFormValidation.attachClearOnInput(f);
    f.addEventListener('submit', function (e) {
        if (!AppFormValidation.validateStandaloneUserEditForm(f)) e.preventDefault();
    });
});
</script>
{% endblock %}
