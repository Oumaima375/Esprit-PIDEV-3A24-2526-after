{% extends 'base.html.twig' %}

{% block title %}After Travel - Voyages{% endblock %}

{% block body %}

<!-- Header -->
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">Nos Voyages</h1>
            <p class="text-white fs-5">Découvrez toutes nos destinations et trouvez le voyage parfait</p>
        </div>
    </div>
</div>

<!-- Filtres -->
<div class="container mb-5">
    <form method="GET" action="{{ path('app_voyage') }}">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Recherche</label>
                <input type="text" name="search" class="form-control rounded-pill" placeholder="Titre du voyage..." value="{{ app.request.query.get('search') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Prix min (TND)</label>
                <input type="number" name="prix_min" class="form-control rounded-pill" placeholder="0" value="{{ app.request.query.get('prix_min') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Prix max (TND)</label>
                <input type="number" name="prix_max" class="form-control rounded-pill" placeholder="9999" value="{{ app.request.query.get('prix_max') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Date début</label>
                <input type="date" name="date_debut" class="form-control rounded-pill" value="{{ app.request.query.get('date_debut') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Places min</label>
                <input type="number" name="places_min" class="form-control rounded-pill" placeholder="0" value="{{ app.request.query.get('places_min') }}">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary rounded-pill w-100">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Cards Voyages -->
<div class="container mb-5">
    {% set favoris = app.session.get('favoris', []) %}
    <div class="row g-4">
        {% for voyage in voyages %}
        <div class="col-lg-4 col-md-6">
            <div class="blog-item h-100">
                <div class="blog-img">
                    <div class="blog-img-inner">
                        <img class="img-fluid w-100 rounded-top" 
                             style="height: 220px; object-fit: cover;" 
                             src="{{ voyage.image starts with 'http' ? voyage.image : asset('img/blog-' ~ (loop.index % 3 == 0 ? 3 : loop.index % 3) ~ '.jpg') }}" 
                             alt="{{ voyage.titre }}">
                    </div>
                    <div class="blog-info d-flex align-items-center border border-start-0 border-end-0">
                        <small class="flex-fill text-center border-end py-2">
                            <i class="fa fa-calendar-alt text-primary me-1"></i>
                            {{ voyage.date_debut ? voyage.date_debut|date('d/m/Y') : 'N/A' }}
                        </small>
                        <small class="flex-fill text-center border-end py-2">
 <i class="fa fa-tag text-primary me-1"></i>{{ voyage.prix }} TND
 <br>
 <span class="text-muted" style="font-size:10px;">
 ~ {{ (voyage.prix * 0.29)|number_format(0) }} EUR |
 {{ (voyage.prix * 0.32)|number_format(0) }} USD
 </span>
</small>
                        <small class="flex-fill text-center py-2">
                            <i class="fa fa-users text-primary me-1"></i>{{ voyage.nb_places }} places
                        </small>
                    </div>
                </div>
                <div class="blog-content border border-top-0 rounded-bottom p-4">
                    <h4 class="mb-2">{{ voyage.titre }}</h4>
                    <p class="text-muted mb-2" id="desc-{{ loop.index }}">
 {{ voyage.description|slice(0,100) }}...
</p>
<button class="btn btn-outline-secondary btn-sm rounded-pill mb-2"
 onclick="translateDesc({{ loop.index }}, '{{ voyage.description|slice(0,100)|e('js') }}')">
 <i class="fa fa-language me-1"></i>FR - EN
</button>

                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <span class="badge bg-primary rounded-pill px-3 py-2">
                            {{ voyage.date_debut ? voyage.date_debut|date('d/m/Y') : 'N/A' }} → {{ voyage.date_fin ? voyage.date_fin|date('d/m/Y') : 'N/A' }}
                        </span>
                        
                        <a href="{{ path('app_voyage_toggle_favori', {'id': voyage.id_voyage}) }}" 
                           class="btn rounded-pill py-1 px-3 ms-auto {{ voyage.id_voyage in favoris ? 'btn-danger' : 'btn-outline-danger' }}">
                            <i class="fa fa-heart me-1"></i>
                            {{ voyage.id_voyage in favoris ? 'Favori ❤' : 'Ajouter ♡' }}
                        </a>
                        <a href="{{ path('app_voyage_pdf', {'id': voyage.id_voyage}) }}"
 class="btn btn-success rounded-pill py-1 px-3" target="_blank">
 <i class="fa fa-file-pdf me-1"></i>PDF
</a>
                        <a href="{{ path('app_voyage_show', {'id': voyage.id_voyage}) }}"
   class="btn btn-outline-secondary rounded-pill py-1 px-3">
    <i class="fa fa-eye"></i>
</a>
                        
 <button class="btn btn-outline-primary rounded-pill py-1 px-3"
            onclick="shareVoyage('{{ voyage.titre }}', '{{ voyage.description|slice(0,80) }}', '{{ voyage.prix }}')">
        <i class="fa fa-share-alt"></i>
    </button>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">Aucun voyage trouvé</h4>
        </div>
        {% endfor %}
    </div>
</div>
<div class="container mb-4">
 <div class="d-flex justify-content-center">
 {{ knp_pagination_render(voyages) }}
 </div>
</div>
<!-- Footer -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block">
                    <i class="fas fa-envelope me-2"></i>contact@aftertravel.com
                </a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>
<script>
function translateDesc(index, text) {
 const btn = event.target.closest('button');
 btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Traduction...';
 btn.disabled = true;
 fetch('https://api.mymemory.translated.net/get?q=' + encodeURIComponent(text) + '&langpair=fr|en')
 .then(r => r.json())
 .then(data => {
 const translated = data.responseData.translatedText;
 document.getElementById('desc-' + index).textContent = translated + '...';
 btn.innerHTML = '<i class="fa fa-language me-1"></i>EN - FR';
 btn.disabled = false;
 btn.onclick = function() {
 document.getElementById('desc-' + index).textContent = text + '...';
 btn.innerHTML = '<i class="fa fa-language me-1"></i>FR - EN';
 btn.onclick = function() { translateDesc(index, text); };
 };
 })
 .catch(() => { btn.innerHTML = 'FR - EN'; btn.disabled = false; });
}
</script>
<div id="shareModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
     background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center">
    <div style="background:white;border-radius:16px;padding:30px;max-width:400px;width:90%;
                box-shadow:0 20px 60px rgba(0,0,0,0.3)">
        <h5 id="shareTitle" style="color:#13357B;margin-bottom:8px;font-size:18px">Partager</h5>
        <p id="shareDesc" style="color:#666;font-size:13px;margin-bottom:20px"></p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px">
            <a id="shareFacebook" href="#" target="_blank"
               style="background:#1877f2;color:white;padding:12px;border-radius:8px;
                      text-align:center;text-decoration:none;font-weight:bold;font-size:13px">
                <i class="fab fa-facebook-f me-2"></i>Facebook
            </a>
            <a id="shareTwitter" href="#" target="_blank"
               style="background:#1da1f2;color:white;padding:12px;border-radius:8px;
                      text-align:center;text-decoration:none;font-weight:bold;font-size:13px">
                <i class="fab fa-twitter me-2"></i>Twitter
            </a>
            <a id="shareWhatsapp" href="#" target="_blank"
               style="background:#25d366;color:white;padding:12px;border-radius:8px;
                      text-align:center;text-decoration:none;font-weight:bold;font-size:13px">
                <i class="fab fa-whatsapp me-2"></i>WhatsApp
            </a>
            <a id="shareLinkedin" href="#" target="_blank"
               style="background:#0077b5;color:white;padding:12px;border-radius:8px;
                      text-align:center;text-decoration:none;font-weight:bold;font-size:13px">
                <i class="fab fa-linkedin-in me-2"></i>LinkedIn
            </a>
        </div>
        <div style="display:flex;gap:8px;margin-bottom:16px">
            <input id="shareUrl" type="text" readonly
                   style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:6px;
                          font-size:12px;color:#666">
            <button onclick="copyShareUrl()"
                    style="background:#13357B;color:white;border:none;padding:8px 16px;
                           border-radius:6px;cursor:pointer;font-size:12px">
                Copier
            </button>
        </div>
        <button onclick="closeShareModal()"
                style="width:100%;background:#f0f0f0;border:none;padding:10px;
                       border-radius:8px;cursor:pointer;font-size:14px;color:#666">
            Fermer
        </button>
    </div>
</div>
<script>
function shareVoyage(titre, description, prix) {
    const url = window.location.origin + '/voyage';
    const text = 'Decouvrez le voyage : ' + titre + ' - ' + prix + ' TND ! ' + description;
    document.getElementById('shareTitle').textContent = 'Partager : ' + titre;
    document.getElementById('shareDesc').textContent = description + ' - ' + prix + ' TND';
    document.getElementById('shareUrl').value = url;
    document.getElementById('shareFacebook').href =
        'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url) +
        '&quote=' + encodeURIComponent(text);
    document.getElementById('shareTwitter').href =
        'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text) +
        '&url=' + encodeURIComponent(url);
    document.getElementById('shareWhatsapp').href =
        'https://wa.me/?text=' + encodeURIComponent(text + ' ' + url);
    document.getElementById('shareLinkedin').href =
        'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url);
    const modal = document.getElementById('shareModal');
    modal.style.display = 'flex';
}
function closeShareModal() {
    document.getElementById('shareModal').style.display = 'none';
}
function copyShareUrl() {
    const input = document.getElementById('shareUrl');
    input.select();
    document.execCommand('copy');
    alert('Lien copie !');
}
// Fermer en cliquant dehors
document.getElementById('shareModal').addEventListener('click', function(e) {
    if (e.target === this) closeShareModal();
});
</script>

{% endblock %}