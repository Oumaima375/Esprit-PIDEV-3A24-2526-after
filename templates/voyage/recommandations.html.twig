{% extends 'base.html.twig' %}

{% block title %}After Travel - Recommandations{% endblock %}

{% block body %}

<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">Recommandations</h1>
            <p class="text-white fs-5">Filtrez et trouvez le voyage parfait pour vous</p>
        </div>
    </div>
</div>

{# ── Advanced filter panel ── #}
<div class="container mb-5">
    <div class="bg-light rounded p-4 mb-5">
        <h4 class="mb-4"><i class="fa fa-filter text-primary me-2"></i>Filtrage Multicritères</h4>
        <form method="GET" action="{{ path('app_voyage_recommandations') }}">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">🔍 Recherche par titre</label>
                    <input type="text" name="search" class="form-control rounded-pill"
                           placeholder="Ex: Paris, Nature..."
                           value="{{ app.request.query.get('search') }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">💰 Prix min (TND)</label>
                    <input type="number" name="prix_min" class="form-control rounded-pill"
                           placeholder="0"
                           value="{{ app.request.query.get('prix_min') }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">💰 Prix max (TND)</label>
                    <input type="number" name="prix_max" class="form-control rounded-pill"
                           placeholder="9999"
                           value="{{ app.request.query.get('prix_max') }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">📅 Date début</label>
                    <input type="date" name="date_debut" class="form-control rounded-pill"
                           value="{{ app.request.query.get('date_debut') }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">👥 Places min</label>
                    <input type="number" name="places_min" class="form-control rounded-pill"
                           placeholder="0"
                           value="{{ app.request.query.get('places_min') }}">
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary rounded-pill px-5">
                        <i class="fa fa-search me-2"></i>Rechercher
                    </button>
                    <a href="{{ path('app_voyage_recommandations') }}" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa fa-times me-2"></i>Réinitialiser
                    </a>
                    {# Quick link to AI recommendations #}
                    <a href="{{ path('app_voyage_recommandations_ia') }}"
                       class="btn rounded-pill px-4 ms-auto"
                       style="background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;">
                        <i class="fa fa-robot me-2"></i>Essayer les Recommandations IA
                    </a>
                </div>
            </div>
        </form>
    </div>

    {# Results header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">{{ voyages|length }} voyage(s) trouvé(s)</h5>
    </div>

    <div class="row g-4">
        {% for voyage in voyages %}
        <div class="col-lg-4 col-md-6">
            <div class="blog-item h-100">
                <div class="blog-img">
                    <div class="blog-img-inner">
                        {% if voyage.image and voyage.image starts with 'http' %}
                            <img class="img-fluid w-100 rounded-top"
                                 style="height: 220px; object-fit: cover;"
                                 src="{{ voyage.image }}"
                                 alt="{{ voyage.titre }}">
                        {% else %}
                            <img class="img-fluid w-100 rounded-top"
                                 style="height: 220px; object-fit: cover;"
                                 src="{{ asset('img/blog-' ~ (loop.index % 3 == 0 ? 3 : loop.index % 3) ~ '.jpg') }}"
                                 alt="{{ voyage.titre }}">
                        {% endif %}
                    </div>
                    <div class="blog-info d-flex align-items-center border border-start-0 border-end-0">
                        <small class="flex-fill text-center border-end py-2">
                            <i class="fa fa-calendar-alt text-primary me-1"></i>
                            {{ voyage.dateDebut ? voyage.dateDebut|date('d/m/Y') : 'N/A' }}
                        </small>
                        <small class="flex-fill text-center border-end py-2">
                            <i class="fa fa-tag text-primary me-1"></i>{{ voyage.prix }} TND
                        </small>
                        <small class="flex-fill text-center py-2">
                            <i class="fa fa-users text-primary me-1"></i>{{ voyage.nbPlaces }} places
                        </small>
                    </div>
                </div>

                <div class="blog-content border border-top-0 rounded-bottom p-4">
                    <h4 class="mb-2">{{ voyage.titre }}</h4>
                    <p class="text-muted mb-3">{{ voyage.description|slice(0,100) }}...</p>

                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <a href="{{ path('app_voyage_show', {'id': voyage.id}) }}"
                           class="btn btn-primary rounded-pill py-1 px-3">
                            <i class="fa fa-eye me-1"></i>Voir
                        </a>
                        <a href="{{ path('app_voyage_toggle_favori', {'id': voyage.id}) }}"
                           class="btn btn-outline-danger rounded-pill py-1 px-3">
                            <i class="fa fa-heart me-1"></i>Favori
                        </a>
                        <a href="{{ path('app_voyage_pdf', {'id': voyage.id}) }}"
                           class="btn btn-success rounded-pill py-1 px-3" target="_blank">
                            <i class="fa fa-file-pdf me-1"></i>PDF
                        </a>

                        {# ── QR Code toggle ── #}
                        <button class="btn btn-outline-dark rounded-pill py-1 px-3"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#qr-rec-{{ loop.index }}"
                                aria-expanded="false"
                                title="Afficher le QR Code">
                            <i class="fa fa-qrcode"></i>
                        </button>
                    </div>

                    {# ── QR Code collapsible panel ── #}
                    <div class="collapse" id="qr-rec-{{ loop.index }}">
                        <div class="border rounded p-3 text-center bg-light">
                            <p class="small text-muted mb-2 fw-bold">Scannez pour voir ce voyage</p>
                            {% set voyageUrl = app.request.schemeAndHttpHost ~ path('app_voyage_show', {'id': voyage.id}) %}
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ voyageUrl|url_encode }}&color=13357B&bgcolor=ffffff&qzone=2"
                                 alt="QR Code {{ voyage.titre }}"
                                 width="150" height="150"
                                 class="img-fluid rounded">
                            <p class="small text-muted mt-2 mb-0">{{ voyage.titre }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% else %}
        <div class="col-12 text-center py-5">
            <i class="fa fa-search fa-4x text-muted mb-4 d-block"></i>
            <h4 class="text-muted">Aucun voyage trouvé</h4>
            <p class="text-muted">Essayez de modifier vos critères de recherche</p>
            <div class="d-flex gap-3 justify-content-center mt-3 flex-wrap">
                <a href="{{ path('app_voyage_recommandations') }}" class="btn btn-primary rounded-pill">
                    <i class="fa fa-times me-2"></i>Réinitialiser les filtres
                </a>
                <a href="{{ path('app_voyage_recommandations_ia') }}"
                   class="btn rounded-pill"
                   style="background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;">
                    <i class="fa fa-robot me-2"></i>Essayer les Recommandations IA
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

{# Footer #}
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block">
                    <i class="fas fa-envelope me-2"></i>contact@aftertravel.com
                </a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>

{% endblock %}
