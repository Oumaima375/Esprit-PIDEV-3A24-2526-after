{% extends 'base.html.twig' %}

{% block title %}{{ voyage.titre }}{% endblock %}

{% block body %}

<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">{{ voyage.titre }}</h1>
            <a href="{{ path('app_voyage') }}" class="btn btn-light rounded-pill py-2 px-4">
                <i class="fa fa-arrow-left me-2"></i>Retour aux Voyages
            </a>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-5">
        <div class="col-lg-6">
            <img src="{{ voyage.image starts with 'http' ? voyage.image : asset('img/blog-1.jpg') }}"
                 class="img-fluid rounded" style="width:100%; height:400px; object-fit:cover;" alt="{{ voyage.titre }}">
        </div>

        <div class="col-lg-6">
            <h2 class="mb-4">{{ voyage.titre }}</h2>
            <p class="mb-4">{{ voyage.description }}</p>

            <!-- BADGES DETAILS -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="bg-light rounded p-3 text-center">
                        <i class="fa fa-calendar-alt text-primary fa-2x mb-2"></i>
                        <p class="mb-0 fw-bold">Date début</p>
                        <p class="mb-0">{{ voyage.dateDebut ? voyage.dateDebut|date('d/m/Y') : 'N/A' }}</p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bg-light rounded p-3 text-center">
                        <i class="fa fa-calendar-check text-primary fa-2x mb-2"></i>
                        <p class="mb-0 fw-bold">Date fin</p>
                        <p class="mb-0">{{ voyage.dateFin ? voyage.dateFin|date('d/m/Y') : 'N/A' }}</p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bg-light rounded p-3 text-center">
                        <i class="fa fa-tag text-primary fa-2x mb-2"></i>
                        <p class="mb-0 fw-bold">Prix</p>
                        <p class="mb-0 text-primary fw-bold">{{ voyage.prix }} TND</p>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bg-light rounded p-3 text-center">
                        <i class="fa fa-users text-primary fa-2x mb-2"></i>
                        <p class="mb-0 fw-bold">Places disponibles</p>
                        <p class="mb-0">{{ voyage.nbPlaces }}</p>
                    </div>
                </div>
            </div>

            <!-- ✅ METEO -->
            {% if meteo %}
            <div class="bg-light rounded p-4 mb-4">
                <h5 class="text-primary mb-3">
                    <i class="fa fa-cloud-sun me-2"></i>Meteo a {{ meteo.ville }}
                </h5>
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="fw-bold fs-4">{{ meteo.temperature }}°C</div>
                        <div class="text-muted small">{{ meteo.description }}</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold">{{ meteo.windspeed }} km/h</div>
                        <div class="text-muted small">Vent</div>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info mb-0 py-2">{{ meteo.conseil }}</div>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- ✅ TIMEZONE -->
            {% if timezone %}
            <div class="bg-light rounded p-4 mb-4">
                <h5 class="text-primary mb-3">
                    <i class="fa fa-clock me-2"></i>Heure locale
                </h5>
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="fw-bold fs-4">{{ timezone.heure }}</div>
                        <div class="text-muted small">Heure locale</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold">{{ timezone.moment }}</div>
                        <div class="text-muted small">Moment</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-primary">{{ timezone.decalage }}</div>
                        <div class="text-muted small">Décalage / Tunis</div>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- BUTTONS -->
            
        </div>
    </div>
</div>

<!-- FOOTER -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un.</p>
            </div>

            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block">
                    <i class="fas fa-envelope me-2"></i>contact@aftertravel.com
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i>
        <span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>

{% endblock %}