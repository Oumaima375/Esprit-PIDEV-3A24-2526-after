{% extends 'base.html.twig' %}

{% block title %}After Travel - Mes Réservations{% endblock %}

{% block body %}

{# ── Page Header (same style as voyage/index.html.twig) ── #}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3">Réservations &amp; Paiements</h1>
            <p class="text-white fs-5">Gérez vos réservations et suivez vos paiements</p>
        </div>
    </div>
</div>

{# ── Tab navigation ── #}
<div class="container mb-4">
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a href="{{ path('app_dashboard', {view: 'reservations'}) }}"
           class="btn {{ activeView != 'payments' ? 'btn-primary' : 'btn-outline-primary' }} rounded-pill px-4">
            <i class="fa fa-calendar-check me-2"></i>Mes Réservations
        </a>
        <a href="{{ path('app_dashboard', {view: 'payments'}) }}"
           class="btn {{ activeView == 'payments' ? 'btn-primary' : 'btn-outline-primary' }} rounded-pill px-4">
            <i class="fa fa-credit-card me-2"></i>Mes Paiements
        </a>
        <a href="#" class="btn btn-success rounded-pill px-4 ms-auto"
           data-bs-toggle="modal" data-bs-target="#reservation-modal">
            <i class="fa fa-plus me-2"></i>Nouvelle Réservation
        </a>
        <a href="#" class="btn btn-outline-success rounded-pill px-4"
           data-bs-toggle="modal" data-bs-target="#payment-modal">
            <i class="fa fa-plus me-2"></i>Nouveau Paiement
        </a>
    </div>
</div>

{% if dbError %}
<div class="container mb-4">
    <div class="alert alert-danger rounded-3">
        <strong><i class="fa fa-exclamation-circle me-2"></i>Base de données</strong> {{ dbError }}
    </div>
</div>
{% endif %}

{# ══════════════════════════════════════════════════════════
   RESERVATIONS VIEW
   ══════════════════════════════════════════════════════════ #}
<div id="view-reservations" style="{{ activeView == 'payments' ? 'display:none' : '' }}">

    {# Stats #}
    <div class="container mb-4">
        <div class="row g-3">
            {% for stat in reservationStats %}
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 text-center p-3">
                    <h2 class="fw-bold text-{{ stat.variant == 'primary' ? 'primary' : (stat.variant == 'success' ? 'success' : 'warning') }} mb-1">{{ stat.value }}</h2>
                    <p class="text-muted mb-0 small">{{ stat.label }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# Search / Filter bar #}
    <div class="container mb-4">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold">Recherche</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa fa-search text-primary"></i></span>
                        <input type="text" class="form-control rounded-end" placeholder="Destination, type ou référence…" id="searchInput">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Date début</label>
                    <input type="date" class="form-control" id="startDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Date fin</label>
                    <input type="date" class="form-control" id="endDate">
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" id="resetSearch" title="Réinitialiser">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Reservation Cards #}
    <div class="container mb-5">
        <div class="row g-4" id="reservationCards">
            {% for reservation in reservations %}
            <div class="col-lg-4 col-md-6 res-card-wrapper" data-date="{{ reservation.date }}">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                        <div>
                            <small class="opacity-75">Réf #{{ reservation.id }}</small>
                            <h5 class="mb-0 fw-bold">{{ reservation.destination }}</h5>
                        </div>
                        <span class="badge {{ reservation.status == 'En attente' ? 'bg-warning text-dark' : 'bg-success' }} rounded-pill">
                            {{ reservation.status }}
                        </span>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-3">
                            <li class="mb-2"><i class="fa fa-map-marker-alt text-primary me-2"></i><strong>Destination :</strong> {{ reservation.destination }}</li>
                            <li class="mb-2"><i class="fa fa-calendar text-primary me-2"></i><strong>Date :</strong> {{ reservation.labelDate }}</li>
                            <li class="mb-2"><i class="fa fa-tag text-primary me-2"></i><strong>Type :</strong> {{ reservation.type }}</li>
                            <li class="mb-2"><i class="fa fa-users text-primary me-2"></i><strong>Personnes :</strong> {{ reservation.people }}</li>
                        </ul>
                        {% if reservation.description %}
                        <p class="text-muted small border-top pt-2">{{ reservation.description|slice(0,100) }}{% if reservation.description|length > 100 %}…{% endif %}</p>
                        {% endif %}
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                        <strong class="text-primary fs-5">{{ reservation.price }}</strong>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" title="Imprimer" onclick="window.print()">
                                <i class="fa fa-print"></i>
                            </button>
                            <a href="{{ path('app_admin_reservation_edit', {id: reservation.id, return: 'dashboard'}) }}"
                               class="btn btn-sm btn-outline-primary rounded-pill" title="Modifier">
                                <i class="fa fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_dashboard_reservation_delete', {id: reservation.id}) }}"
                                  onsubmit="return confirm('Supprimer cette réservation ?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Supprimer">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center py-5">
                <i class="fa fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
                <h5 class="text-muted">Aucune réservation trouvée</h5>
                <p class="text-muted">Commencez par créer votre première réservation.</p>
                <a href="{{ path('app_dashboard', {view: 'reservations', modal: 'reservation'}) }}"
                   class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="fa fa-plus me-2"></i>Nouvelle Réservation
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════
   PAYMENTS VIEW
   ══════════════════════════════════════════════════════════ #}
<div id="view-payments" style="{{ activeView == 'payments' ? '' : 'display:none' }}">

    {# Payment Stats #}
    <div class="container mb-4">
        <div class="row g-3">
            {% for stat in paymentStats %}
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-3 d-flex flex-row align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;flex-shrink:0">
                        <i class="fa fa-{{ stat.icon == 'wallet' ? 'wallet' : 'dollar-sign' }} text-primary fs-5"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-primary mb-0">{{ stat.value }}</h3>
                        <p class="text-muted mb-0 small">{{ stat.label }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# Payments Table #}
    <div class="container mb-5">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fa fa-history text-primary me-2"></i>Historique des Paiements</h5>
                <a href="#" class="btn btn-primary btn-sm rounded-pill px-3"
                   data-bs-toggle="modal" data-bs-target="#payment-modal">
                    <i class="fa fa-plus me-1"></i>Nouveau
                </a>
            </div>
            <div class="card-body p-0">
                {% if payments is empty %}
                <div class="text-center py-5">
                    <i class="fa fa-credit-card fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">Aucun paiement trouvé</h5>
                    <p class="text-muted">Vos paiements apparaîtront ici une fois enregistrés.</p>
                </div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Référence</th>
                                <th>Réservation</th>
                                <th>Montant</th>
                                <th>Méthode</th>
                                <th>Statut</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                            <tr>
                                <td class="ps-4 fw-bold">{{ payment.ref }}</td>
                                <td class="text-muted">{{ payment.trip }}</td>
                                <td><strong class="text-primary">{{ payment.amount }}</strong></td>
                                <td><span class="badge bg-light text-dark border">{{ payment.methode ?? '—' }}</span></td>
                                <td>
                                    <span class="badge rounded-pill
                                        {% if payment.status == 'En attente' %}bg-warning text-dark
                                        {% elseif payment.status|lower starts with 'remb' %}bg-secondary
                                        {% else %}bg-success{% endif %}">
                                        {{ payment.status }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="{{ path('app_payment_receipt', {id: payment.id}) }}"
                                           class="btn btn-sm btn-outline-secondary rounded-pill" title="Reçu" target="_blank">
                                            <i class="fa fa-print"></i>
                                        </a>
                                        <a href="{{ path('app_admin_payment_edit', {id: payment.id, return: 'dashboard'}) }}"
                                           class="btn btn-sm btn-outline-primary rounded-pill" title="Modifier">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_dashboard_payment_delete', {id: payment.id}) }}"
                                              onsubmit="return confirm('Supprimer ce paiement ?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Supprimer">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# ── Footer ── #}
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un. Découvrez, planifiez et vivez des aventures inoubliables.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block"><i class="fas fa-envelope me-2"></i>contact@aftertravel.com</a>
                <a class="text-white mb-2 d-block"><i class="fas fa-phone me-2"></i>+216 11 111 111</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>

{# ── Modals ── #}
{% include 'dashboard/partials/_reservation_modal.html.twig' %}
{% include 'dashboard/partials/_payment_modal.html.twig' %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    // ── Auto-open modal from ?modal= query param ──────────────────
    const urlParams  = new URLSearchParams(window.location.search);
    const modalParam = urlParams.get('modal');
    if (modalParam === 'reservation') {
        new bootstrap.Modal(document.getElementById('reservation-modal')).show();
    }
    if (modalParam === 'payment') {
        new bootstrap.Modal(document.getElementById('payment-modal')).show();
    }

    // ── Search & filter for reservation cards ─────────────────────
    const searchInput = document.getElementById('searchInput');
    const startDate   = document.getElementById('startDate');
    const endDate     = document.getElementById('endDate');
    const resetBtn    = document.getElementById('resetSearch');
    const normalize   = v => (v||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();

    const filterCards = () => {
        const q = normalize(searchInput?.value || '');
        const s = startDate?.value || '';
        const e = endDate?.value   || '';
        document.querySelectorAll('.res-card-wrapper').forEach(card => {
            const hay  = normalize(card.innerText || '');
            const date = card.dataset.date || '';
            const ok   = (!q || hay.includes(q)) && (!s || date >= s) && (!e || date <= e);
            card.style.display = ok ? '' : 'none';
        });
    };
    [searchInput, startDate, endDate].forEach(el => el?.addEventListener('input', filterCards));
    resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (startDate)   startDate.value   = '';
        if (endDate)     endDate.value     = '';
        filterCards();
    });

    // ── Lucide icons ──────────────────────────────────────────────
    if (window.lucide) lucide.createIcons();
});
</script>
{% endblock %}
