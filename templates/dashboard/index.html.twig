{% extends 'base.html.twig' %}

{% block title %}AFTER Travel Dashboard{% endblock %}

{% block body %}
<div class="app-shell" data-app data-initial-view="{{ activeView|default('reservations') }}">
    <header class="hero">
        <div class="hero__main">
            <div class="brand">
                <div class="brand__logo"><i data-lucide="plane"></i></div>
                <div>
                    <p class="eyebrow">Travel Dashboard</p>
                    <h1>AFTER Travel</h1>
                </div>
            </div>

            <nav class="hero__nav">
                <a class="tab-button {{ activeView != 'payments' ? 'is-active' : '' }}" href="{{ path('app_dashboard', {view: 'reservations'}) }}" data-view-target="reservations"><i data-lucide="briefcase-business"></i>Reservations</a>
                <a class="tab-button {{ activeView == 'payments' ? 'is-active' : '' }}" href="{{ path('app_dashboard', {view: 'payments'}) }}" data-view-target="payments"><i data-lucide="credit-card"></i>Paiements</a>
            </nav>
        </div>

        <div class="hero__actions">
            <a class="button button--sky" href="{{ path('app_dashboard', {view: 'reservations', modal: 'reservation'}) }}">+ Reserver</a>
            <a class="button button--outline-light" href="{{ path('app_dashboard', {view: 'payments'}) }}">Mes Paiements</a>
            <a class="button button--ghost" href="{{ path('app_admin') }}"><i data-lucide="settings"></i>Admin</a>
        </div>
    </header>

    <main class="content">
        {% if dbError %}
            <div class="alert-banner">
                <strong>Base de donnees</strong>
                <span>{{ dbError }}</span>
            </div>
        {% endif %}

        <section class="view {{ activeView != 'payments' ? 'is-active' : '' }}" data-view="reservations">
            <div class="stats-grid">
                {% for stat in reservationStats %}
                    <article class="stat-card">
                        <span class="stat-card__badge stat-card__badge--{{ stat.variant }}">Apercu</span>
                        <strong class="stat-card__value stat-card__value--{{ stat.variant }}">{{ stat.value }}</strong>
                        <p class="stat-card__label">{{ stat.label }}</p>
                    </article>
                {% endfor %}
            </div>

            <section class="search-panel">
                <div class="search-panel__grid">
                    <label class="field-group field-group--search">
                        <i data-lucide="search"></i>
                        <input type="text" placeholder="Recherche destination, type ou reference" data-search-input>
                    </label>
                    <label class="field-group"><input type="date" data-start-date></label>
                    <label class="field-group"><input type="date" data-end-date></label>
                    <button class="button button--secondary" type="button" data-reset-search>
                        <i data-lucide="filter-x"></i>
                        Reinitialiser
                    </button>
                </div>
            </section>

            <section class="reservation-grid">
                {% for reservation in reservations %}
                    <article class="reservation-card" data-card data-date="{{ reservation.date }}">
                        <div class="reservation-card__header">
                            <div>
                                <p class="reservation-card__ref">Ref #{{ reservation.id }}</p>
                                <h3>{{ reservation.destination }}</h3>
                            </div>
                            <span class="status-badge status-badge--{{ reservation.status == 'En attente' ? 'warning' : 'success' }}">{{ reservation.status }}</span>
                        </div>

                        <div class="reservation-card__body">
                            <div class="detail-row"><span class="detail-icon"><i data-lucide="map-pinned"></i></span><div><p>Destination</p><strong>{{ reservation.destination }}</strong></div></div>
                            <div class="detail-row"><span class="detail-icon"><i data-lucide="calendar-days"></i></span><div><p>Date</p><strong>{{ reservation.labelDate }}</strong></div></div>
                            <div class="detail-row"><span class="detail-icon"><i data-lucide="{{ reservation.type == 'Plage' ? 'umbrella' : (reservation.type == 'Safari' ? 'globe-2' : 'hotel') }}"></i></span><div><p>Type</p><strong>{{ reservation.type }}</strong></div></div>
                            <div class="detail-row"><span class="detail-icon"><i data-lucide="users"></i></span><div><p>Personnes</p><strong>{{ reservation.people }} voyageurs</strong></div></div>

                            <p class="reservation-card__description">{{ reservation.description }}</p>

                            <div class="reservation-card__footer">
                                <strong class="price">{{ reservation.price }}</strong>
                                <div class="icon-actions">
                                    <button type="button" class="icon-button" aria-label="Imprimer"><i data-lucide="printer"></i></button>
                                    <a href="{{ path('app_admin_reservation_edit', {id: reservation.id, return: 'dashboard'}) }}" class="icon-button" aria-label="Modifier"><i data-lucide="square-pen"></i></a>
                                    <form method="post" action="{{ path('app_dashboard_reservation_delete', {id: reservation.id}) }}" onsubmit="return confirm('Supprimer cette reservation ?');">
                                        <button type="submit" class="icon-button icon-button--danger" aria-label="Supprimer"><i data-lucide="trash-2"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </article>
                {% else %}
                    <article class="empty-state">
                        <h3>Aucune reservation trouvee</h3>
                        <p>Verifiez la connexion MySQL ou ajoutez des lignes dans la table <code>reservation</code>.</p>
                    </article>
                {% endfor %}
            </section>
        </section>

        <section class="view {{ activeView == 'payments' ? 'is-active' : '' }}" data-view="payments">
            <div class="section-heading">
                <div>
                    <p class="eyebrow eyebrow--brand">Mes Paiements</p>
                    <h2>Suivi financier</h2>
                </div>
                <a class="button button--primary" href="{{ path('app_dashboard', {view: 'payments', modal: 'payment'}) }}">+ Nouveau</a>
            </div>

            <div class="payment-stats">
                {% for stat in paymentStats %}
                    <article class="payment-stat-card">
                        <div>
                            <p>{{ stat.label }}</p>
                            <strong>{{ stat.value }}</strong>
                        </div>
                        <span class="payment-stat-card__icon"><i data-lucide="{{ stat.icon }}"></i></span>
                    </article>
                {% endfor %}
            </div>

            <section class="panel">
                <div class="panel__heading">
                    <div>
                        <h3>Historique</h3>
                        <p>Toutes les transactions recentes et leurs statuts.</p>
                    </div>
                </div>

                <div class="payments-list">
                    {% for payment in payments %}
                        <article class="payment-row">
                            <div class="payment-row__info">
                                <span class="payment-row__icon"><i data-lucide="wallet"></i></span>
                                <div><strong>{{ payment.ref }}</strong><p>{{ payment.trip }}</p></div>
                            </div>
                            <div class="payment-row__meta">
                                <span class="status-badge status-badge--{{ payment.status == 'En attente' ? 'warning' : ((payment.status|lower starts with 'remb') ? 'muted' : 'success') }}">{{ payment.status }}</span>
                                <span class="amount-badge">{{ payment.amount }}</span>
                                <div class="icon-actions">
                                    <a href="{{ path('app_payment_receipt', {id: payment.id}) }}" class="icon-button" aria-label="Imprimer" target="_blank" rel="noopener"><i data-lucide="printer"></i></a>
                                    <a href="{{ path('app_admin_payment_edit', {id: payment.id, return: 'dashboard'}) }}" class="icon-button" aria-label="Modifier"><i data-lucide="square-pen"></i></a>
                                    <form method="post" action="{{ path('app_dashboard_payment_delete', {id: payment.id}) }}" onsubmit="return confirm('Supprimer ce paiement ?');">
                                        <button type="submit" class="icon-button icon-button--danger" aria-label="Supprimer"><i data-lucide="trash-2"></i></button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <article class="empty-state">
                            <h3>Aucun paiement trouve</h3>
                            <p>Ajoutez des lignes dans la table <code>paiement</code> pour alimenter cette vue.</p>
                        </article>
                    {% endfor %}
                </div>
            </section>
        </section>
    </main>

    {% include 'dashboard/partials/_reservation_modal.html.twig' %}
    {% include 'dashboard/partials/_payment_modal.html.twig' %}
</div>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
const viewButtons = document.querySelectorAll('[data-view-target]');
const views = document.querySelectorAll('[data-view]');
const modals = document.querySelectorAll('.modal');
const searchInput = document.querySelector('[data-search-input]');
const startDate = document.querySelector('[data-start-date]');
const endDate = document.querySelector('[data-end-date]');
const resetButton = document.querySelector('[data-reset-search]');
const cards = document.querySelectorAll('[data-card]');
const initialView = document.querySelector('[data-app]')?.dataset.initialView || 'reservations';

const setActiveView = (target) => {
    views.forEach((view) => view.classList.toggle('is-active', view.dataset.view === target));
    viewButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.viewTarget === target));
};

const openModal = (id) => {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
};

const closeModal = (modal) => {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
};

const normalizeText = (value) => (value || '')
    .toString()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const filterCards = () => {
    const query = normalizeText(searchInput?.value || '');
    const start = startDate?.value || '';
    const end = endDate?.value || '';

    cards.forEach((card) => {
        const haystack = normalizeText(card.innerText || card.textContent || '');
        const date = card.dataset.date || '';
        const matchesQuery = !query || haystack.includes(query);
        const matchesStart = !start || date >= start;
        const matchesEnd = !end || date <= end;
        const isVisible = matchesQuery && matchesStart && matchesEnd;
        card.hidden = !isVisible;
        card.style.display = isVisible ? '' : 'none';
    });
};

viewButtons.forEach((button) => button.addEventListener('click', () => setActiveView(button.dataset.viewTarget)));
document.querySelectorAll('[data-modal-open]').forEach((button) => button.addEventListener('click', () => openModal(button.dataset.modalOpen)));
document.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', () => {
    const modal = button.closest('.modal');
    if (modal) closeModal(modal);
}));

[searchInput, startDate, endDate].forEach((element) => {
    element?.addEventListener('input', filterCards);
    element?.addEventListener('change', filterCards);
});

resetButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (startDate) startDate.value = '';
    if (endDate) endDate.value = '';
    filterCards();
});

document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
        modals.forEach((modal) => closeModal(modal));
    }
});

setActiveView(initialView);
filterCards();
if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
}
</script>
{% endblock %}
