    <script>
    // ── User search filter ──
    window.filterUsers = function() {
        var term = document.getElementById('userSearch').value.toLowerCase();
        document.querySelectorAll('#usersGridAdmin > .user-card-admin').forEach(function(c) {
            c.style.display = (c.dataset.name.includes(term) || c.dataset.email.includes(term)) ? '' : 'none';
        });
    };

    // ── Modal helpers ──
    function showModal(id)  { var m=document.getElementById(id); m.style.display='flex'; }
    function hideModal(id)  { var m=document.getElementById(id); m.style.display='none'; }

    window.openAddModal  = function() { showModal('addModal'); };
    window.closeAddModal = function() { hideModal('addModal'); };
    window.closeEditModal= function() { hideModal('editModal'); };

    window.openEditModal = function(btn) {
        var d = btn.dataset;
        var f = document.getElementById('editForm');
        f.action = d.editUrl;
        document.getElementById('edit_csrf').value     = d.csrf;
        document.getElementById('edit_nom').value      = d.nom      || '';
        document.getElementById('edit_prenom').value   = d.prenom   || '';
        document.getElementById('edit_email').value    = d.email    || '';
        document.getElementById('edit_tel').value      = d.telephone|| '';
        document.getElementById('edit_type').value     = (d.type === 'admin') ? 'admin' : 'voyageur';
        document.getElementById('edit_password').value = '';
        document.getElementById('edit_photo').value    = '';
        document.getElementById('editPhotoPreview').src= d.photo || '';
        document.getElementById('editModalSubtitle').textContent = (d.prenom||'') + ' ' + (d.nom||'');
        showModal('editModal');
    };

    // Close on overlay click
    ['addModal','editModal'].forEach(function(id) {
        document.getElementById(id).addEventListener('click', function(e) {
            if (e.target === this) hideModal(id);
        });
    });

    // Add form AJAX
    document.getElementById('addForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(this);
        fetch('{{ path('user_new') }}', {
            method:'POST',
            headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
            body: fd
        }).then(r=>r.json()).then(function(j) {
            if (j.success) { alert(j.message); closeAddModal(); location.reload(); }
            else alert(j.message || 'Erreur');
        }).catch(function(){ alert('Erreur réseau'); });
    });

    // Edit form AJAX
    document.getElementById('editForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = document.getElementById('editSubmitBtn');
        btn.disabled = true; btn.textContent = 'Enregistrement…';
        var fd = new FormData(this);
        fetch(this.action, {
            method:'POST',
            headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
            body: fd
        }).then(r=>r.json()).then(function(j) {
            btn.disabled=false; btn.textContent='Enregistrer';
            if (j.success) { alert(j.message); closeEditModal(); location.reload(); }
            else alert(j.message || 'Erreur');
        }).catch(function(){ btn.disabled=false; btn.textContent='Enregistrer'; alert('Erreur réseau'); });
    });
    </script>

    <script>
    // ── Document tab AJAX loader ──
    (function () {
        var tabLabels = {
            documents:      '📄 Documents',
            document_new:   '➕ Nouveau Document',
            document_stats: '📊 Statistiques Documents',
            categories:     '📂 Catégories'
        };

        window.loadDocTab = function (tab) {
            var panel = document.getElementById('docTabContent');
            var body  = document.getElementById('docTabBody');
            var title = document.getElementById('docTabTitle');

            // Show panel & highlight nav link
            panel.style.display = 'block';
            title.textContent   = tabLabels[tab] || tab;
            document.querySelectorAll('.doc-tab-link').forEach(function (el) {
                el.classList.toggle('active', el.dataset.docTab === tab);
            });

            // Spinner
            body.innerHTML = '<div style="text-align:center;padding:60px;color:var(--text-secondary)">'
                + '<i class="fas fa-spinner fa-spin" style="font-size:32px;margin-bottom:14px;display:block"></i>'
                + '<p>Chargement\u2026</p></div>';

            // Smooth scroll to panel
            setTimeout(function () {
                panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 80);

            // Fetch the admin page and extract just the .admin-card section
            fetch('/admin?tab=' + encodeURIComponent(tab), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function (html) {
                var tmp = document.createElement('div');
                tmp.innerHTML = html;
                var section = tmp.querySelector('.admin-card');
                if (section) {
                    body.innerHTML = '';
                    var wrapper = document.createElement('div');
                    wrapper.style.cssText = 'padding:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px';
                    wrapper.appendChild(section);
                    body.appendChild(wrapper);

                    // Re-execute inline scripts from fetched content
                    wrapper.querySelectorAll('script').forEach(function (s) {
                        var ns = document.createElement('script');
                        ns.textContent = s.textContent;
                        document.body.appendChild(ns);
                    });
                } else {
                    body.innerHTML = '<p style="padding:24px;color:var(--text-secondary)">Aucun contenu trouv\u00e9 pour cet onglet.</p>';
                }
            })
            .catch(function (err) {
                body.innerHTML = '<p style="padding:24px;color:#ef4444">\u26a0\ufe0f Erreur de chargement : ' + err.message + '</p>';
            });
        };

        window.closeDocTab = function () {
            document.getElementById('docTabContent').style.display = 'none';
            document.querySelectorAll('.doc-tab-link').forEach(function (el) {
                el.classList.remove('active');
            });
        };
    })();
    </script>
</body>
</html>
