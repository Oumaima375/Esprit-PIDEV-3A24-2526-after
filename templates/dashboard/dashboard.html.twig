<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}After Travel{% endblock %}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-dashboard.css') }}">
    {% block stylesheets %}{% endblock %}

    <style>
        /* ══ FORCE LIGHT THEME - Text always black/dark ══ */
        body { background-color: #e8ead0 !important; color: #1a2b5e !important; }
        .main-content { color: #1a2b5e !important; }
        .main-content h1, .main-content h2, .main-content h3 { color: #1a2b5e !important; }
        .card, .card * { color: #1a2b5e; }
        .header h1 { color: #1a2b5e !important; }
        .header-subtitle { color: #6b7280 !important; }
        table th { color: #6b7280 !important; }
        table td { color: #1a2b5e !important; }
        /* Override any dark-theme vars that may bleed through */
        --text-primary: #1a2b5e;
        --text-secondary: #6b7280;
        --text-muted: #9ca3af;
        --bg-card: #ffffff;
        --bg-card-hover: #f8f9fc;
        --bg-primary: #f8f9fc;
        --border: #e2e5f0;

        /* ══ Nav labels visible ══ */
        .nav-label {
            display: block !important;
            font-size: 10px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 1.2px !important;
            color: rgba(255,255,255,0.35) !important;
            padding: 14px 24px 5px !important;
            margin: 0 !important;
        }
        /* ══ Coming-soon module items ══ */
        .nav-item-soon {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
            padding: 11px 24px !important;
            color: rgba(255,255,255,0.28) !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            border-left: 3px solid transparent !important;
        }
        .badge-soon {
            margin-left: auto;
            font-size: 9px; font-weight: 700;
            background: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.4);
            padding: 2px 7px; border-radius: 20px;
            letter-spacing: 0.3px;
        }
        /* ══ Export nav items ══ */
        .nav-item.export-csv { color: rgba(74,222,128,0.85) !important; }
        .nav-item.export-csv:hover { color: #4ade80 !important; background: rgba(34,197,94,0.1) !important; }
        .nav-item.export-pdf { color: rgba(56,189,248,0.85) !important; }
        .nav-item.export-pdf:hover { color: #38bdf8 !important; background: rgba(14,165,233,0.1) !important; }
        /* ══ Sidebar user card (already in template but repeated for safety) ══ */
        .sidebar-user-photo {
            width: 34px; height: 34px; border-radius: 50%;
            object-fit: cover; flex-shrink: 0;
        }
        .sidebar-logout-link {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; border-radius: 10px;
            color: rgba(255,255,255,0.6); font-size: 13px; font-weight: 600;
            text-decoration: none;
            background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.18);
            transition: background 0.2s, color 0.2s;
        }
        .sidebar-logout-link:hover { background: rgba(239,68,68,0.2); color: #fca5a5; }
        .sidebar-back-link {
            display: flex; align-items: center; gap: 8px;
            margin: 0 14px 18px;
            color: rgba(255,255,255,0.3); font-size: 12px;
            text-decoration: none; padding: 7px 10px; border-radius: 8px;
            transition: color 0.2s;
        }
        .sidebar-back-link:hover { color: rgba(255,255,255,0.65); }
        .sidebar-user-block {
            margin-top: auto;
            padding: 12px 14px 0;
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        .sidebar-user-card {
            border-radius: 12px; padding: 11px 13px;
            display: flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .sidebar-user-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 700; flex-shrink: 0;
            background: linear-gradient(135deg,#4a80f5,#76a0e0); color: #fff;
            text-transform: uppercase;
        }
        .sidebar-user-name { font-size: 13px; font-weight: 600; color: #e8eaf0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sidebar-user-email { font-size: 11px; color: rgba(255,255,255,0.4); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top:1px; }
        .sidebar-logout-wrap { padding: 8px 14px 10px; }

        /* ── Sidebar user card ── */
        .sidebar-user-block { padding: 0 14px 6px; }
        .sidebar-user-card {
            border-radius: 14px; padding: 14px 15px;
            display: flex; align-items: center; gap: 12px; transition: background 0.2s;
        }
        [data-theme="dark"]  .sidebar-user-card { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); }
        [data-theme="light"] .sidebar-user-card { background:rgba(0,0,0,.04);       border:1px solid rgba(0,0,0,.08); }
        .sidebar-user-avatar {
            width:40px; height:40px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-size:14px; font-weight:700; flex-shrink:0; text-transform:uppercase;
            background: linear-gradient(135deg,#5a7ec2 0%,#76a0e0 100%); color:#fff;
        }
        .sidebar-user-info { flex:1; min-width:0; }
        .sidebar-user-name  { font-size:14px; font-weight:600; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .sidebar-user-email { font-size:11.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; }
        [data-theme="dark"]  .sidebar-user-name  { color:#e8eaf0; }
        [data-theme="light"] .sidebar-user-name  { color:#1a202c; }
        [data-theme="dark"]  .sidebar-user-email { color:rgba(255,255,255,.42); }
        [data-theme="light"] .sidebar-user-email { color:rgba(0,0,0,.45); }
        .sidebar-role-badge {
            display:inline-flex; align-items:center; gap:5px; margin-top:5px;
            padding:2px 9px; border-radius:20px; font-size:11px; font-weight:600; width:fit-content;
            background:rgba(90,126,194,.18); color:#76a0e0; border:1px solid rgba(90,126,194,.35);
        }
        .sidebar-role-badge::before { content:''; width:6px; height:6px; border-radius:50%; background:#5a7ec2; flex-shrink:0; }

        /* ── Users section in main area ── */
        .users-section-title {
            font-size:1rem; font-weight:700; color:var(--text-primary);
            margin:0 0 14px; display:flex; align-items:center; gap:8px;
        }
        .users-grid-admin {
            display:grid;
            grid-template-columns: repeat(auto-fill, minmax(260px,1fr));
            gap:14px;
        }
        .user-card-admin {
            background:var(--bg-card);
            border:1px solid var(--border);
            border-radius:12px;
            padding:16px;
            display:flex;
            align-items:center;
            gap:12px;
        }
        .user-card-admin:hover { background:var(--bg-card-hover); }
        .user-card-admin img {
            width:44px; height:44px; border-radius:50%; object-fit:cover;
            border:2px solid var(--border);
        }
        .user-card-admin-info { flex:1; min-width:0; }
        .user-card-admin-name { font-size:13px; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .user-card-admin-email { font-size:11px; color:var(--text-secondary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; }
        .user-role-chip {
            font-size:10px; font-weight:700; padding:2px 8px; border-radius:20px; margin-top:4px; display:inline-block;
        }
        .user-role-chip.admin    { background:rgba(59,91,219,.15); color:#76a0e0; }
        .user-role-chip.voyageur { background:rgba(184,115,51,.15); color:#c2855a; }

        /* Flash messages in admin area */
        .admin-flash-success { background:#2a4a2a; border:1px solid var(--gain); color:var(--gain); padding:12px 16px; border-radius:8px; margin-bottom:16px; }
        .admin-flash-error   { background:#4a2a2a; border:1px solid var(--loss); color:var(--loss); padding:12px 16px; border-radius:8px; margin-bottom:16px; }
    </style>
</head>
<body>

    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Ouvrir le menu">
        <div class="hamburger"><span></span><span></span><span></span></div>
    </button>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="dashboard">

        <aside class="sidebar" id="sidebar">

            <!-- Logo -->
            <div class="logo">
                <span class="logo-text">After Travel</span>
            </div>

            <!-- Navigation -->
            <nav class="nav-section">

                <div class="nav-label">Principal</div>

                <a href="{{ path('app_dashboard') }}"
                   class="nav-item {{ app.request.get('_route') == 'app_dashboard' ? 'active' }}">
                    <i class="fas fa-tachometer-alt nav-icon"></i> Dashboard
                </a>

                <div class="nav-label">Gestion Voyage</div>

                <a href="{{ path('admin_voyage_index') }}"
                   class="nav-item {{ app.request.get('_route') starts with 'admin_voyage' ? 'active' }}">
                    <i class="fas fa-plane nav-icon"></i> Voyages
                </a>

                <a href="{{ path('admin_destination_index') }}"
                   class="nav-item {{ app.request.get('_route') starts with 'admin_destination' ? 'active' }}">
                    <i class="fas fa-map-marker-alt nav-icon"></i> Destinations
                </a>

                <div class="nav-label">Utilisateurs</div>

                <a href="#usersSection"
                   class="nav-item"
                   onclick="document.getElementById('usersSection').scrollIntoView({behavior:'smooth'});return false;">
                    <i class="fas fa-users nav-icon"></i> Utilisateurs
                </a>

                <div class="nav-label">Autres Modules</div>

                 <div class="nav-label">Gestion Réservation & Paiement</div>
<a href="{{ path('app_admin', {tab: 'reservations'}) }}"
   class="nav-item {{ app.request.get('_route') == 'app_admin' and app.request.query.get('tab') == 'reservations' ? 'active' }}">
    <i class="fas fa-calendar-check nav-icon"></i> Réservations
</a>
<a href="{{ path('app_admin', {tab: 'payments'}) }}"
   class="nav-item {{ app.request.get('_route') == 'app_admin' and app.request.query.get('tab') == 'payments' ? 'active' }}">
    <i class="fas fa-credit-card nav-icon"></i> Paiements
</a>
                <a href="#" onclick="loadActiviteTab(); return false;"
                   class="nav-item" id="nav-activite">
                    <i class="fas fa-hiking nav-icon"></i>
                    Activités
                </a>

                <span class="nav-item-soon">
                    <i class="fas fa-concierge-bell nav-icon" style="width:20px;height:20px;opacity:0.4"></i>
                    Services <span class="badge-soon">bientôt</span>
                </span>

                <div class="nav-label">Gestion Document</div>
<a href="#" onclick="loadDocTab('documents'); return false;"
   class="nav-item doc-tab-link" data-doc-tab="documents">
    <i class="fas fa-file-alt nav-icon"></i> Documents
</a>
<a href="#" onclick="loadDocTab('document_new'); return false;"
   class="nav-item doc-tab-link" data-doc-tab="document_new">
    <i class="fas fa-plus-circle nav-icon"></i> Nouveau Document
</a>
<a href="#" onclick="loadDocTab('document_stats'); return false;"
   class="nav-item doc-tab-link" data-doc-tab="document_stats">
    <i class="fas fa-chart-bar nav-icon"></i> Statistiques
</a>
<a href="#" onclick="loadDocTab('categories'); return false;"
   class="nav-item doc-tab-link" data-doc-tab="categories">
    <i class="fas fa-folder nav-icon"></i> Catégories
</a>
 <span class="nav-item-soon">
                    <i class="fas fa-concierge-bell nav-icon" style="width:20px;height:20px;opacity:0.4"></i>
                    depense <span class="badge-soon">bientôt</span>
                </span>
                <div class="nav-label">Exports</div>

                <a href="{{ path('users_export_csv') }}" class="nav-item export-csv">
                    <i class="fas fa-file-csv nav-icon"></i> Export CSV
                </a>

                <a href="{{ path('users_export_pdf') }}" class="nav-item export-pdf">
                    <i class="fas fa-file-pdf nav-icon"></i> Export PDF
                </a>

            </nav>

            <!-- User card -->
            {% if app.user %}
                {% set initials = (app.user.prenom|first ~ app.user.nom|first)|upper %}
                <div class="sidebar-user-block">
                    <div class="sidebar-user-card">
                        {% if app.user.photoProfil %}
                            <img src="/uploads/photos/{{ app.user.photoProfil }}"
                                 class="sidebar-user-photo"
                                 alt="{{ initials }}"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                            <div class="sidebar-user-avatar" style="display:none">{{ initials }}</div>
                        {% else %}
                            <div class="sidebar-user-avatar">{{ initials }}</div>
                        {% endif %}
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">{{ app.user.prenom }} {{ app.user.nom }}</div>
                            <div class="sidebar-user-email">{{ app.user.userIdentifier }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Logout -->
            <div class="sidebar-logout-wrap">
                <a href="{{ path('_logout_main') }}" class="sidebar-logout-link">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </div>

            <!-- Back to site -->
            <a href="{{ path('app_home') }}" class="sidebar-back-link">
                <i class="fas fa-arrow-left" style="font-size:11px"></i> Retour au site
            </a>

        </aside>

        <main class="main-content">

            {% for msg in app.flashes('success') %}
                <div class="admin-flash-success"><i class="fas fa-check-circle me-2"></i>{{ msg }}</div>
            {% endfor %}
            {% for msg in app.flashes('error') %}
                <div class="admin-flash-error"><i class="fas fa-exclamation-circle me-2"></i>{{ msg }}</div>
            {% endfor %}

            {% block body %}
<div class="header">
    <div class="header-left">
        <h1>Dashboard</h1>
        <p class="header-subtitle">Vue d'ensemble de AfterTravel</p>
    </div>
    <div class="header-right">
        <div class="user-menu">
            {% if app.user %}
            <div class="user-avatar">{{ (app.user.prenom|first ~ app.user.nom|first)|upper }}</div>
            <div class="user-info">
                <span class="user-name">{{ app.user.prenom }}</span>
                <span class="user-role">Administrateur</span>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{# STAT CARDS #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px">
    <div class="stat-card primary">
        <div class="stat-icon"><i class="fas fa-plane" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total Voyages</div>
            <div class="stat-value">{{ totalVoyages }}</div>
            <div class="stat-change positive">voyages actifs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-map-marker-alt" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Destinations</div>
            <div class="stat-value">{{ totalDestinations }}</div>
            <div class="stat-change positive">pays disponibles</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-coins" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Prix Moyen</div>
            <div class="stat-value">{{ prixMoyen }} TND</div>
            <div class="stat-change positive">par voyage</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-chair" style="font-size:22px"></i></div>
        <div class="stat-content">
            <div class="stat-label">Places Totales</div>
            <div class="stat-value">{{ totalPlaces }}</div>
            <div class="stat-change">disponibles</div>
        </div>
    </div>
</div>

{# CHART + TABLE #}
<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px">
    <div class="card">
        <div class="card-header"><h2 class="card-title">Prix des Voyages</h2></div>
        <div style="padding:16px">
            {% set maxPrix = 0 %}
            {% for v in recentVoyages %}{% if v.prix > maxPrix %}{% set maxPrix = v.prix %}{% endif %}{% endfor %}
            <svg viewBox="0 0 500 150" style="width:100%;height:150px">
                <defs>
                    <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" style="stop-color:#b87333"/>
                        <stop offset="100%" style="stop-color:#c9845a"/>
                    </linearGradient>
                </defs>
                {% for v in recentVoyages %}
                    {% set barHeight = maxPrix > 0 ? (v.prix / maxPrix * 120) : 0 %}
                    {% set x = loop.index0 * 90 + 20 %}
                    <rect x="{{ x }}" y="{{ 130 - barHeight }}" width="60" height="{{ barHeight }}" fill="url(#barGrad)" rx="4"/>
                    <text x="{{ x + 30 }}" y="148" text-anchor="middle" fill="var(--text-secondary)" font-size="9">{{ v.titre|slice(0,8) }}</text>
                    <text x="{{ x + 30 }}" y="{{ 125 - barHeight }}" text-anchor="middle" fill="var(--accent-copper)" font-size="9" font-weight="bold">{{ v.prix }}</text>
                {% endfor %}
            </svg>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h2 class="card-title">Top Destinations</h2></div>
        <div style="padding:8px 16px">
        {% for stat in statsDestinations %}
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                <span style="color:var(--text-primary);font-size:13px">
                    <i class="fas fa-map-pin" style="color:var(--accent-copper);margin-right:6px"></i>{{ stat.pays }}
                </span>
                <div style="display:flex;align-items:center;gap:8px">
                    <div style="background:var(--border);border-radius:4px;width:60px;height:6px;overflow:hidden">
                        <div style="background:var(--accent-copper);height:100%;width:{{ statsDestinations[0].count > 0 ? (stat.count / statsDestinations[0].count * 100)|round : 0 }}%"></div>
                    </div>
                    <span style="background:var(--accent-copper);color:white;padding:2px 8px;border-radius:20px;font-size:11px">{{ stat.count }}</span>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>

{# RECENT VOYAGES TABLE #}
<div class="card" style="margin-bottom:24px">
    <div class="card-header">
        <h2 class="card-title">Derniers Voyages</h2>
        <a href="{{ path('admin_voyage_index') }}" class="view-all">Voir tout</a>
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
            <tr style="border-bottom:1px solid var(--border)">
                <th style="padding:10px;text-align:left;color:var(--text-secondary)">Titre</th>
                <th style="padding:10px;text-align:left;color:var(--text-secondary)">Destination</th>
                <th style="padding:10px;text-align:right;color:var(--text-secondary)">Prix</th>
                <th style="padding:10px;text-align:right;color:var(--text-secondary)">Places</th>
                <th style="padding:10px;text-align:center;color:var(--text-secondary)">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for v in recentVoyages %}
            <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:10px">
                    <div style="display:flex;align-items:center;gap:8px">
                        {% if v.image and v.image starts with 'http' %}
                            <img src="{{ v.image }}" style="width:32px;height:32px;border-radius:6px;object-fit:cover">
                        {% endif %}
                        <span style="color:var(--text-primary);font-weight:500">{{ v.titre }}</span>
                    </div>
                </td>
                <td style="padding:10px;color:var(--text-secondary)">{{ v.IdDestination ? v.IdDestination.pays : 'N/A' }}</td>
                <td style="padding:10px;text-align:right;color:var(--gain);font-weight:600">{{ v.prix }} TND</td>
                <td style="padding:10px;text-align:right;color:var(--text-secondary)">{{ v.NbPlaces }}</td>
                <td style="padding:10px;text-align:center">
                    <a href="{{ path('admin_voyage_edit', {id: v.id}) }}"
                       style="color:var(--accent-copper);text-decoration:none;border:1px solid var(--accent-copper);padding:3px 10px;border-radius:6px;font-size:12px">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# QUICK ACTIONS #}
<div class="card">
    <div class="card-header"><h2 class="card-title">Actions Rapides</h2></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;padding:8px 0">
        <a href="{{ path('admin_voyage_new') }}" style="background:var(--accent-gradient);color:white;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:600;font-size:13px"><i class="fas fa-plus"></i> Ajouter Voyage</a>
        <a href="{{ path('admin_voyage_index') }}" style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)"><i class="fas fa-plane"></i> Gérer Voyages</a>
        <a href="{{ path('admin_destination_new') }}" style="background:var(--accent-gradient);color:white;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:600;font-size:13px"><i class="fas fa-plus"></i> Ajouter Destination</a>
        <a href="{{ path('admin_destination_index') }}" style="background:var(--bg-card-hover);color:var(--text-primary);padding:10px 20px;border-radius:8px;text-decoration:none;font-size:13px;border:1px solid var(--border)"><i class="fas fa-map-marker-alt"></i> Gérer Destinations</a>
