<div class="modal fade" id="payment-modal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-primary text-white rounded-top-3">
                <h5 class="modal-title fw-bold" id="paymentModalLabel">
                    <i class="fa fa-credit-card me-2"></i>Nouveau Paiement
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form method="post" action="{{ path('app_payment_create') }}">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Référence</label>
                            <input type="text" name="reference" class="form-control rounded-pill" placeholder="PAY-009" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Montant</label>
                            <input type="number" name="montant" min="0" step="0.01" class="form-control rounded-pill" placeholder="1200" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Devise</label>
                            <select name="devise" class="form-select rounded-pill" required>
                                <option value="TND">TND</option>
                                <option value="EUR">EUR</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Méthode</label>
                            <select name="methode" class="form-select rounded-pill" required>
                                <option value="Carte">Carte</option>
                                <option value="Virement">Virement</option>
                                <option value="Especes">Espèces</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Statut</label>
                            <select name="statut" class="form-select rounded-pill" required>
                                <option value="paye">Payé</option>
                                <option value="En attente">En attente</option>
                                <option value="Rembourse">Remboursé</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Numéro de Réservation</label>
                            <input type="number" name="id_reservation" class="form-control rounded-pill" placeholder="102" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Date de Paiement</label>
                            <input type="date" name="date_paiement" class="form-control rounded-pill" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa fa-save me-2"></i>Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
