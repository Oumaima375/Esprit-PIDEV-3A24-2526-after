<div class="modal{% if openModal == 'payment' %} is-open{% endif %}" id="payment-modal" aria-hidden="{{ openModal == 'payment' ? 'false' : 'true' }}">
    <a class="modal__backdrop" href="{{ path('app_dashboard', {view: 'payments'}) }}"></a>
    <div class="modal__dialog">
        <div class="modal__header">
            <div class="modal__title">
                <span class="modal__icon"><i data-lucide="wallet"></i></span>
                <div>
                    <h3>Effectuer un paiement</h3>
                    <p>Enregistrez un paiement ou mettez a jour son statut.</p>
                </div>
            </div>
            <a href="{{ path('app_dashboard', {view: 'payments'}) }}" class="icon-button icon-button--light"><i data-lucide="x"></i></a>
        </div>
        <form class="modal__body" method="post" action="{{ path('app_payment_create') }}">
            <div class="form-grid">
                <label class="field-block"><span>Reference</span><input type="text" name="reference" placeholder="PAY-009" required></label>
                <label class="field-block"><span>Montant</span><input type="number" name="montant" min="0" step="0.01" placeholder="1200" required></label>
                <label class="field-block"><span>Devise</span><select name="devise" required><option value="TND">TND</option><option value="EUR">EUR</option></select></label>
                <label class="field-block"><span>Methode</span><select name="methode" required><option value="Carte">Carte</option><option value="Virement">Virement</option><option value="Especes">Especes</option></select></label>
                <label class="field-block"><span>Statut</span><select name="statut" required><option value="paye">paye</option><option value="En attente">En attente</option><option value="Rembourse">Rembourse</option></select></label>
                <label class="field-block"><span>Numero de Reservation</span><input type="number" name="id_reservation" placeholder="102" required></label>
                <label class="field-block field-block--full"><span>Date</span><input type="date" name="date_paiement" required></label>
            </div>
            <div class="modal__actions">
                <a class="button button--outline-dark" href="{{ path('app_dashboard', {view: 'payments'}) }}">Annuler</a>
                <button class="button button--primary" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</div>