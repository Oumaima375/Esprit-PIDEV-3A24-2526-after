<div class="modal{% if openModal == 'reservation' %} is-open{% endif %}" id="reservation-modal" aria-hidden="{{ openModal == 'reservation' ? 'false' : 'true' }}">
    <a class="modal__backdrop" href="{{ path('app_dashboard', {view: activeView|default('reservations')}) }}"></a>
    <div class="modal__dialog">
        <div class="modal__header">
            <div class="modal__title">
                <span class="modal__icon"><i data-lucide="plane"></i></span>
                <div>
                    <h3>Nouvelle Reservation</h3>
                    <p>Creez une nouvelle fiche voyage client.</p>
                </div>
            </div>
            <a href="{{ path('app_dashboard', {view: activeView|default('reservations')}) }}" class="icon-button icon-button--light"><i data-lucide="x"></i></a>
        </div>
        <form class="modal__body" method="post" action="{{ path('app_reservation_create') }}">
            <div class="form-grid">
                <label class="field-block"><span>Voyage ID</span><input type="number" name="voyage_id" placeholder="1024" required></label>
                <label class="field-block"><span>Client ID</span><input type="number" name="utilisateur_id" placeholder="980" required></label>
                <label class="field-block"><span>Date du voyage</span><input type="date" name="date_reservation" required></label>
                <label class="field-block"><span>Nb Personnes</span><input type="number" name="nb_personnes" min="1" placeholder="2" required></label>
                <label class="field-block"><span>Prix Total (TND)</span><input type="number" name="prix_total" min="0" step="0.01" placeholder="1200" required></label>
                <label class="field-block">
                    <span>Type</span>
                    <select name="type" required>
                        <option value="Hotel">Hotel</option>
                        <option value="Plage">Plage</option>
                        <option value="Safari">Safari</option>
                    </select>
                </label>
                <label class="field-block">
                    <span>Statut</span>
                    <select name="statut" required>
                        <option value="En attente">En attente</option>
                        <option value="Confirmée">Confirmée</option>
                        <option value="Annulée">Annulée</option>
                    </select>
                </label>
                <label class="field-block field-block--full"><span>Lieu</span><input type="text" name="lieu" placeholder="Destination ou lieu du sejour" required></label>
                <label class="field-block field-block--full"><span>Description</span><textarea name="description" rows="5" placeholder="Ajoutez les details utiles de la reservation..."></textarea></label>
            </div>
            <div class="modal__actions">
                <a class="button button--outline-dark" href="{{ path('app_dashboard', {view: activeView|default('reservations')}) }}">Annuler</a>
                <button class="button button--primary" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</div>