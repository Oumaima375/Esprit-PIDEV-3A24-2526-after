{% extends 'base.html.twig' %}

{% block title %}After Travel - Accueil{% endblock %}

{% block body %}

<!-- Spinner -->
<div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<!-- Carousel -->
<div class="carousel-header">
    <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            <li data-bs-target="#carouselId" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#carouselId" data-bs-slide-to="1"></li>
            <li data-bs-target="#carouselId" data-bs-slide-to="2"></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="carousel-item active">
                <img src="{{ asset('img/carousel-1.jpg') }}" class="img-fluid" alt="Image">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4">Explorez Le Monde</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Vivez L'aventure Avec After Travel</h1>
                        <a class="btn btn-primary rounded-pill text-white py-3 px-5" href="{{ path('app_voyage') }}">Voir les Voyages</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('img/carousel-2.jpg') }}" class="img-fluid" alt="Image">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4">Destinations Uniques</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Trouvez Votre Voyage Parfait</h1>
                        <a class="btn btn-primary rounded-pill text-white py-3 px-5" href="{{ path('app_destination') }}">Voir Destinations</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('img/carousel-3.jpg') }}" class="img-fluid" alt="Image">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4">Vos Rêves</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Où Voulez-Vous Aller ?</h1>
                        <a class="btn btn-primary rounded-pill text-white py-3 px-5" href="{{ path('app_voyage_recommandations') }}">Recommandations</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon btn bg-primary"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon btn bg-primary"></span>
        </button>
    </div>
</div>

<!-- Voyages Récents -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5">
            <h5 class="section-title px-3">Nos Voyages</h5>
            <h1 class="mb-0">Voyages Récents</h1>
        </div>
        <div class="row g-4">
            {% for voyage in voyages %}
            <div class="col-lg-4 col-md-6">
                <div class="blog-item">
                    <div class="blog-img">
                        <div class="blog-img-inner">
                            {% if voyage.image %}
                                <img class="img-fluid w-100 rounded-top" src="{{ voyage.image }}" alt="{{ voyage.titre }}">
                            {% else %}
                                <img class="img-fluid w-100 rounded-top" src="{{ asset('img/blog-1.jpg') }}" alt="Image">
                            {% endif %}
                        </div>
                        <div class="blog-info d-flex align-items-center border border-start-0 border-end-0">
                            <small class="flex-fill text-center border-end py-2"><i class="fa fa-calendar-alt text-primary me-2"></i>{{ voyage.date_debut ? voyage.date_debut|date('d M Y') : 'N/A' }}</small>
                            <small class="flex-fill text-center border-end py-2"><i class="fa fa-tag text-primary me-2"></i>{{ voyage.prix }} TND</small>
                            <small class="flex-fill text-center py-2"><i class="fa fa-users text-primary me-2"></i>{{ voyage.nb_places }} places</small>
                        </div>
                    </div>
                    <div class="blog-content border border-top-0 rounded-bottom p-4">
                        <h4 class="mb-3">{{ voyage.titre }}</h4>
                        <p class="mb-3">{{ voyage.description|slice(0, 100) }}...</p>
                        <a href="{{ path('app_voyage') }}" class="btn btn-primary rounded-pill py-2 px-4">Voir Plus</a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center">
                <p>Aucun voyage disponible pour le moment.</p>
            </div>
            {% endfor %}
        </div>
        <div class="text-center mt-5">
            <a href="{{ path('app_voyage') }}" class="btn btn-primary rounded-pill py-3 px-5">Voir Tous les Voyages</a>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="container-fluid footer py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">After Travel</h4>
                <p class="text-white">Votre plateforme de voyage tout-en-un. Découvrez, planifiez et vivez des aventures inoubliables.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Liens Rapides</h4>
                <div class="d-flex flex-column">
                    <a href="{{ path('app_home') }}" class="text-white mb-2">Home</a>
                    <a href="{{ path('app_voyage') }}" class="text-white mb-2">Voyages</a>
                    <a href="{{ path('app_destination') }}" class="text-white mb-2">Destinations</a>
                    <a href="{{ path('app_about') }}" class="text-white mb-2">About</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <h4 class="mb-4 text-white">Contact</h4>
                <a class="text-white mb-2 d-block"><i class="fas fa-envelope me-2"></i>contact@aftertravel.com</a>
                <a class="text-white mb-2 d-block"><i class="fas fa-phone me-2"></i>+216 XX XXX XXX</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid copyright text-body py-4">
    <div class="container text-center">
        <i class="fas fa-copyright me-2"></i><span class="text-white">After Travel</span>, All rights reserved.
    </div>
</div>

{% endblock %}