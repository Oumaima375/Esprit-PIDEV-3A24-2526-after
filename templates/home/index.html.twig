{% extends 'base.html.twig' %}

{% block title %}After Travel - Accueil{% endblock %}

{% block hero %}
<div class="carousel-header">
    <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            <li data-bs-target="#carouselId" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#carouselId" data-bs-slide-to="1"></li>
            <li data-bs-target="#carouselId" data-bs-slide-to="2"></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="carousel-item active">
                <img src="{{ asset('img/carousel-2.jpg') }}" class="img-fluid" alt="Voyage">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">Gérez Vos Dépenses</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Voyagez Sans Souci !</h1>
                        <p class="mb-5 fs-5">Suivez toutes vos dépenses de voyage en temps réel. Gérez votre budget, convertissez les devises et générez des rapports complets.</p>
                        <div class="d-flex align-items-center justify-content-center gap-3">
                            <a class="btn-hover-bg btn btn-primary rounded-pill text-white py-3 px-5" href="{{ path('depense_new') }}">
                                <i class="fa fa-plus me-2"></i>Ajouter une Dépense
                            </a>
                            <a class="btn btn-outline-light rounded-pill py-3 px-5" href="{{ path('rapport_index') }}">
                                <i class="fa fa-chart-pie me-2"></i>Voir les Rapports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('img/carousel-1.jpg') }}" class="img-fluid" alt="Voyage">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">Contrôle Total</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Votre Budget, Votre Aventure</h1>
                        <p class="mb-5 fs-5">Définissez des budgets par catégorie et recevez des alertes avant de dépasser vos limites.</p>
                        {# Lien supprimé car les catégories sont maintenant dans l'administration (accessible via /admin/categorie) #}
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('img/carousel-3.jpg') }}" class="img-fluid" alt="Voyage">
                <div class="carousel-caption">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">Rapports Détaillés</h4>
                        <h1 class="display-2 text-capitalize text-white mb-4">Analysez Vos Dépenses</h1>
                        <p class="mb-5 fs-5">Graphiques, statistiques et exports PDF pour mieux comprendre vos habitudes de dépenses.</p>
                        <a class="btn-hover-bg btn btn-primary rounded-pill text-white py-3 px-5" href="{{ path('rapport_index') }}">
                            <i class="fa fa-file-pdf me-2"></i>Générer un Rapport
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon btn bg-primary" aria-hidden="false"></span>
            <span class="visually-hidden">Précédent</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon btn bg-primary" aria-hidden="false"></span>
            <span class="visually-hidden">Suivant</span>
        </button>
    </div>
</div>
<div class="container-fluid search-bar position-relative" style="top: -50%; transform: translateY(-50%);">
    <div class="container">
        <div class="position-relative rounded-pill w-100 mx-auto p-5" style="background: rgba(19, 53, 123, 0.8);">
            <form action="{{ path('depense_index') }}" method="GET">
                <input class="form-control border-0 rounded-pill w-100 py-3 ps-4 pe-5" type="text" name="search" placeholder="Rechercher une dépense...">
                <button type="submit" class="btn btn-primary rounded-pill py-2 px-4 position-absolute me-2" style="top: 50%; right: 46px; transform: translateY(-50%);">
                    <i class="fa fa-search me-1"></i>Rechercher
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}

<!-- Stats Start -->
<div class="container-fluid bg-light py-5">
    <div class="container py-3">
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="bg-white rounded p-4 shadow-sm">
                    <i class="fa fa-wallet fa-3x text-primary mb-3"></i>
                    <h2 class="text-primary fw-bold">{{ totalDepenses }}</h2>
                    <p class="mb-0 text-muted">Total Dépenses (TND)</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white rounded p-4 shadow-sm">
                    <i class="fa fa-list fa-3x text-primary mb-3"></i>
                    <h2 class="text-primary fw-bold">{{ nbDepenses }}</h2>
                    <p class="mb-0 text-muted">Nombre de Dépenses</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white rounded p-4 shadow-sm">
                    <i class="fa fa-tags fa-3x text-primary mb-3"></i>
                    <h2 class="text-primary fw-bold">{{ nbCategories }}</h2>
                    <p class="mb-0 text-muted">Catégories</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white rounded p-4 shadow-sm">
                    <i class="fa fa-calendar fa-3x text-primary mb-3"></i>
                    <h2 class="text-primary fw-bold">{{ depensesMois }}</h2>
                    <p class="mb-0 text-muted">Dépenses ce Mois (TND)</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Stats End -->

<!-- About Start -->
<div class="container-fluid about py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <div class="h-100" style="border: 50px solid; border-color: transparent #13357B transparent #13357B;">
                    <img src="{{ asset('img/about-img.jpg') }}" class="img-fluid w-100 h-100" alt="About">
                </div>
            </div>
            <div class="col-lg-7" style="background: linear-gradient(rgba(255,255,255,.8), rgba(255,255,255,.8)), url({{ asset('img/about-img-1.png') }});">
                <h5 class="section-about-title pe-3">À Propos</h5>
                <h1 class="mb-4">Bienvenue sur <span class="text-primary">After Travel</span></h1>
                <p class="mb-4">After Travel est votre application de gestion de dépenses de voyage. Suivez chaque centime dépensé, organisez par catégorie et restez dans votre budget lors de vos aventures.</p>
                <p class="mb-4">Développée avec Symfony et le template Travela, cette application vous offre une interface moderne et intuitive pour gérer vos finances de voyage.</p>
                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Gestion des dépenses</p></div>
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Catégories personnalisées</p></div>
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Conversion EUR/USD/TND</p></div>
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Rapports mensuels PDF</p></div>
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Vérification de budget</p></div>
                    <div class="col-sm-6"><p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Graphiques interactifs</p></div>
                </div>
                <a class="btn btn-primary rounded-pill py-3 px-5 mt-2" href="{{ path('depense_index') }}">
                    <i class="fa fa-arrow-right me-2"></i>Commencer
                </a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->

<!-- Services Start -->
<div class="container-fluid bg-light service py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Fonctionnalités</h5>
            <h1 class="mb-0">Nos Services</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Gestion des Dépenses</h5>
                                <p class="mb-0">Ajoutez, modifiez et supprimez vos dépenses facilement. Triez par date, montant ou catégorie pour une vision claire de vos finances.</p>
                            </div>
                            <div class="service-icon p-4"><i class="fa fa-wallet fa-4x text-primary"></i></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Conversion de Devises</h5>
                                <p class="mb-0">Saisissez vos dépenses en EUR, USD ou TND. La conversion automatique vous évite les calculs fastidieux lors de vos voyages.</p>
                            </div>
                            <div class="service-icon p-4"><i class="fa fa-exchange-alt fa-4x text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4"><i class="fa fa-chart-pie fa-4x text-primary"></i></div>
                            <div class="service-content">
                                <h5 class="mb-4">Rapports & Statistiques</h5>
                                <p class="mb-0">Générez des rapports mensuels détaillés avec graphiques camembert. Exportez en PDF pour garder une trace de vos finances.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4"><i class="fa fa-tags fa-4x text-primary"></i></div>
                            <div class="service-content">
                                <h5 class="mb-4">Catégories & Budget</h5>
                                <p class="mb-0">Organisez vos dépenses par catégorie et définissez des budgets maximum. Recevez des alertes avant de dépasser vos limites.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Services End -->

<!-- Recent Expenses Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Récentes</h5>
            <h1 class="mb-0">Dernières Dépenses</h1>
        </div>
        <div class="row g-4">
            {% for depense in dernierDepenses %}
            <div class="col-md-4">
                <div class="blog-item rounded">
                    <div class="blog-img">
                        <div class="blog-img-inner" style="background: linear-gradient(135deg, #13357B, #1a4fa0); height: 200px; border-radius: 10px 10px 0 0; display:flex; align-items:center; justify-content:center;">
                            <i class="fa fa-receipt fa-4x text-white opacity-50"></i>
                            <div class="blog-icon">
                                <a href="{{ path('depense_show', {id: depense.id}) }}" class="my-auto">
                                    <i class="fas fa-eye fa-2x text-white"></i>
                                </a>
                            </div>
                        </div>
                        <div class="blog-info d-flex align-items-center border border-start-0 border-end-0">
                            <small class="flex-fill text-center border-end py-2">
                                <i class="fa fa-calendar-alt text-primary me-2"></i>{{ depense.dateDepense|date('d/m/Y') }}
                            </small>
                            <small class="flex-fill text-center border-end py-2 text-white">
                                <i class="fa fa-tags text-primary me-2"></i>{{ depense.categorie ? depense.categorie.nomCategorie : 'N/A' }}
                            </small>
                            <small class="flex-fill text-center py-2 text-white fw-bold">
                                <i class="fa fa-money-bill text-primary me-2"></i>{{ depense.montant|number_format(2) }} DT
                            </small>
                        </div>
                    </div>
                    <div class="blog-content border border-top-0 rounded-bottom p-4">
                        <a href="{{ path('depense_show', {id: depense.id}) }}" class="h5">{{ depense.titre }}</a>
                        <div class="mt-3 d-flex gap-2">
                            <a href="{{ path('depense_edit', {id: depense.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">
                                <i class="fa fa-edit me-1"></i>Modifier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center py-5">
                <i class="fa fa-inbox fa-4x text-muted mb-3"></i>
                <p class="text-muted">Aucune dépense enregistrée.</p>
                <a href="{{ path('depense_new') }}" class="btn btn-primary rounded-pill">
                    <i class="fa fa-plus me-2"></i>Ajouter une dépense
                </a>
            </div>
            {% endfor %}
        </div>
        {% if dernierDepenses|length > 0 %}
        <div class="text-center mt-5">
            <a href="{{ path('depense_index') }}" class="btn btn-primary rounded-pill py-3 px-5">
                <i class="fa fa-list me-2"></i>Voir toutes les dépenses
            </a>
        </div>
        {% endif %}
    </div>
</div>
<!-- Recent Expenses End -->

{% endblock %}