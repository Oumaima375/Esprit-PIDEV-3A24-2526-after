<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — After Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-login.css') }}">
    <style>
        .auth-flash {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-weight: 600;
            font-size: 13.5px;
            border: 1px solid transparent;
            line-height: 1.5;
        }
        .auth-flash.error { background: #fef2f2; color: #991b1b; border-color: #fecaca; }
        .auth-flash.success { background: #f0fdf4; color: #166534; border-color: #bbf7d0; }
        .auth-flash.info, .auth-flash.notice { background: #eff6ff; color: #1e40af; border-color: #bfdbfe; }
        .photo-upload-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
        .photo-label-text { font-size: 13px; color: #6b7280; }
    </style>
</head>
<body class="auth-page">

    <div class="auth-form-container">

        <div class="auth-form-wrapper">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="auth-flash {{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% if error is defined and error %}
                <div class="auth-flash error" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="form-header">
                <h1>Connexion</h1>
                <p>Accédez à votre espace After Travel</p>
            </div>

            <div class="auth-tabs">
                <button type="button" class="auth-tab active" data-form="login">Connexion</button>
                <button type="button" class="auth-tab" data-form="register">Inscription</button>
            </div>

            <form id="loginForm" class="auth-form active" method="post" action="{{ path('app_login') }}" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group" data-field-wrap>
                    <label class="form-label" for="inputUsername">Email</label>
                    <div class="form-input-wrapper">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        <input class="form-input" type="email" name="_username" id="inputUsername"
                               value="{{ last_username|default('') }}"
                               placeholder="vous@exemple.com"
                               autocomplete="username" required>
                    </div>
                </div>

                <div class="form-group" data-field-wrap>
                    <label class="form-label" for="loginPassword">Mot de passe</label>
                    <div class="form-input-wrapper">
                        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <input class="form-input" type="password" name="_password" id="loginPassword"
                               placeholder="••••••••" autocomplete="current-password" required>
                        <button type="button" class="password-toggle" data-target="loginPassword"
                                tabindex="-1" aria-label="Afficher le mot de passe">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <a href="{{ path('app_forgot_password_request') }}" class="forgot-password">Mot de passe oublié ?</a>
                </div>

                <button type="submit" class="btn primary btn-full">Se connecter</button>

                <div class="divider">
                    <span class="divider-line"></span>
                    <span class="divider-text">ou avec</span>
                    <span class="divider-line"></span>
                </div>

                <div class="social-buttons">
                    <button type="button" class="social-btn" title="Connexion Google (bientôt disponible)" aria-disabled="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Google
                    </button>
                    <button type="button" class="social-btn" title="Connexion Apple (bientôt disponible)" aria-disabled="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                        </svg>
                        Apple
                    </button>
                </div>

                <div class="auth-switch">
                    <p>Pas encore de compte ? <a href="#" id="switchToRegister">S’inscrire</a></p>
                </div>
            </form>

            <form id="registerForm" class="auth-form" method="post"
                  action="{{ path('app_register') }}" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Prénom *</label>
                    <div class="form-input-wrapper">
                        <input class="form-input" type="text" name="register_prenom"
                               placeholder="Prénom" autocomplete="given-name" required>
                    </div>
                </div>

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Nom *</label>
                    <div class="form-input-wrapper">
                        <input class="form-input" type="text" name="register_nom"
                               placeholder="Nom" autocomplete="family-name" required>
                    </div>
                </div>

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Email *</label>
                    <div class="form-input-wrapper">
                        <input class="form-input" type="email" name="register_email"
                               placeholder="email@exemple.com" autocomplete="email" required>
                    </div>
                </div>

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Mot de passe *</label>
                    <div class="form-input-wrapper">
                        <input class="form-input" type="password" name="register_password"
                               id="registerPassword" placeholder="Au moins 8 caractères"
                               autocomplete="new-password" required>
                        <button type="button" class="password-toggle" data-target="registerPassword"
                                tabindex="-1" aria-label="Afficher le mot de passe">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Téléphone <span style="opacity:.65;font-weight:500">(optionnel)</span></label>
                    <div class="form-input-wrapper">
                        <input class="form-input" type="tel" name="register_telephone"
                               placeholder="+33 6 00 00 00 00" autocomplete="tel">
                    </div>
                </div>

                <p class="account-type-info">
                    Inscription en tant que <strong>voyageur</strong> : vous pourrez vous connecter tout de suite après la création du compte.
                </p>

                <div class="form-group" data-field-wrap>
                    <label class="form-label">Photo de profil <span style="opacity:.65;font-weight:500">(optionnel)</span></label>
                    <div class="photo-upload-row">
                        <button type="button" class="btn secondary"
                                style="padding:8px 14px;font-size:13px;"
                                onclick="document.getElementById('profilePhoto').click()">
                            Choisir un fichier
                        </button>
                        <span id="photoLabel" class="photo-label-text">Aucune photo sélectionnée</span>
                        <input type="file" name="register_photo" id="profilePhoto"
                               accept="image/jpeg,image/png,image/webp,image/gif"
                               style="display:none;"
                               onchange="document.getElementById('photoLabel').textContent = this.files[0] ? this.files[0].name : 'Aucune photo sélectionnée'">
                    </div>
                </div>

                <button type="submit" class="btn primary btn-full">Créer mon compte</button>

                <div class="auth-switch">
                    <p>Déjà inscrit ? <a href="#" id="switchToLogin">Se connecter</a></p>
                </div>
            </form>

        </div>

        <p class="copyright">© 2026 After Travel · Gabarit <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a></p>
    </div>

    <script src="{{ asset('js/form-validation.js') }}"></script>
    <script src="{{ asset('js/templatemo-crypto-script.js') }}"></script>
</body>
</html>
