{% extends 'base.html.twig' %}

{% block title %}Nos Activités - After Travel{% endblock %}

{% block hero %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3 fw-bold">
                <i class="fa fa-running me-2"></i>Nos Activités
            </h1>
            <p class="text-white fs-5">Explorez nos activités et créez des souvenirs uniques</p>
            <ol class="breadcrumb justify-content-center mb-0 mt-3">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active text-white">Activités</li>
            </ol>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}

<!-- MODAL DESCRIPTION -->
<div class="modal fade" id="activiteModal" tabindex="-1" aria-labelledby="activiteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span id="modal-categorie" class="badge bg-primary mb-1"></span>
                    <h4 class="modal-title fw-bold" id="activiteModalLabel"></h4>
                    <p class="text-muted mb-0">
                        <i class="fa fa-map-marker-alt text-primary me-1"></i>
                        <span id="modal-lieu"></span>
                    </p>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="p-3 bg-light rounded mb-3">
                    <p class="mb-1 fw-semibold text-muted small">📝 Description</p>
                    <p class="mb-0" id="modal-description" style="line-height: 1.8;"></p>
                </div>
                <div>
                    <small class="text-muted fw-semibold">🌍 Traduire la description en :</small>
                    <div class="d-flex gap-2 flex-wrap mt-2">
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="en">🇬🇧 Anglais</button>
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="de">🇩🇪 Allemand</button>
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="ar">🇸🇦 Arabe</button>
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="es">🇪🇸 Espagnol</button>
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="zh">🇨🇳 Chinois</button>
                        <button class="btn btn-sm btn-outline-secondary modal-btn-translate" data-lang="fr">🇫🇷 Français</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CALENDRIER -->
<div class="modal fade" id="calendarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">📅 <span id="cal-titre"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <div class="d-flex gap-3 mb-3">
                    <span><span style="background:#3b82f6;color:white;padding:2px 10px;border-radius:20px;">●</span> Disponible</span>
                    <span><span style="background:#ef4444;color:white;padding:2px 10px;border-radius:20px;">●</span> Réservé</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button id="cal-prev" class="btn btn-sm btn-outline-secondary rounded-pill px-3">← Préc</button>
                    <strong id="cal-month-label" style="font-size:1rem;"></strong>
                    <button id="cal-next" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Suiv →</button>
                </div>
                <div style="display:grid; grid-template-columns: repeat(7,1fr); gap:4px; margin-bottom:4px;">
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Lun</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Mar</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Mer</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Jeu</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Ven</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Sam</div>
                    <div style="text-align:center;font-size:0.75rem;font-weight:600;color:#888;">Dim</div>
                </div>
                <div id="cal-grid" style="display:grid; grid-template-columns: repeat(7,1fr); gap:4px;"></div>
                <div id="no-dates-msg" style="display:none;" class="alert alert-warning mt-3">
                    ⚠️ Aucun planning pour cette activité.
                </div>
                <div id="reservation-form" style="display:none;" class="mt-3">
                    <hr>
                    <h6 class="fw-bold mb-3">✍️ Réserver le <span id="selected-date-label" class="text-primary"></span></h6>
                    <div class="mb-2">
                        <input type="text" id="res-nom" class="form-control" placeholder="Nom">
                    </div>
                    <div class="mb-2">
                        <input type="text" id="res-prenom" class="form-control" placeholder="Prénom">
                    </div>
                    <div class="mb-3">
                        <input type="email" id="res-email" class="form-control" placeholder="Email">
                    </div>
                    <button id="btn-confirmer" class="btn btn-success rounded-pill px-4">✅ Confirmer</button>
                    <button class="btn btn-outline-secondary rounded-pill px-4 ms-2"
                            onclick="document.getElementById('reservation-form').style.display='none'">Annuler</button>
                </div>
                <div id="reservation-success" style="display:none;" class="alert alert-success mt-3">
                    🎉 Réservation confirmée ! Le modal va se fermer...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Activités Start -->
<div class="container-fluid blog py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Nos Activités</h5>
            <h1 class="mb-4">Liste des Activités</h1>
        </div>

        <div class="d-flex justify-content-center gap-3 mb-4">
            <select id="sort" class="form-select rounded-pill px-4 py-2" style="max-width: 250px;">
                <option value="">-- Trier par --</option>
                <option value="nom">🔤 Nom</option>
                <option value="prix">💰 Prix</option>
                <option value="categorie">🏷️ Catégorie</option>
                <option value="lieu">📍 Lieu</option>
            </select>
        </div>

        <div class="mb-4" style="max-width: 500px; margin: 0 auto 2rem auto;">
            <input type="text" id="search" class="form-control rounded-pill px-4 py-2"
                   placeholder="🔍 Rechercher une activité...">
        </div>

        <div class="row g-4 justify-content-center">
            <div id="activite-tbody-all" style="display: contents;">
                {% for activite in activites %}
                    <div class="col-lg-4 col-md-6">
                        <div class="blog-item activite-card"
                             data-id="{{ activite.idActivite }}"
                             data-nom="{{ activite.nom }}"
                             data-categorie="{{ activite.categorie ?? '' }}"
                             data-lieu="{{ activite.lieu ?? '' }}"
                             data-description="{{ activite.description ?? '' }}">

                            {# ══ IMAGE + INDICATEUR ══ #}
                            <div style="position:relative;">
                                {% if activite.image %}
                                    <img src="{{ asset('uploads/activites/' ~ activite.image) }}"
                                         alt="{{ activite.nom }}"
                                         style="width:100%; height:200px; object-fit:cover; border-radius:12px 12px 0 0;">
                                {% else %}
                                    <img src="{{ asset('img/blog-1.jpg') }}"
                                         alt="Image par défaut"
                                         style="width:100%; height:200px; object-fit:cover; border-radius:12px 12px 0 0;">
                                {% endif %}
                                <span class="disponibilite-indicator"
                                      data-id="{{ activite.idActivite }}"
                                      style="position:absolute; top:10px; right:10px;
                                             width:16px; height:16px; border-radius:50%;
                                             background:#ccc; border:2px solid white; display:inline-block;"
                                      title="Chargement..."></span>
                            </div>

                            <div class="blog-content border rounded p-4 h-100 transition-card">

                                {% if activite.categorie %}
                                    <span class="badge bg-primary mb-2">{{ activite.categorie }}</span>
                                {% endif %}

                                <h4 class="mb-2">{{ activite.nom }}</h4>

                                {% if activite.lieu %}
                                    <p class="mb-2">
                                        <i class="fa fa-map-marker-alt text-primary me-2"></i>
                                        {{ activite.lieu }}
                                    </p>
                                {% endif %}

                                {% if activite.prix %}
                                    <p class="mb-1">
                                        <i class="fa fa-tag text-primary me-2"></i>
                                        <strong id="prix-{{ activite.idActivite }}">{{ activite.prix }} TND</strong>
                                    </p>
                                    <div class="zone-interactive mb-3">
                                        <small class="text-muted">💱 Convertir en :</small>
                                        <div class="d-flex gap-1 flex-wrap mt-1">
                                            <button class="btn btn-xs btn-outline-primary btn-convert" data-id="{{ activite.idActivite }}" data-prix="{{ activite.prix }}" data-devise="EUR">💶 EUR</button>
                                            <button class="btn btn-xs btn-outline-primary btn-convert" data-id="{{ activite.idActivite }}" data-prix="{{ activite.prix }}" data-devise="USD">💵 USD</button>
                                            <button class="btn btn-xs btn-outline-primary btn-convert" data-id="{{ activite.idActivite }}" data-prix="{{ activite.prix }}" data-devise="GBP">💷 GBP</button>
                                            <button class="btn btn-xs btn-outline-primary btn-convert" data-id="{{ activite.idActivite }}" data-prix="{{ activite.prix }}" data-devise="TND">🔄 TND</button>
                                        </div>
                                    </div>
                                {% endif %}

                                <p class="text-muted small mb-3">
                                    <i class="fa fa-info-circle me-1"></i>Cliquez pour voir la description
                                </p>

                                <div class="zone-interactive d-flex align-items-center gap-2 mb-3">
                                    <small class="text-muted">Partager :</small>
                                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ (app.request.schemeAndHttpHost ~ path('app_activite'))|url_encode }}&quote={{ (activite.nom ~ ' - ' ~ activite.lieu ~ ' - ' ~ activite.prix ~ ' TND')|url_encode }}" target="_blank" class="btn-social btn-facebook"><i class="fab fa-facebook-f"></i></a>
                                    <a href="https://www.instagram.com/" target="_blank" class="btn-social btn-instagram"><i class="fab fa-instagram"></i></a>
                                    <a href="https://api.whatsapp.com/send?text={{ ('🏃 ' ~ activite.nom ~ ' 📍 ' ~ activite.lieu ~ ' 💰 ' ~ activite.prix ~ ' TND - After Travel!')|url_encode }}" target="_blank" class="btn-social btn-whatsapp"><i class="fab fa-whatsapp"></i></a>
                                </div>

                                <div class="zone-interactive d-flex gap-2 flex-wrap align-items-center">
                                    <a href="{{ path('app_activite_pdf', {'id': activite.idActivite}) }}" class="btn btn-sm btn-success" target="_blank">
                                        <i class="fa fa-file-pdf"></i> PDF
                                    </a>
                                    <a href="{{ path('app_avis_liste', {id: activite.idActivite}) }}" class="btn btn-outline-info rounded-pill btn-sm">
                                        💬 Voir les avis
                                        {% if activite.avis|length > 0 %}
                                            <span class="badge bg-info ms-1">{{ activite.avis|length }}</span>
                                        {% endif %}
                                    </a>
                                    <button class="btn btn-outline-primary rounded-pill btn-sm btn-calendar"
                                            data-id="{{ activite.idActivite }}"
                                            data-nom="{{ activite.nom }}">
                                        📅 Réserver
                                    </button>
                                </div>

                                {# ══ INFO RÉSERVATION ══ #}
                                <div class="reservation-info-{{ activite.idActivite }} mt-3" style="display:none;">
                                    <div class="p-2 rounded" style="background:#fff3f3; border-left:3px solid #ef4444;">
                                        <small class="fw-bold text-danger d-block mb-1">🔴 Réservée</small>
                                        <small class="text-muted reservation-detail-{{ activite.idActivite }}"></small>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <p>Aucune activité disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
            <div id="activite-tbody-search" class="row g-4 justify-content-center"></div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
.btn-xs { padding: 2px 8px; font-size: 0.75rem; border-radius: 20px; }
.transition-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
.activite-card:hover .transition-card { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,0.12) !important; }
.activite-card { cursor: pointer; }
.btn-reaction { display: inline-flex; align-items: center; gap: 5px; background: #f8f9fa; border: 1.5px solid #dee2e6; border-radius: 20px; padding: 4px 14px; font-size: 1rem; cursor: pointer; transition: all 0.2s ease; color: #555; outline: none; }
.btn-reaction:hover { border-color: #adb5bd; background: #e9ecef; }
.btn-like.active { background: #d4edda; border-color: #28a745; color: #28a745; font-weight: 700; }
.btn-dislike.active { background: #f8d7da; border-color: #dc3545; color: #dc3545; font-weight: 700; }
.reaction-count { font-size: 0.85rem; font-weight: 600; min-width: 18px; text-align: center; }
.btn-social { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; font-size: 0.85rem; color: #fff !important; text-decoration: none; transition: transform 0.2s; }
.btn-social:hover { transform: scale(1.18); }
.btn-facebook { background: #1877F2; }
.btn-instagram { background: linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); }
.btn-whatsapp { background: #25D366; }
#cal-grid div { min-height: 36px; display: flex; align-items: center; justify-content: center; }
</style>

{% include '_footer.html.twig' ignore missing %}
{% endblock %}