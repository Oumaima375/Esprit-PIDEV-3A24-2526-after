<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}After Travel{% endblock %}</title>

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&family=Roboto&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

        <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/style.css') }}" rel="stylesheet">

        <style>
            /* ── Profile chip ── */
            .nav-profile-chip {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 5px 14px 5px 6px;
                border-radius: 50px;
                border: 1.5px solid rgba(255,255,255,0.25);
                background: rgba(255,255,255,0.10);
                color: #fff;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
                white-space: nowrap;
            }

            .nav-profile-avatar,
            .nav-profile-initials {
                width: 30px;
                height: 30px;
                border-radius: 50%;
            }

            .nav-profile-initials {
                background: linear-gradient(135deg, #3b5bdb, #74c0fc);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: #fff;
                border: 2px solid rgba(255,255,255,0.5);
            }

            .navbar .dropdown-menu {
                border-radius: 12px;
                border: none;
                box-shadow: 0 8px 32px rgba(26,43,94,0.14);
                padding: 6px;
            }

            .navbar .dropdown-item {
                border-radius: 8px;
                padding: 8px 14px;
            }

            /* Flash messages (from other branch) */
            .flash-stack {
                position: fixed;
                top: 18px;
                right: 18px;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                gap: 12px;
                width: min(420px, calc(100vw - 32px));
            }

            .flash-message {
                border-radius: 18px;
                padding: 14px 16px;
                font-weight: 700;
                border: 1px solid #dbe5ef;
                background: #fff;
            }

            .flash-message--success { background:#ecfdf3; border-color:#86efac; color:#166534; }
            .flash-message--error { background:#fef2f2; border-color:#fca5a5; color:#991b1b; }
            .flash-message--warning { background:#fff7ed; border-color:#fdba74; color:#9a3412; }
            .flash-message--info { background:#eff6ff; border-color:#93c5fd; color:#1d4ed8; }
        </style>
    {% endblock %}
</head>

<body>

{# FLASH MESSAGES #}
{% set flashSuccess = app.flashes('success') %}
{% set flashError = app.flashes('error') %}
{% set flashWarning = app.flashes('warning') %}
{% set flashInfo = app.flashes('info') %}

{% if flashSuccess or flashError or flashWarning or flashInfo %}
    <div class="flash-stack">
        {% for message in flashSuccess %}
            <div class="flash-message flash-message--success">{{ message }}</div>
        {% endfor %}
        {% for message in flashError %}
            <div class="flash-message flash-message--error">{{ message }}</div>
        {% endfor %}
        {% for message in flashWarning %}
            <div class="flash-message flash-message--warning">{{ message }}</div>
        {% endfor %}
        {% for message in flashInfo %}
            <div class="flash-message flash-message--info">{{ message }}</div>
        {% endfor %}
    </div>
{% endif %}

<!-- NAVBAR (KEPT FROM YOUR VERSION) -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">

        <a href="{{ path('app_home') }}" class="navbar-brand p-0">
            <h1 class="m-0"><i class="fa fa-map-marker-alt me-3"></i>After Travel</h1>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">

            <div class="navbar-nav ms-auto py-0 align-items-lg-center">

                <a href="{{ path('app_home') }}" class="nav-item nav-link">Accueil</a>

                {# ── Voyage dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="{{ path('app_voyage') }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Voyage
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_voyage') }}">
                            <i class="fa fa-plane me-2 text-primary"></i>Tous les Voyages
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_destination') }}">
                            <i class="fa fa-map-marker-alt me-2 text-primary"></i>Destinations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_voyage_recommandations') }}">
                            <i class="fa fa-star me-2 text-primary"></i>Recommandations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_voyage_favoris') }}">
                            <i class="fa fa-heart me-2 text-primary"></i>Mes Favoris
                        </a></li>
                    </ul>
                </div>

                {# ── Réservation & Paiement dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Réservation
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-calendar-check me-1"></i> Réservations</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'reservations'}) }}">
                            <i class="fa fa-list me-2 text-primary"></i>Mes Réservations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'reservations', modal: 'reservation'}) }}">
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouvelle Réservation
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-credit-card me-1"></i> Paiements</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'payments'}) }}">
                            <i class="fa fa-wallet me-2 text-primary"></i>Mes Paiements
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'payments', modal: 'payment'}) }}">
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouveau Paiement
                        </a></li>
                    </ul>
                </div>

                <a href="#" class="nav-item nav-link">Activité</a>
                {# ── Document dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Document
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-file-alt me-1"></i> Documents</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_crud_index') }}">
                            <i class="fa fa-list me-2 text-primary"></i>Tous les Documents
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_crud_new') }}">
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouveau Document
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_stats') }}">
                            <i class="fa fa-chart-bar me-2 text-primary"></i>Statistiques
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-tags me-1"></i> Catégories</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_categorie_document_index') }}">
                            <i class="fa fa-folder me-2 text-primary"></i>Catégories
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_categorie_document_new') }}">
                            <i class="fa fa-folder-plus me-2 text-primary"></i>Nouvelle Catégorie
                        </a></li>
                    </ul>
                </div>
                <a href="#" class="nav-item nav-link">Services</a>
                <a href="#" class="nav-item nav-link">Dépense</a>

                <a href="{{ path('app_about') }}" class="nav-item nav-link">About</a>

                {% if app.user %}
                    <div class="nav-item dropdown ms-lg-3">

                        <a class="nav-profile-chip dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <span class="nav-profile-initials">
                                {{ (app.user.prenom|first ~ app.user.nom|first)|upper }}
                            </span>
                            {{ app.user.prenom }} {{ app.user.nom }}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="fa fa-user"></i> Profil
                                </a>
                            </li>

                            {% if is_granted('ROLE_ADMIN') %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_admin_home') }}">
                                    <i class="fa fa-tachometer-alt me-1"></i> Dashboard Admin
                                </a>
                            </li>
                            {% endif %}

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('_logout_main') }}">
                                    Logout
                                </a>
                            </li>

                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-item nav-link">Connexion</a>
                {% endif %}

            </div>
        </div>
    </nav>
</div>

{% block body %}{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/main.js') }}"></script>

    <script>
        setTimeout(() => {
            document.querySelectorAll('.flash-message').forEach(el => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            });
        }, 3200);
    </script>
{% endblock %}

</body>
</html>