<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AFTER Travel{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('lib/animate/animate.min.css') }}">
    <link rel="stylesheet" href="{{ asset('lib/owlcarousel/assets/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {# ← CSS Mode sombre — directement ici, pas dans un block avec parent() #}
    <style>
    body.dark-mode {
        background: #0f172a !important;
        color: #e2e8f0 !important;
    }
    body.dark-mode .navbar {
        background: #1e293b !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4) !important;
    }
    body.dark-mode .navbar-brand h2,
    body.dark-mode .nav-link {
        color: #e2e8f0 !important;
    }
    body.dark-mode .card {
        background: #1e293b !important;
        color: #e2e8f0 !important;
        border-color: #334155 !important;
    }
    body.dark-mode .card-body,
    body.dark-mode .card-footer {
        background: #1e293b !important;
    }
    body.dark-mode .text-dark,
    body.dark-mode .text-muted {
        color: #cbd5e1 !important;
    }
    body.dark-mode .form-control,
    body.dark-mode .form-select,
    body.dark-mode .input-group-text {
        background: #1e293b !important;
        color: #e2e8f0 !important;
        border-color: #475569 !important;
    }
    body, .card, .navbar, .form-control, .form-select {
        transition: background 0.3s ease, color 0.3s ease;
    }
    @keyframes blink {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(1.05); }
    }
    .blink { animation: blink 1.2s ease-in-out infinite; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">
        <a href="/" class="navbar-brand d-flex align-items-center px-4 px-lg-5">
            <h2 class="m-0 text-primary">
                <i class="fa fa-map-marker-alt me-3"></i>AFTER Travel
            </h2>
        </a>
        <button class="navbar-toggler me-4" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0 d-flex align-items-center">
                <a href="{{ path('app_document_crud_index') }}" class="nav-item nav-link">Documents</a>
                {# ← Bouton mode sombre #}
                <button onclick="toggleDark()"
                        id="darkBtn"
                        style="background:none; border:2px solid #dee2e6; border-radius:50px; padding:6px 14px; cursor:pointer; font-size:14px; margin-left:10px;">
                    🌙
                </button>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <div class="container-fluid px-0">
        {% block body %}{% endblock %}
    </div>

    <!-- Footer -->
    <div class="container-fluid py-5" style="background: linear-gradient(135deg, #1a2744, #2563eb);">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-md-6">
                    <h4 class="text-white mb-3">AFTER Travel</h4>
                    <p class="text-white-50">Gestion complète de vos documents de voyage.</p>
                </div>
                <div class="col-md-6">
                    <h4 class="text-white mb-3">Liens rapides</h4>
                    <a class="btn btn-link text-white-50" href="{{ path('app_document_crud_index') }}">Documents</a>
                    <a class="btn btn-link text-white-50" href="{{ path('app_categorie_document_index') }}">Catégories</a>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="text-white-50 mb-0">© 2026 AFTER Travel - Gestion Documents Voyage</p>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('js/jquery-3.4.1.min.js') }}"></script>
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
    <script src="{{ asset('js/main.js') }}"></script>

    {# ← JavaScript mode sombre + notifications — directement ici #}
    <script>
    // ===== MODE SOMBRE =====
    function toggleDark() {
        const isDark = document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', isDark ? '1' : '0');
        document.getElementById('darkBtn').textContent = isDark ? '☀️' : '🌙';
    }

    // Restore au chargement
    document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark-mode');
            const btn = document.getElementById('darkBtn');
            if (btn) btn.textContent = '☀️';
        }
    });

    // ===== NOTIFICATIONS PUSH =====
    async function demanderPermissionNotifications() {
        if (!('Notification' in window)) return;
        if (Notification.permission === 'default') {
            await Notification.requestPermission();
        }
        if (Notification.permission === 'granted') {
            verifierExpirations();
        }
    }

    async function verifierExpirations() {
        try {
            const response = await fetch('/document/crud/notifications/check');
            const data     = await response.json();

            if (data.count > 0) {
                new Notification('⚠️ AFTER Travel — Documents expirant bientôt', {
                    body: `${data.count} document(s) expirent dans moins de 30 jours !`,
                    icon: '/favicon.ico',
                    tag: 'expiration-alerte'
                });

                data.documents.forEach(doc => {
                    if (doc.joursRestants <= 7) {
                        setTimeout(() => {
                            new Notification(`🔴 Urgent : ${doc.nom}`, {
                                body: `Expire le ${doc.dateExpiration} (${doc.joursRestants} jour(s) restants !)`,
                                icon: '/favicon.ico',
                                tag: `doc-${doc.nom}`
                            });
                        }, 2000);
                    }
                });
            }
        } catch (e) {
            console.log('Notifications check failed:', e);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(demanderPermissionNotifications, 3000);
        setInterval(verifierExpirations, 3600000);
    });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>