<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}After Travel{% endblock %}</title>

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&family=Roboto&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

        <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/style.css') }}" rel="stylesheet">

        <style>
            /* ── Profile chip ── */
            .nav-profile-chip {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 5px 14px 5px 6px;
                border-radius: 50px;
                border: 1.5px solid rgba(255,255,255,0.25);
                background: rgba(255,255,255,0.10);
                color: #fff;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
                white-space: nowrap;
            }

            .nav-profile-avatar,
            .nav-profile-initials {
                width: 30px;
                height: 30px;
                border-radius: 50%;
            }

            .nav-profile-initials {
                background: linear-gradient(135deg, #3b5bdb, #74c0fc);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: #fff;
                border: 2px solid rgba(255,255,255,0.5);
            }

            .navbar .dropdown-menu {
                border-radius: 12px;
                border: none;
                box-shadow: 0 8px 32px rgba(26,43,94,0.14);
                padding: 6px;
            }

            .navbar .dropdown-item {
                border-radius: 8px;
                padding: 8px 14px;
            }

            /* ── AI badge on dropdown item ── */
            .dropdown-item .badge-ai {
                font-size: 9px;
                padding: 2px 6px;
                border-radius: 20px;
                background: linear-gradient(135deg, #6366f1, #a855f7);
                color: #fff;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-align: middle;
                margin-left: 4px;
            }

            /* Flash messages */
            .flash-stack {
                position: fixed;
                top: 18px;
                right: 18px;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                gap: 12px;
                width: min(420px, calc(100vw - 32px));
            }

            .flash-message {
                border-radius: 18px;
                padding: 14px 16px;
                font-weight: 700;
                border: 1px solid #dbe5ef;
                background: #fff;
            }

            /* Auth toast */
            #auth-toast {
                position: fixed;
                bottom: 32px;
                left: 50%;
                transform: translateX(-50%) translateY(20px);
                z-index: 9999;
                opacity: 0;
                transition: opacity 0.25s ease, transform 0.25s ease;
                pointer-events: none;
                min-width: 340px;
                max-width: 90vw;
            }
            #auth-toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
                pointer-events: auto;
            }
            #auth-toast .auth-toast-inner {
                background: #1a1a2e;
                color: #fff;
                border-radius: 16px;
                padding: 18px 22px;
                box-shadow: 0 8px 40px rgba(0,0,0,0.28);
                display: flex;
                align-items: center;
                gap: 16px;
            }
            #auth-toast .auth-toast-icon {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: linear-gradient(135deg, #3b5bdb, #74c0fc);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 18px;
            }
            #auth-toast .auth-toast-text {
                flex: 1;
            }
            #auth-toast .auth-toast-text strong {
                display: block;
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 2px;
            }
            #auth-toast .auth-toast-text span {
                font-size: 12.5px;
                opacity: 0.75;
            }
            #auth-toast .auth-toast-actions {
                display: flex;
                gap: 8px;
                flex-shrink: 0;
            }
            #auth-toast .btn-toast-login {
                background: linear-gradient(135deg, #3b5bdb, #4dabf7);
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 8px 16px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                white-space: nowrap;
                text-decoration: none;
            }
            #auth-toast .btn-toast-register {
                background: rgba(255,255,255,0.12);
                color: #fff;
                border: 1.5px solid rgba(255,255,255,0.2);
                border-radius: 10px;
                padding: 8px 16px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                white-space: nowrap;
                text-decoration: none;
            }
            #auth-toast .btn-toast-close {
                background: none;
                border: none;
                color: rgba(255,255,255,0.5);
                font-size: 18px;
                cursor: pointer;
                padding: 0 0 0 4px;
                line-height: 1;
            }
            /* Greyed restricted items for guests */
            .nav-restricted {
                opacity: 0.45 !important;
                cursor: not-allowed !important;
            }
            .nav-restricted:hover {
                opacity: 0.6 !important;
            }
        </style>
    {% endblock %}
</head>

<body>

{# FLASH MESSAGES #}
{% set flashSuccess = app.flashes('success') %}
{% set flashError   = app.flashes('error') %}
{% set flashWarning = app.flashes('warning') %}
{% set flashInfo    = app.flashes('info') %}

{% if flashSuccess or flashError or flashWarning or flashInfo %}
    <div class="flash-stack">
        {% for message in flashSuccess %}
            <div class="flash-message flash-message--success">{{ message }}</div>
        {% endfor %}
        {% for message in flashError %}
            <div class="flash-message flash-message--error">{{ message }}</div>
        {% endfor %}
        {% for message in flashWarning %}
            <div class="flash-message flash-message--warning">{{ message }}</div>
        {% endfor %}
        {% for message in flashInfo %}
            <div class="flash-message flash-message--info">{{ message }}</div>
        {% endfor %}
    </div>
{% endif %}

<!-- NAVBAR -->
<div class="container-fluid position-relative p-0 sticky-top">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">

        <a href="{{ path('app_home') }}" class="navbar-brand p-0">
            <h1 class="m-0"><i class="fa fa-map-marker-alt me-3"></i>After Travel</h1>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0 align-items-lg-center">

                <a href="{{ path('app_home') }}" class="nav-item nav-link">Accueil</a>

                {# ── Voyage dropdown (with AI Recommendation added) ── #}
                <div class="nav-item dropdown">
                    <a href="{{ path('app_voyage') }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Voyage
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_voyage') }}">
                            <i class="fa fa-plane me-2 text-primary"></i>Tous les Voyages
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_destination') }}">
                            <i class="fa fa-map-marker-alt me-2 text-primary"></i>Destinations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_voyage_recommandations') }}">
                            <i class="fa fa-star me-2 text-primary"></i>Recommandations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_voyage_favoris') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-heart me-2 text-primary"></i>Mes Favoris
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_voyage_recommandations_ia') }}">
                            <i class="fa fa-robot me-2" style="color:#6366f1;"></i>Recommandations IA
                            <span class="badge-ai">AI</span>
                        </a></li>
                    </ul>
                </div>

                {# ── Réservation & Paiement dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle {% if not app.user %}nav-restricted{% endif %}" data-bs-toggle="dropdown" {% if not app.user %}data-auth-required{% endif %}>
                        Réservation
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-calendar-check me-1"></i> Réservations</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'reservations'}) }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-list me-2 text-primary"></i>Mes Réservations
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'reservations', modal: 'reservation'}) }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouvelle Réservation
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-credit-card me-1"></i> Paiements</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'payments'}) }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-wallet me-2 text-primary"></i>Mes Paiements
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_dashboard', {view: 'payments', modal: 'payment'}) }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouveau Paiement
                        </a></li>
                    </ul>
                </div>

                {# ── Activité dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="{{ path('app_activite') }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Activité
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-running me-1"></i> Activités</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_activite') }}">
                            <i class="fa fa-list me-2 text-primary"></i>Toutes les Activités
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-calendar-alt me-1"></i> Plannings</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_planning') }}">
                            <i class="fa fa-calendar me-2 text-primary"></i>Tous les Plannings
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_activite_qr') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-qrcode me-2 text-primary"></i>Générer QR Code
                        </a></li>
                    </ul>
                </div>

                {# ── Document dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Document
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-file-alt me-1"></i> Documents</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_crud_index') }}">
                            <i class="fa fa-list me-2 text-primary"></i>Tous les Documents
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_crud_new') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouveau Document
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_document_stats') }}">
                            <i class="fa fa-chart-bar me-2 text-primary"></i>Statistiques
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-tags me-1"></i> Catégories</h6></li>
                        <li><a class="dropdown-item" href="{{ path('app_categorie_document_index') }}">
                            <i class="fa fa-folder me-2 text-primary"></i>Catégories
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('app_categorie_document_new') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-folder-plus me-2 text-primary"></i>Nouvelle Catégorie
                        </a></li>
                    </ul>
                </div>

                {# ── Services & Offres dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        Services
                    </a>
                    <div class="dropdown-menu" style="min-width: 230px;">

                        <h6 class="dropdown-header">
                            <i class="fa fa-cogs me-1"></i> Services
                        </h6>
                        <a href="{{ path('app_service_index') }}" class="dropdown-item">
                            <i class="fa fa-list me-2 text-primary"></i>Tous les Services
                        </a>
                        <a href="{{ path('app_service_new') }}" class="dropdown-item" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-success"></i>Ajouter un Service
                        </a>
                        <a href="{{ path('app_service_stats') }}" class="dropdown-item">
                            <i class="fa fa-chart-bar me-2 text-info"></i>Statistiques
                        </a>

                        <div class="dropdown-divider"></div>

                        <h6 class="dropdown-header">
                            <i class="fa fa-tags me-1"></i> Offres
                        </h6>
                        <a href="{{ path('app_offre_index') }}" class="dropdown-item">
                            <i class="fa fa-list me-2 text-primary"></i>Toutes les Offres
                        </a>
                        <a href="{{ path('app_offre_new') }}" class="dropdown-item" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-success"></i>Ajouter une Offre
                        </a>
                        <a href="{{ path('app_offre_export_pdf') }}" class="dropdown-item">
                            <i class="fa fa-file-pdf me-2 text-danger"></i>Exporter PDF
                        </a>

                    </div>
                </div>

                {# ── Dépense dropdown ── #}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle {% if not app.user %}nav-restricted{% endif %}" data-bs-toggle="dropdown" {% if not app.user %}data-auth-required{% endif %}>
                        Dépense
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header"><i class="fa fa-wallet me-1"></i> Dépenses</h6></li>
                        <li><a class="dropdown-item" href="{{ path('depense_index') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-list me-2 text-primary"></i>Toutes les Dépenses
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('depense_new') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-plus-circle me-2 text-primary"></i>Nouvelle Dépense
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="fa fa-chart-pie me-1"></i> Rapports & Cartes</h6></li>
                        <li><a class="dropdown-item" href="{{ path('rapport_index') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-chart-bar me-2 text-primary"></i>Rapport des Dépenses
                        </a></li>
                        <li><a class="dropdown-item" href="{{ path('carte_depenses') }}" {% if not app.user %}data-auth-required{% endif %}>
                            <i class="fa fa-map-marker-alt me-2 text-primary"></i>Carte des Dépenses
                        </a></li>
                    </ul>
                </div>
                <a href="{{ path('app_about') }}" class="nav-item nav-link">About</a>

                {% if app.user %}
                    <div class="nav-item dropdown ms-lg-3">
                        <a class="nav-profile-chip dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <span class="nav-profile-initials">
                                {{ (app.user.prenom|first ~ app.user.nom|first)|upper }}
                            </span>
                            {{ app.user.prenom }} {{ app.user.nom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="fa fa-user"></i> Profil
                                </a>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_admin_home') }}">
                                    <i class="fa fa-tachometer-alt me-1"></i> Dashboard Admin
                                </a>
                            </li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('_logout_main') }}">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-item nav-link">Se Connecter</a>
                {% endif %}

            </div>
        </div>
    </nav>
</div>

{% block hero %}{% endblock %}
{% block body %}{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/main.js') }}"></script>

    <script>
        setTimeout(() => {
            document.querySelectorAll('.flash-message').forEach(el => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            });
        }, 3200);
    </script>
{% endblock %}
{% if not app.user %}
<div id="auth-toast" role="alert">
    <div class="auth-toast-inner">
        <div class="auth-toast-icon">🔒</div>
        <div class="auth-toast-text">
            <strong>Connexion requise</strong>
            <span>Créez un compte ou connectez-vous pour accéder à cette fonctionnalité.</span>
        </div>
        <div class="auth-toast-actions">
            <a href="{{ path('app_login') }}" class="btn-toast-login">Se connecter</a>
            <a href="{{ path('app_register') }}" class="btn-toast-register">S'inscrire</a>
        </div>
        <button class="btn-toast-close" onclick="hideAuthToast()" aria-label="Fermer">&times;</button>
    </div>
</div>

<script>
var _authToastTimer = null;
function showAuthToast(e) {
    e.preventDefault();
    e.stopPropagation();
    var t = document.getElementById('auth-toast');
    t.classList.add('show');
    clearTimeout(_authToastTimer);
    _authToastTimer = setTimeout(hideAuthToast, 4500);
}
function hideAuthToast() {
    document.getElementById('auth-toast').classList.remove('show');
}
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-auth-required]').forEach(function(el) {
        el.classList.add('nav-restricted');
        el.addEventListener('click', showAuthToast);
    });
});
</script>
{% endif %}

</body>
</html>
