<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>{% block title %}After Travel{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&family=Roboto&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
        <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
        <link href="{{ asset('css/style.css') }}" rel="stylesheet">
        <style>
            /* ── Profile chip ── */
            .nav-profile-chip {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 5px 14px 5px 6px;
                border-radius: 50px;
                border: 1.5px solid rgba(255,255,255,0.25);
                background: rgba(255,255,255,0.10);
                color: #fff;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
                transition: background 0.2s, border-color 0.2s;
                white-space: nowrap;
            }
            .nav-profile-chip:hover {
                background: rgba(255,255,255,0.20);
                border-color: rgba(255,255,255,0.45);
                color: #fff;
            }
            .nav-profile-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid rgba(255,255,255,0.5);
            }
            .nav-profile-initials {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: linear-gradient(135deg, #3b5bdb, #74c0fc);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: #fff;
                border: 2px solid rgba(255,255,255,0.5);
                flex-shrink: 0;
            }

            /* ── Dropdown tweaks ── */
            .navbar .dropdown-menu {
                border-radius: 12px;
                border: none;
                box-shadow: 0 8px 32px rgba(26,43,94,0.14);
                padding: 6px;
                min-width: 210px;
            }
            .navbar .dropdown-item {
                border-radius: 8px;
                padding: 8px 14px;
                font-size: 14px;
                font-weight: 500;
                color: #1a2b5e;
                display: flex;
                align-items: center;
                gap: 9px;
            }
            .navbar .dropdown-item:hover {
                background: #f0f4ff;
                color: #3b5bdb;
            }
            .navbar .dropdown-item i {
                width: 16px;
                text-align: center;
                color: #3b5bdb;
            }
            .navbar .dropdown-divider { margin: 4px 6px; }

            /* Keep the existing nav-link color on primary bg */
            .navbar .nav-link.dropdown-toggle { color: inherit; }
        </style>
    {% endblock %}
</head>
<body>

<!-- Navbar -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="{{ path('app_home') }}" class="navbar-brand p-0">
            <h1 class="m-0"><i class="fa fa-map-marker-alt me-3"></i>After Travel</h1>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0 align-items-lg-center">

                <a href="{{ path('app_home') }}" class="nav-item nav-link">Accueil</a>

                {# ── Voyages dropdown ── #}
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="voyagesDropdown"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Voyages
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="voyagesDropdown">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_voyage') }}">
                                <i class="fa fa-plane"></i> Tous les voyages
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_voyage_favoris') }}">
                                <i class="fa fa-heart"></i> Mes favoris
                            </a>
                        </li>
                        
<li>
    <a class="dropdown-item" href="{{ path('app_destination') }}">
        <i class="fa fa-map-marker-alt"></i> Destinations
    </a>
</li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_voyage_recommandations') }}">
                                <i class="fa fa-filter"></i> Recommandations
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_voyage_recommandations_ia') }}">
                                <i class="fa fa-robot"></i> Recommandations IA
                            </a>
                        </li>
                    </ul>
                </div>

                <a href="#" class="nav-item nav-link">Réservation</a>
                <a href="#" class="nav-item nav-link">Activité</a>
                <a href="#" class="nav-item nav-link">Document</a>
                <a href="#" class="nav-item nav-link">Services</a>
                <a href="#" class="nav-item nav-link">Dépense</a>
                <a href="{{ path('app_about') }}" class="nav-item nav-link">About</a>

                {# ── Profile chip (only when logged in) ── #}
                {% if app.user %}
                    <div class="nav-item dropdown ms-lg-3 mt-2 mt-lg-0">
                        <a class="nav-profile-chip dropdown-toggle" href="#"
                           id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            {% if app.user.photo_profil and app.user.photo_profil != 'default.png' %}
                                <img src="{{ asset('uploads/photos/' ~ app.user.photo_profil) }}"
                                     alt="" class="nav-profile-avatar"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                <span class="nav-profile-initials" style="display:none">
                                    {{ (app.user.prenom|first ~ app.user.nom|first)|upper }}
                                </span>
                            {% else %}
                                <span class="nav-profile-initials">
                                    {{ (app.user.prenom|first ~ app.user.nom|first)|upper }}
                                </span>
                            {% endif %}
                            {{ app.user.prenom }} {{ app.user.nom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="fa fa-user"></i> Mon profil
                                </a>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_dashboard') }}">
                                    <i class="fa fa-tachometer-alt"></i> Dashboard admin
                                </a>
                            </li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('_logout_main') }}">
                                    <i class="fa fa-sign-out-alt"></i> Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-item nav-link ms-lg-2">
                        <i class="fa fa-sign-in-alt me-1"></i>Connexion
                    </a>
                {% endif %}

            </div>
        </div>
    </nav>
</div>

{% block body %}{% endblock %}

{% block javascripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('lib/easing/easing.min.js') }}"></script>
    <script src="{{ asset('lib/waypoints/waypoints.min.js') }}"></script>
    <script src="{{ asset('js/main.js') }}"></script>
{% endblock %}

</body>
</html>
