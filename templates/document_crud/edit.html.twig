{% extends 'base.html.twig' %}
{% block title %}Modifier Document{% endblock %}
{% block body %}

<div class="container-fluid bg-warning py-5 mb-5">
    <div class="container py-5 text-center">
        <h1 class="display-3 text-dark">✏️ Modifier le Document</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h4 class="mb-0">✏️ Modifier : {{ document.nomDocument }}</h4>
                </div>
                <div class="card-body p-4">

                    {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}

                        <div class="col-12">
                            {{ form_label(form.nomDocument, 'Nom du document', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.nomDocument, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(form.cheminFichier, 'Chemin / URL du fichier', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.cheminFichier, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_label(form.dateAjout, 'Date d\'ajout', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.dateAjout, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_label(form.dateExpiration, 'Date d\'expiration', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.dateExpiration, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(form.categorie, 'Catégorie', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="col-12 d-flex gap-3 mt-3">
                            <button type="submit" class="btn btn-warning px-4">
                                💾 Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_document_crud_index') }}" class="btn btn-outline-secondary px-4">
                                ← Retour à la liste
                            </a>
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>

            {# Bouton Supprimer #}
            <div class="mt-3">
                <form method="post"
                      action="{{ path('app_document_crud_delete', {'idDocument': document.idDocument}) }}"
                      onsubmit="return confirm('Supprimer ce document ?')">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete' ~ document.idDocument) }}">
                    <button class="btn btn-danger">🗑 Supprimer ce document</button>
                </form>
            </div>

        </div>
    </div>
</div>

{% endblock %}