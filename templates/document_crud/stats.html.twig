{% extends 'base.html.twig' %}
{% block title %}Statistiques - AFTER Travel{% endblock %}

{% block body %}

<div class="container-fluid py-5 mb-5"
     style="background: linear-gradient(135deg, #1a2744, #2563eb);">
    <div class="container py-5 text-center">
        <h1 class="display-3 text-white">📊 Statistiques</h1>
        <p class="text-white-50 fs-5">Vue complète de vos documents</p>
    </div>
</div>

<div class="container py-5">

    {# Stats Cards #}
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4"
                 style="background: linear-gradient(135deg, #1a2744, #2563eb);">
                <div style="font-size:36px;">📄</div>
                <h2 class="text-white fw-bold mb-0">{{ total }}</h2>
                <p class="text-white-50 mb-0">Total</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4"
                 style="background: linear-gradient(135deg, #22c55e, #16a34a);">
                <div style="font-size:36px;">✅</div>
                <h2 class="text-white fw-bold mb-0">{{ valides }}</h2>
                <p class="text-white-50 mb-0">Valides ({{ taux.taux_valides }}%)</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4"
                 style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                <div style="font-size:36px;">⚠️</div>
                <h2 class="text-white fw-bold mb-0">{{ bientot }}</h2>
                <p class="text-white-50 mb-0">Expirent bientôt</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4"
                 style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                <div style="font-size:36px;">❌</div>
                <h2 class="text-white fw-bold mb-0">{{ expires }}</h2>
                <p class="text-white-50 mb-0">Expirés ({{ taux.taux_expiration }}%)</p>
            </div>
        </div>
    </div>

    {# Graphiques #}
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-4">🗂 Répartition par catégorie</h5>
                <canvas id="pieChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-4">📈 Uploads par mois</h5>
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>

    {# Taux de validité #}
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
        <h5 class="fw-bold mb-4">🎯 Taux de validité global</h5>
        <div style="background:#f1f5f9; border-radius:10px; height:30px; overflow:hidden;">
            <div style="height:100%; border-radius:10px; width:{{ taux.taux_valides }}%;
                        background: linear-gradient(135deg, #22c55e, #16a34a);
                        display:flex; align-items:center; justify-content:center;
                        color:white; font-weight:bold; font-size:14px;
                        transition: width 1s ease;">
                {{ taux.taux_valides }}% valides
            </div>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <small class="text-success fw-bold">✅ {{ valides }} valides</small>
            <small class="text-warning fw-bold">⚠️ {{ bientot }} bientôt</small>
            <small class="text-danger fw-bold">❌ {{ expires }} expirés</small>
        </div>
    </div>

    {# Top catégories #}
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
        <h5 class="fw-bold mb-4">🏆 Top catégories</h5>
        {% for cat in topCats %}
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="badge rounded-pill px-3 py-2"
                  style="background: linear-gradient(135deg, #1a2744, #2563eb); min-width:30px;">
                {{ loop.index }}
            </span>
            <span class="fw-bold flex-fill">{{ cat.libelle ?? 'N/A' }}</span>
            <span class="badge bg-primary rounded-pill px-3">{{ cat.total }} docs</span>
            <div style="width:150px; background:#f1f5f9; border-radius:10px; height:8px;">
                {% set maxTotal = topCats|first %}
                {% set pct = maxTotal.total > 0 ? ((cat.total / maxTotal.total) * 100)|round : 0 %}
                <div style="height:100%; border-radius:10px; width:{{ pct }}%;
                            background: linear-gradient(135deg, #1a2744, #2563eb);">
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="text-center">
        <a href="{{ path('app_document_crud_index') }}"
           class="btn btn-outline-primary rounded-pill px-5">
            ← Retour aux documents
        </a>
    </div>

</div>

{% endblock %}
{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// PieChart
new Chart(document.getElementById('pieChart'), {
    type: 'doughnut',
    data: {
        labels: [{% for row in parCategorie %}'{{ row.libelle ? row.libelle|e('js') : 'N/A' }}',{% endfor %}],
        datasets: [{
            data: [{% for row in parCategorie %}{{ row.total }},{% endfor %}],
            backgroundColor: ['#2563eb','#ef4444','#22c55e','#f59e0b','#8b5cf6','#06b6d4','#ec4899','#14b8a6'],
            borderWidth: 3,
            borderColor: 'white'
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { position: 'bottom' },
            tooltip: {
                callbacks: {
                    label: ctx => ` ${ctx.label}: ${ctx.raw} documents`
                }
            }
        }
    }
});

// BarChart
new Chart(document.getElementById('barChart'), {
    type: 'bar',
    data: {
        labels: [{% for row in parMois %}'{{ row.month }}',{% endfor %}],
        datasets: [{
            label: 'Documents ajoutés',
            data: [{% for row in parMois %}{{ row.total }},{% endfor %}],
            backgroundColor: 'rgba(37,99,235,0.8)',
            borderRadius: 8,
            borderSkipped: false
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
        }
    }
});
</script>
{% endblock %}