{% extends 'base.html.twig' %}
{% block title %}Documents - AFTER Travel{% endblock %}
{% block body %}

<div class="container-fluid bg-primary py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row justify-content-center py-5">
            <div class="col-lg-10 text-center">
                <h1 class="display-3 text-white">📄 Mes Documents</h1>
                <p class="text-white">Gérez vos documents de voyage</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {# Stats Cards #}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body text-center">
                    <h2>{{ total }}</h2>
                    <p>📄 Total Documents</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body text-center">
                    <h2>{{ valides }}</h2>
                    <p>✅ Documents Valides</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body text-center">
                    <h2>{{ expires }}</h2>
                    <p>❌ Documents Expirés</p>
                </div>
            </div>
        </div>
    </div>

    {# Recherche + Filtres + Tri #}
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="search" value="{{ search }}"
                   class="form-control" placeholder="🔍 Rechercher par nom...">
        </div>
        <div class="col-md-3">
            <select name="filtre" class="form-select">
                <option value="tous" {{ filtre == 'tous' ? 'selected' : '' }}>Tous</option>
                <option value="valides" {{ filtre == 'valides' ? 'selected' : '' }}>✅ Valides</option>
                <option value="expires" {{ filtre == 'expires' ? 'selected' : '' }}>❌ Expirés</option>
                <option value="bientot" {{ filtre == 'bientot' ? 'selected' : '' }}>⚠️ Expirent bientôt</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="tri" class="form-select">
                <option value="dateAjout" {{ tri == 'dateAjout' ? 'selected' : '' }}>Date ajout</option>
                <option value="nomDocument" {{ tri == 'nomDocument' ? 'selected' : '' }}>Nom</option>
                <option value="dateExpiration" {{ tri == 'dateExpiration' ? 'selected' : '' }}>Date expiration</option>
            </select>
        </div>
        <div class="col-md-1">
            <select name="ordre" class="form-select">
                <option value="DESC" {{ ordre == 'DESC' ? 'selected' : '' }}>↓</option>
                <option value="ASC" {{ ordre == 'ASC' ? 'selected' : '' }}>↑</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">🔍 Filtrer</button>
        </div>
    </form>

    {# Actions #}
    <div class="d-flex justify-content-between mb-3">
        <h5>{{ documents|length }} résultat(s)</h5>
        <div>
            <a href="{{ path('app_document_stats') }}" class="btn btn-info me-2">📊 Statistiques</a>
            <a href="{{ path('app_document_export_pdf') }}" class="btn btn-secondary me-2">📄 Export PDF</a>
            <a href="{{ path('app_document_crud_new') }}" class="btn btn-primary">➕ Ajouter</a>
        </div>
    </div>

    {# Tableau #}
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nom Document</th>
                    <th>Catégorie</th>
                    <th>Date Ajout</th>
                    <th>Date Expiration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for document in documents %}
                <tr>
                    <td>{{ document.idDocument }}</td>
                    <td>{{ document.nomDocument }}</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            {{ document.categorie ? document.categorie.libelle : 'N/A' }}
                        </span>
                    </td>
                    <td>{{ document.dateAjout ? document.dateAjout|date('d/m/Y') : '' }}</td>
                    <td>
                        {% if document.dateExpiration %}
                            {% if document.dateExpiration < date() %}
                                <span class="text-danger fw-bold">❌ {{ document.dateExpiration|date('d/m/Y') }}</span>
                            {% else %}
                                <span class="text-success">✅ {{ document.dateExpiration|date('d/m/Y') }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">N/A</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_document_crud_show', {'idDocument': document.idDocument}) }}"
                           class="btn btn-sm btn-info">👁</a>
                        <a href="{{ path('app_document_crud_edit', {'idDocument': document.idDocument}) }}"
                           class="btn btn-sm btn-warning">✏️</a>
                        <form method="post"
                              action="{{ path('app_document_crud_delete', {'idDocument': document.idDocument}) }}"
                              style="display:inline-block"
                              onsubmit="return confirm('Supprimer ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ document.idDocument) }}">
                            <button class="btn btn-sm btn-danger">🗑</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucun document trouvé</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}