{% extends 'base.html.twig' %}

{% block title %}Document{% endblock %}

{% block body %}
    <h1>Document</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>IdDocument</th>
                <td>{{ document.idDocument }}</td>
            </tr>
            <tr>
                <th>NomDocument</th>
                <td>{{ document.nomDocument }}</td>
            </tr>
            <tr>
                <th>CheminFichier</th>
                <td>{{ document.cheminFichier }}</td>
            </tr>
            <tr>
                <th>DateAjout</th>
                <td>{{ document.dateAjout ? document.dateAjout|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateExpiration</th>
                <td>{{ document.dateExpiration ? document.dateExpiration|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_document_crud_index') }}">back to list</a>

    <a href="{{ path('app_document_crud_edit', {'idDocument': document.idDocument}) }}">edit</a>

    {{ include('document_crud/_delete_form.html.twig') }}
{% endblock %}
