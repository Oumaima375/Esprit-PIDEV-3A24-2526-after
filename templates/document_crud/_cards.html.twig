{% for document in documents %}
<div class="col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm rounded-4 h-100"
         style="transition: transform 0.2s;"
         onmouseover="this.style.transform='translateY(-4px)'"
         onmouseout="this.style.transform='translateY(0)'">

        <div class="card-header border-0 rounded-top-4 py-3"
             style="background: linear-gradient(135deg, #1a2744, #2563eb);">
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill">
                    {{ document.categorie ? document.categorie.libelle : 'N/A' }}
                </span>
                {% if document.dateExpiration %}
                    {% if document.dateExpiration < date() %}
                        <span class="badge bg-danger rounded-pill">❌ Expiré</span>
                    {% else %}
                        <span class="badge bg-success rounded-pill">✅ Valide</span>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3">✈ {{ document.nomDocument }}</h5>
            <div class="d-flex flex-column gap-2">
                <small class="text-muted">📅 Ajouté : {{ document.dateAjout ? document.dateAjout|date('d/m/Y') : 'N/A' }}</small>
                <small class="{{ document.dateExpiration and document.dateExpiration < date() ? 'text-danger fw-bold' : 'text-muted' }}">
                    ⏳ Expire : {{ document.dateExpiration ? document.dateExpiration|date('d/m/Y') : 'N/A' }}
                </small>
            </div>
        </div>

        <div class="card-footer bg-transparent border-0 px-4 pb-4">
            <div class="d-flex gap-2">
                <a href="/document/crud/{{ document.idDocument }}"
                   class="btn btn-outline-primary btn-sm rounded-pill flex-fill">👁 Voir</a>
                <a href="/document/crud/{{ document.idDocument }}/edit"
                   class="btn btn-warning btn-sm rounded-pill flex-fill">✏️</a>
                <form method="post" action="/document/crud/{{ document.idDocument }}"
                      onsubmit="return confirm('Supprimer ?')" style="flex:1">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.idDocument) }}">
                    <button class="btn btn-danger btn-sm rounded-pill w-100">🗑</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="col-12 text-center py-5">
    <div style="font-size:64px;">📭</div>
    <h4 class="text-muted">Aucun document trouvé</h4>
</div>
{% endfor %}