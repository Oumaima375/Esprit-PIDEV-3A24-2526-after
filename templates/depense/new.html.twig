{% extends 'base.html.twig' %}

{% block title %}Nouvelle dépense - After Travel{% endblock %}

{% block hero %}
<div class="container-fluid bg-primary py-5 mb-5">
    <div class="container py-5">
        <div class="text-center">
            <h1 class="text-white display-3 mb-3 fw-bold">
                <i class="fa fa-plus-circle me-2"></i>Nouvelle Dépense
            </h1>
            <p class="text-white fs-5">Enregistrez une nouvelle dépense</p>
            <ol class="breadcrumb justify-content-center mb-0 mt-3">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('depense_index') }}">Dépenses</a></li>
            <li class="breadcrumb-item active text-white">Nouvelle dépense</li>
            </ol>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="bg-white rounded shadow-sm overflow-hidden">
                    <div class="p-4 text-white" style="background-color: #13357B;">
                        <h4 class="mb-0"><i class="fa fa-plus-circle me-2"></i>Ajouter une dépense</h4>
                    </div>
                    <div class="p-4">
                        {% include 'depense/_form.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% include '_footer.html.twig' ignore missing %}
{% endblock %}
