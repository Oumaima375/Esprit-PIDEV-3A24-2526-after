{% extends 'base.html.twig' %}

{% block title %}Nouvelle dépense - After Travel{% endblock %}

{% block hero %}
<div class="bg-breadcrumb">
    <div class="container text-center py-5">
        <h3 class="text-white display-3 mb-4 fw-bold">Nouvelle Dépense</h3>
        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('depense_index') }}">Dépenses</a></li>
            <li class="breadcrumb-item active text-white">Nouvelle dépense</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="bg-white rounded shadow-sm overflow-hidden">
                    <div class="p-4 text-white" style="background-color: #13357B;">
                        <h4 class="mb-0"><i class="fa fa-plus-circle me-2"></i>Ajouter une dépense</h4>
                    </div>
                    <div class="p-4">
                        {% include 'depense/_form.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
