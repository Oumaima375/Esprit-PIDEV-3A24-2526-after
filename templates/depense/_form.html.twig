{# Leaflet CSS + JS — chargés avant le script #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
/* ================================================================
   AFTER TRAVEL — Formulaire dépense
   Correction : assistant vocal + carte Leaflet dans modal Bootstrap
================================================================ */
(function () {
'use strict';

// ─────────────────────────────────────────
//  ATTENDRE QUE LE DOM SOIT DISPONIBLE
// ─────────────────────────────────────────
function waitForElement(id, cb, tries) {
    tries = tries || 0;
    const el = document.getElementById(id);
    if (el) { cb(); return; }
    if (tries > 30) { console.warn('Élément #' + id + ' introuvable après 3s'); return; }
    setTimeout(() => waitForElement(id, cb, tries + 1), 100);
}

waitForElement('depenseForm', setupForm);

function setupForm() {

// ── Références DOM ──────────────────────
const titreInput      = document.getElementById('depense_titre');
const montantInput    = document.getElementById('depense_montant');
const categorieSelect = document.getElementById('depense_categorie');
const submitBtn       = document.getElementById('submitBtn');
const titreFeedback   = document.getElementById('titre_feedback');
const montantFeedback = document.getElementById('montant_feedback');
const categorieFeedback = document.getElementById('categorie_feedback');
const lieuInput       = document.getElementById('depense_lieu');
const latInput        = document.getElementById('depense_latitude');
const lngInput        = document.getElementById('depense_longitude');
const locateBtn       = document.getElementById('locateMeBtn');
const suggestionsDiv  = document.getElementById('suggestions');
const geoStatusDiv    = document.getElementById('geoStatus');

// Voice
const voicePanel        = document.getElementById('voicePanel');
const voiceStatus       = document.getElementById('voiceStatus');
const voiceCompatStatus = document.getElementById('voiceCompatStatus');
const voiceDebug        = document.getElementById('voiceDebug');
const voiceFieldBadge   = document.getElementById('voiceFieldBadge');
const voiceCurrentField = document.getElementById('voiceCurrentField');
const voiceStartBtn     = document.getElementById('voiceStartBtn');
const voiceListenBtn    = document.getElementById('voiceListenBtn');
const voiceNextBtn      = document.getElementById('voiceNextBtn');
const voiceRepeatBtn    = document.getElementById('voiceRepeatBtn');

// ── État ────────────────────────────────
let titreOk = false, montantOk = false, categorieOk = false;
let map = null, marker = null, mapReady = false;
let activePoi = null, poiMarkers = [];
let bgMarkers = []; // Pour les icones qui s'affichent automatiquement à la Google Maps
let searchTimeout = null;
let autoFetchTimeout = null;
let currentCenter = { lat: 36.8065, lng: 10.1815 };
let voiceFieldIndex = 0;

// ─────────────────────────────────────────
//  CONVERSION API & ALERTE DE SEUIL BUDGET
// ─────────────────────────────────────────
let rates = null;

const visibleMontant = document.getElementById('visible_montant');
const trueMontant = document.getElementById('depense_montant');
const currencySelect = document.getElementById('currency_select');
const currencyFeedback = document.getElementById('currency_feedback');
const budgetAlert = document.getElementById('budget_alert');

// Charger les taux (ExchangeRate-API) de manière asynchrone
fetch('https://open.er-api.com/v6/latest/TND')
    .then(r => r.json())
    .then(data => { if(data && data.rates) rates = data.rates; });

// Synchro lors de l'édition d'une dépense
if (trueMontant.value) {
    visibleMontant.value = trueMontant.value;
}

function processMontantAndDevise() {
    let val = parseFloat(visibleMontant.value);
    if (isNaN(val) || val <= 0) {
        trueMontant.value = '';
        currencyFeedback.style.display = 'none';
        budgetAlert.style.display = 'none';
        validateMontant(); // Validation originale
        return;
    }

    let devise = currencySelect.value;
    let convertedTnd = val;

    if (devise !== 'TND' && rates && rates[devise]) {
        // TND est la base. Donc 1 EUR = 1 / taux_eur (ex: 0.3)
        convertedTnd = val / rates[devise];
        currencyFeedback.innerHTML = `<i class="fa fa-exchange-alt me-1"></i> Conversion: ≈ <strong>${convertedTnd.toFixed(2)} DT</strong>`;
        currencyFeedback.style.display = 'block';
    } else {
        currencyFeedback.style.display = 'none';
    }

    // Mettre à jour le champ caché qui part en base de données
    trueMontant.value = convertedTnd.toFixed(3);
    
    // Vérifier l'alerte budget
    checkBudgetThreshold();
    validateMontant();
}

function checkBudgetThreshold() {
    const catId = categorieSelect.value;
    const mt = parseFloat(trueMontant.value);
    
    if (!catId || isNaN(mt)) {
        budgetAlert.style.display = 'none';
        return;
    }

    fetch('/budget/category-status/' + catId)
        .then(r => r.json())
        .then(data => {
            if (data.error || data.budgetMax === null) {
                budgetAlert.style.display = 'none';
                return;
            }
            
            let futurTotal = (data.total || 0) + mt;
            if (futurTotal > data.budgetMax) {
                budgetAlert.innerHTML = `<i class="fa fa-exclamation-triangle"></i> Dépassement Budget ! Total: ${futurTotal.toFixed(2)} DT / ${data.budgetMax} DT.`;
                budgetAlert.style.display = 'block';
            } else if (futurTotal > data.budgetMax * 0.8) {
                budgetAlert.innerHTML = `<i class="fa fa-info-circle" style="color:orange;"></i> Attention, budget proche: ${futurTotal.toFixed(2)} DT / ${data.budgetMax} DT.`;
                budgetAlert.style.display = 'block';
            } else {
                budgetAlert.style.display = 'none';
            }
        });
}

visibleMontant.addEventListener('input', processMontantAndDevise);
currencySelect.addEventListener('change', processMontantAndDevise);
categorieSelect.addEventListener('change', processMontantAndDevise);

// ─────────────────────────────────────────
//  VALIDATION FORMULAIRE
// ─────────────────────────────────────────
function setFeedback(input, el, ok, msg) {
    input.classList.toggle('is-invalid', !ok);
    input.classList.toggle('is-valid', ok);
    el.innerHTML = ok
        ? `<span class="text-success">✓ ${msg}</span>`
        : `<span class="text-danger">⚠ ${msg}</span>`;
    return ok;
}

function validateTitre() {
    const v = titreInput.value.trim();
    if (!v)           return titreOk = setFeedback(titreInput, titreFeedback, false, 'Le titre est obligatoire.');
    if (/\d/.test(v)) return titreOk = setFeedback(titreInput, titreFeedback, false, 'Pas de chiffres dans le titre.');
    if (v.length < 3) return titreOk = setFeedback(titreInput, titreFeedback, false, 'Minimum 3 caractères.');
    return titreOk = setFeedback(titreInput, titreFeedback, true, 'Titre valide.');
}

function validateMontant() {
    const v = montantInput.value.trim();
    const n = parseFloat(v.replace(',', '.'));
    if (!v)                              return montantOk = setFeedback(montantInput, montantFeedback, false, 'Montant obligatoire.');
    if (!/^[0-9]+([.,][0-9]+)?$/.test(v)) return montantOk = setFeedback(montantInput, montantFeedback, false, 'Chiffres uniquement.');
    if (isNaN(n) || n <= 0)              return montantOk = setFeedback(montantInput, montantFeedback, false, 'Doit être positif.');
    return montantOk = setFeedback(montantInput, montantFeedback, true, 'Montant valide.');
}

function validateCategorie() {
    if (!categorieSelect.value) {
        categorieSelect.classList.add('is-invalid');
        categorieSelect.classList.remove('is-valid');
        categorieFeedback.innerHTML = '<span class="text-danger">⚠ Sélectionnez une catégorie.</span>';
        return categorieOk = false;
    }
    categorieSelect.classList.remove('is-invalid');
    categorieSelect.classList.add('is-valid');
    categorieFeedback.innerHTML = '<span class="text-success">✓ Catégorie sélectionnée.</span>';
    return categorieOk = true;
}

function refreshSubmit() { submitBtn.disabled = !(titreOk && montantOk && categorieOk); }

titreInput.addEventListener('input',       () => { validateTitre();    refreshSubmit(); });
montantInput.addEventListener('input',     () => { validateMontant();  refreshSubmit(); });
categorieSelect.addEventListener('change', () => { validateCategorie(); refreshSubmit(); });

validateTitre(); validateMontant(); validateCategorie(); refreshSubmit();

// ─────────────────────────────────────────
//  ASSISTANT VOCAL
// ─────────────────────────────────────────
const FIELDS = [
    { id: 'depense_titre',       label: 'Titre de la dépense', type: 'text'   },
    { id: 'visible_montant',     label: 'Montant',             type: 'number' },
    { id: 'depense_dateDepense', label: 'Date',                type: 'date'   },
    { id: 'depense_categorie',   label: 'Catégorie',           type: 'select' },
    { id: 'depense_lieu',        label: 'Lieu',                type: 'text'   },
];

// Détection SpeechRecognition
const SpeechAPI = window.SpeechRecognition || window.webkitSpeechRecognition || null;
let rec = null;
let voiceStarted = false;

function dbg(msg) {
    console.log('[Voice]', msg);
    voiceDebug.style.display = 'block';
    voiceDebug.innerHTML = '> ' + msg;
}

function setVoiceStatus(msg, color) {
    voiceStatus.textContent = msg;
    voiceStatus.style.color = color || '';
}

// Afficher statut compatibilité
if (!SpeechAPI) {
    voiceCompatStatus.style.display = 'block';
    voiceCompatStatus.style.background = '#fff3cd';
    voiceCompatStatus.innerHTML = '⚠️ <strong>Reconnaissance vocale non disponible.</strong> Utilisez Chrome 25+ ou Edge 79+. Opera peut nécessiter d\'activer le flag <code>chrome://flags/#enable-experimental-web-platform-features</code>';
    voiceStartBtn.disabled = true;
    voiceListenBtn.disabled = true;
    voiceNextBtn.disabled = true;
    voiceRepeatBtn.disabled = true;
} else {
    voiceCompatStatus.style.display = 'block';
    voiceCompatStatus.style.background = '#d4edda';
    voiceCompatStatus.innerHTML = '✅ Reconnaissance vocale disponible sur ce navigateur.';
    rec = new SpeechAPI();
    rec.lang = 'fr-FR';
    rec.interimResults = false;
    rec.maxAlternatives = 3; // Plus d'alternatives pour meilleure précision
    rec.continuous = false;
}

function speak(text, onEnd) {
    if (!window.speechSynthesis || !text) { if (onEnd) onEnd(); return; }
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'fr-FR';
    u.rate = 0.9;
    u.volume = 1;
    if (onEnd) u.onend = onEnd;
    // Fallback si speechSynthesis ne démarre pas
    setTimeout(() => { if (onEnd && u.onend) onEnd(); }, 4000);
    window.speechSynthesis.speak(u);
}

function norm(v) {
    return (v || '').toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^\w\s\/\-\.]/g, ' ').replace(/\s+/g, ' ').trim();
}

function parseDate(text) {
    const n = norm(text);
    const today = new Date();
    
    // Raccourcis naturels
    if (/aujourd.?hui/.test(n)) return today.toISOString().slice(0, 10);
    if (/demain/.test(n)) { today.setDate(today.getDate() + 1); return today.toISOString().slice(0, 10); }
    if (/hier/.test(n)) { today.setDate(today.getDate() - 1); return today.toISOString().slice(0, 10); }

    // Remplacer les mois en toutes lettres par des nombres (ex: "janvier" -> "01")
    const moisList = {'janvier':'01','fevrier':'02','mars':'03','avril':'04','mai':'05','juin':'06','juillet':'07','aout':'08','septembre':'09','octobre':'10','novembre':'11','decembre':'12'};
    let parsedText = n;
    Object.keys(moisList).forEach(m => {
        parsedText = parsedText.replace(new RegExp('\\b' + m + '\\b', 'g'), moisList[m]);
    });

    // 12 04 2024  ou  12/04/2024
    const m1 = parsedText.match(/(\d{1,2})[\/\- ]+(\d{1,2})[\/\- ]+(\d{4})/);
    if (m1) return `${m1[3]}-${m1[2].padStart(2,'0')}-${m1[1].padStart(2,'0')}`;
    
    // Si l'année manque, on met l'année courante (ex: "12 avril")
    const m3 = parsedText.match(/(\d{1,2})[\/\- ]+(\d{1,2})\b/);
    if (m3) return `${today.getFullYear()}-${m3[2].padStart(2,'0')}-${m3[1].padStart(2,'0')}`;

    // Format ISO standard: 2024-04-12
    const m2 = parsedText.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (m2) return `${m2[1]}-${m2[2]}-${m2[3]}`;
    
    return null;
}

function describeCurrentField() {
    const f  = FIELDS[voiceFieldIndex];
    const el = document.getElementById(f.id);

    // Mettre à jour le badge
    voiceCurrentField.style.display = 'block';
    voiceFieldBadge.textContent = `${voiceFieldIndex + 1}/${FIELDS.length} — ${f.label}`;

    if (!el) {
        setVoiceStatus(`⚠ Champ "${f.id}" introuvable dans le DOM.`, 'orange');
        dbg('Element not found: ' + f.id);
        return;
    }

    el.focus();
    el.style.outline = '2px solid #1a73e8';

    let msg = `Champ ${f.label}.`;

    if (f.type === 'select') {
        const opts = Array.from(el.options)
            .map(o => o.textContent.trim())
            .filter(o => o && !/selectionner|--|choisir/i.test(o));
        if (opts.length) msg += ` Les choix disponibles sont : ${opts.join(', ')}.`;
    } else if (el.value) {
        msg += ` Valeur actuelle : ${el.value}.`;
    } else {
        msg += ' Ce champ est vide. Parlez pour le remplir.';
    }

    setVoiceStatus(`📢 ${msg}`, '#13357B');
    dbg('Speaking: ' + msg);
    speak(msg);
}

function applyTranscript(transcript) {
    const f  = FIELDS[voiceFieldIndex];
    const el = document.getElementById(f.id);

    if (!el) {
        setVoiceStatus('⚠ Champ introuvable.', 'red');
        return;
    }

    const n = norm(transcript);
    dbg('Applying "' + transcript + '" → type=' + f.type + ', field=' + f.id);

    let applied = false;

    if (f.type === 'number') {
        // Gérer "vingt cinq virgule cinquante" etc.
        const mNum = n.replace(',', '.').match(/\d+(?:\.\d+)?/);
        if (mNum) {
            el.value = mNum[0];
            el.dispatchEvent(new Event('input', { bubbles: true }));
            applied = true;
        }

    } else if (f.type === 'date') {
        const d = parseDate(transcript);
        if (d) {
            el.value = d;
            el.dispatchEvent(new Event('input', { bubbles: true }));
            applied = true;
        }

    } else if (f.type === 'select') {
        // Chercher correspondance souple
        let best = null;
        let bestScore = 0;
        Array.from(el.options).forEach(o => {
            const t = norm(o.textContent);
            if (!t || /selectionner|--|choisir/i.test(t)) return;
            let score = 0;
            if (t === n) score = 100;
            else if (t.includes(n) || n.includes(t)) score = 50;
            else {
                // Comparaison mot par mot
                const words = n.split(' ');
                words.forEach(w => { if (w.length > 2 && t.includes(w)) score += 10; });
            }
            if (score > bestScore) { bestScore = score; best = o; }
        });
        if (best && bestScore > 0) {
            el.value = best.value;
            el.dispatchEvent(new Event('change', { bubbles: true }));
            applied = true;
        }

    } else {
        // Texte libre
        el.value = transcript.trim();
        el.dispatchEvent(new Event('input', { bubbles: true }));
        applied = true;
    }

    if (applied) {
        el.style.outline = '2px solid #198754';
        setVoiceStatus(`✅ "${transcript}" → ${f.label}`, 'green');
        speak(`Enregistré : ${transcript}`);
    } else {
        el.style.outline = '2px solid #dc3545';
        setVoiceStatus(`⚠ Non compris : "${transcript}". Réessayez.`, 'orange');
        speak(`Je n'ai pas compris. Pouvez-vous répéter ?`);
    }
}

// ── Bouton : Démarrer ──
voiceStartBtn.addEventListener('click', () => {
    voiceStarted = true;
    voiceFieldIndex = 0;
    voiceListenBtn.disabled = false;
    voiceNextBtn.disabled = false;
    voiceRepeatBtn.disabled = false;

    // Retirer l'outline des champs précédents
    FIELDS.forEach(f => {
        const el = document.getElementById(f.id);
        if (el) el.style.outline = '';
    });

    describeCurrentField();
});

// ── Bouton : Écouter ma réponse ──
voiceListenBtn.addEventListener('click', () => {
    if (!rec) return;

    setVoiceStatus('🎤 Parlez maintenant… (en écoute)', '#dc3545');
    voicePanel.classList.add('active-listening');
    voiceListenBtn.disabled = true;
    voiceListenBtn.textContent = '⏺ En écoute…';
    dbg('Starting recognition...');

    try {
        rec.start();
    } catch (e) {
        dbg('Error starting: ' + e.message);
        voicePanel.classList.remove('active-listening');
        voiceListenBtn.disabled = false;
        voiceListenBtn.textContent = '🎤 Écouter ma réponse';
        setVoiceStatus('⚠ Erreur démarrage micro : ' + e.message, 'red');
    }
});

// ── Bouton : Champ suivant ──
voiceNextBtn.addEventListener('click', () => {
    if (!voiceStarted) return;
    const el = document.getElementById(FIELDS[voiceFieldIndex].id);
    if (el) el.style.outline = '';
    voiceFieldIndex = (voiceFieldIndex + 1) % FIELDS.length;
    describeCurrentField();
});

// ── Bouton : Répéter ──
voiceRepeatBtn.addEventListener('click', () => {
    if (voiceStarted) describeCurrentField();
});

// ── Événements SpeechRecognition ──
if (rec) {
    rec.addEventListener('result', e => {
        dbg('Result received, alternatives: ' + e.results[0].length);
        const transcript = e.results[0][0].transcript;
        dbg('Best transcript: "' + transcript + '" (conf=' + e.results[0][0].confidence.toFixed(2) + ')');
        applyTranscript(transcript);
    });

    rec.addEventListener('end', () => {
        dbg('Recognition ended');
        voicePanel.classList.remove('active-listening');
        voiceListenBtn.disabled = false;
        voiceListenBtn.textContent = '🎤 Écouter ma réponse';
    });

    rec.addEventListener('error', e => {
        dbg('Error: ' + e.error);
        voicePanel.classList.remove('active-listening');
        voiceListenBtn.disabled = false;
        voiceListenBtn.textContent = '🎤 Écouter ma réponse';

        const msgs = {
            'not-allowed'  : '⚠ Microphone refusé. Cliquez sur l\'icône 🔒 dans la barre d\'adresse et autorisez le micro.',
            'no-speech'    : '⚠ Aucune parole détectée. Parlez plus fort.',
            'network'      : '⚠ Erreur réseau. La reconnaissance vocale nécessite une connexion internet.',
            'audio-capture': '⚠ Aucun microphone détecté sur cet appareil.',
            'service-not-allowed': '⚠ Service vocal non autorisé. Le site doit être en HTTPS ou localhost.',
            'aborted'      : 'Écoute annulée.',
        };
        setVoiceStatus(msgs[e.error] || ('⚠ Erreur : ' + e.error), 'red');
    });

    rec.addEventListener('audiostart', () => dbg('Audio capture started'));
    rec.addEventListener('speechstart', () => { dbg('Speech detected!'); setVoiceStatus('💬 Parole détectée…', '#13357B'); });
    rec.addEventListener('nomatch',     () => { setVoiceStatus('⚠ Voix non comprise. Réessayez.', 'orange'); });
}

