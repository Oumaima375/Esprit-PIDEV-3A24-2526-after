            bgMarkers.push(m);
        });
        applyFilter();
    })
    .catch(() => {
        // FALLBACK OPENSTREETMAP SI FOURSQUARE ECHOUE OU SI REDUIT AU SILENCE
        fetchNearbyOsmIcons(rayon);
