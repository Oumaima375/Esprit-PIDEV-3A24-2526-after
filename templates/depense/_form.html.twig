{{ form_start(form, {
    'attr': {
        'novalidate': 'novalidate',
        'id': 'depenseForm',
        'action': depense.id 
            ? path('depense_edit', { id: depense.id }) 
            : path('depense_new')
    }
}) }}
<div class="row g-3">

    <div class="col-md-12">
        <div class="form-floating">
            {{ form_widget(form.titre, {'attr': {'class': 'form-control border-0', 'placeholder': 'Titre', 'id': 'depense_titre'}}) }}
            {{ form_label(form.titre, 'Titre de la dépense') }}
        </div>
        <div id="titre_feedback" class="mt-1"></div>
    </div>

    <div class="col-md-6">
        <div class="input-group shadow-sm rounded">
            <div class="form-floating flex-grow-1">
                <!-- Champ visible pour la saisie (qui peut être en EUR ou USD) -->
                <input type="number" id="visible_montant" class="form-control border-0" placeholder="0.00" step="0.01">
                <label for="visible_montant">Montant</label>
            </div>
            <select class="form-select border-0 bg-light" id="currency_select" style="max-width: 90px; text-align: center; font-weight: 600; cursor: pointer; border-left: 1px solid #dee2e6 !important;">
                <option value="TND" selected>DT</option>
                <option value="EUR">€ EUR</option>
                <option value="USD">$ USD</option>
            </select>
        </div>
        
        <!-- Champ caché qui contiendra TOUJOURS la valeur finale en TND pour la BDD -->
        <div class="d-none">
            {{ form_widget(form.montant, {'attr': {'id': 'depense_montant'}}) }}
        </div>
        
        <!-- Retours d'infos UI -->
        <div id="currency_feedback" class="mt-1 small" style="display:none; color: #13357B; font-weight: 500;"></div>
        <div id="montant_feedback" class="mt-1 small"></div>
        <div id="budget_alert" class="mt-1 small text-danger fw-bold" style="display:none;"></div>
    </div>

    <div class="col-md-6">
        <div class="form-floating">
            {{ form_widget(form.dateDepense, {'attr': {'class': 'form-control border-0'}}) }}
            {{ form_label(form.dateDepense, 'Date') }}
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-floating">
            {{ form_widget(form.categorie, {'attr': {'class': 'form-select border-0', 'id': 'depense_categorie'}}) }}
            {{ form_label(form.categorie, 'Catégorie') }}
        </div>
        <div id="categorie_feedback" class="mt-1"></div>
    </div>

    {# ══════════════════ ASSISTANT VOCAL ══════════════════ #}
    <div class="col-md-12">
        <div class="voice-panel" id="voicePanel">

            {# Statut compatibilité navigateur #}
            <div id="voiceCompatStatus" class="small mb-2 p-2 rounded" style="background:#f0f4ff;display:none"></div>

            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <button type="button" id="voiceStartBtn" class="btn btn-outline-primary btn-sm">
                    🎯 Démarrer l'assistant
                </button>
                <button type="button" id="voiceListenBtn" class="btn btn-outline-secondary btn-sm" disabled>
                    🎤 Écouter ma réponse
                </button>
                <button type="button" id="voiceNextBtn" class="btn btn-outline-dark btn-sm" disabled>
                    Champ suivant →
                </button>
                <button type="button" id="voiceRepeatBtn" class="btn btn-outline-info btn-sm" disabled>
                    🔁 Répéter
                </button>
            </div>

            {# Champ actif affiché #}
            <div id="voiceCurrentField" style="display:none;margin-bottom:8px">
                <span class="badge" style="background:#13357B;font-size:12px" id="voiceFieldBadge">—</span>
            </div>

            {# Statut + feedback #}
            <div id="voiceStatus" class="small text-muted">
                Cliquez sur <strong>Démarrer l'assistant</strong> pour commencer.
            </div>

            {# Zone de debug en temps réel #}
            <div id="voiceDebug" style="display:none;margin-top:8px;padding:8px;
                 background:#1a1a2e;color:#00ff88;border-radius:8px;font-family:monospace;font-size:11px">
            </div>
        </div>
    </div>

    {# ══════════════════ LIEU + MAP ══════════════════ #}
    <div class="col-md-12 position-relative">
        <div class="search-shell">
            <div class="search-bar">
                <div class="search-icon"><i class="fa fa-search"></i></div>
                {{ form_widget(form.lieu, {'attr': {
                    'class': 'search-input',
                    'id': 'depense_lieu',
                    'placeholder': 'Adresse, café, hôtel, coordonnées…',
                    'autocomplete': 'off'
                }}) }}
                <button type="button" id="locateMeBtn" class="locate-btn" title="Me localiser">
                    <i class="fa fa-location-arrow"></i>
                </button>
            </div>
        </div>

        <div class="poi-chips">
            <button type="button" class="poi-chip" data-poi="cafe">Cafés</button>
            <button type="button" class="poi-chip" data-poi="restaurant">Restaurants</button>
            <button type="button" class="poi-chip" data-poi="hotel">Hôtels</button>
            <button type="button" class="poi-chip" data-poi="airport">Aéroports</button>
            <button type="button" class="poi-chip" data-poi="museum">Musées</button>
        </div>

        <div id="geoStatus" class="geo-status" style="display:none"></div>
        <div id="suggestions" class="suggestions-panel" style="display:none"></div>

        {{ form_widget(form.latitude,  {'attr': {'id': 'depense_latitude'}})  }}
        {{ form_widget(form.longitude, {'attr': {'id': 'depense_longitude'}}) }}

        {# ── La map ── #}
        <div id="mapWrapper" style="margin-top:10px">
            <div id="map" style="height:420px;border-radius:20px;overflow:hidden;
                 border:1px solid #dadce0;background:#e8e8e8"></div>
        </div>
        <small class="text-muted">OpenStreetMap + géolocalisation + points d'intérêt.</small>
    </div>

    <div class="col-12">
        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2" {% if not depense.id %}disabled{% endif %}>
            <i class="fa fa-save me-2"></i>{{ depense.id ? 'Enregistrer les modifications' : 'Ajouter la dépense' }}
        </button>
    </div>
</div>
{{ form_end(form) }}

