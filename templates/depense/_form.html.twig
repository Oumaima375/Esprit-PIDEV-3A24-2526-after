    fetch(`https://api.foursquare.com/v3/places/search?ll=${currentCenter.lat},${currentCenter.lng}&radius=${rayon}&limit=50&categories=13000,19014,19009,10000`, {
        headers: { 'Authorization': 'KTEUWBOISVCCLXDBCPCB5BQRBXLJBAH1RQMDLSCIQQS15ZSI', 'Accept': 'application/json' }
    })
    .then(r => { if (!r.ok) throw new Error('FSQ Auth Fail'); return r.json(); })
    .then(d => {
        clearBackgroundMarkers();
        (d.results || []).forEach(e => {
            let cat = 'other';
            let iconClass = 'fa-map-marker';
            let color = '#ea4335';
            
            let fsqCat = e.categories[0]?.id?.toString() || '';
            if (fsqCat.startsWith('13032') || fsqCat.startsWith('13033')) { cat = 'cafe'; iconClass = 'fa-coffee'; color = '#fbc02d'; }
            else if (fsqCat.startsWith('13')) { cat = 'restaurant'; iconClass = 'fa-utensils'; color = '#ff9800'; }
            else if (fsqCat.startsWith('19014') || fsqCat.startsWith('19015')) { cat = 'hotel'; iconClass = 'fa-bed'; color = '#4285f4'; }
            else if (fsqCat.startsWith('10')) { cat = 'museum'; iconClass = 'fa-landmark'; color = '#9c27b0'; }
            else if (fsqCat.startsWith('19009') || fsqCat.startsWith('19031')) { cat = 'airport'; iconClass = 'fa-plane'; color = '#607d8b'; }

            let divIcon = L.divIcon({
                html: `<div class="animated-pin" style="background:${color};color:#fff;width:24px;height:24px;
                                  border-radius:50%;display:flex;align-items:center;justify-content:center;
                                  font-size:12px;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.5); cursor:pointer;
                                  animation-delay: ${(Math.random() * 0.4).toFixed(2)}s;">
                         <i class="fa ${iconClass}"></i>
                       </div>`,
                className: '', iconSize: [24, 24], iconAnchor: [12, 12]
            });
            const m = L.marker([e.geocodes?.main?.latitude || 0, e.geocodes?.main?.longitude || 0], {icon: divIcon});
            m.category = cat;
            m.bindTooltip(`<strong>${e.name}</strong>`, {direction:'top', offset:[0,-10], permanent: true, className: 'poi-tooltip'});
