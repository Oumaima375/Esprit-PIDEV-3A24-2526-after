function refreshMap() {
    if (!map) return;
    map.invalidateSize({ animate: false });
}

// Forcer la taille de la map avec resize observer
function watchMapContainer() {
    const wrapper = document.getElementById('mapWrapper');
    if (!wrapper || !window.ResizeObserver) return;
    new ResizeObserver(() => {
        if (map) refreshMap();
    }).observe(wrapper);
}

function setLocation(lat, lng, label, zoom) {
    lat = parseFloat(lat); lng = parseFloat(lng);
    if (isNaN(lat) || isNaN(lng)) return;
    latInput.value = lat;
    lngInput.value = lng;
    currentCenter = { lat, lng };

    if (marker) marker.setLatLng([lat, lng]);
    else        marker = L.marker([lat, lng]).addTo(map);

    map.setView([lat, lng], zoom || 17);
    if (label) lieuInput.value = label;
    setTimeout(refreshMap, 50);
}

function reverseGeocode(lat, lng) {
    // ETAPE 1 : Tenter Foursquare pour les commerces (Le plus puissant)
    fetch(`https://api.foursquare.com/v3/places/search?ll=${lat},${lng}&radius=50&limit=1`, {
        headers: { 'Authorization': 'KTEUWBOISVCCLXDBCPCB5BQRBXLJBAH1RQMDLSCIQQS15ZSI' }
    })
    .then(r => { if(!r.ok) throw new Error('FSQ Error'); return r.json(); })
    .then(d => {
        if (d.results && d.results.length > 0) {
            const poiName = d.results[0].name;
            lieuInput.value = poiName;
            fetchNominatimFallback(lat, lng, poiName); // Récupérer la rue en complément
        } else {
            // Aucun lieu sur Foursquare, on passe au plan B local
            runOsmReverseRadar(lat, lng);
        }
    })
    .catch(() => runOsmReverseRadar(lat, lng));
}

function runOsmReverseRadar(lat, lng) {
    // ETAPE 2 : Radar local Overpass (Si Foursquare a échoué ou rien trouvé)
    const q = `[out:json][timeout:3];(node(around:40,${lat},${lng})["name"];way(around:40,${lat},${lng})["name"];);out center tags 1;`;
    fetch('https://overpass-api.de/api/interpreter', { method: 'POST', body: q })
        .then(r => r.json())
        .then(d => {
            if (d.elements && d.elements.length > 0) {
                const poiName = d.elements[0].tags.name;
                lieuInput.value = poiName;
                fetchNominatimFallback(lat, lng, poiName);
            } else {
                fetchNominatimFallback(lat, lng, null);
            }
        }).catch(() => fetchNominatimFallback(lat, lng, null));
}

function fetchNominatimFallback(lat, lng, prefixName) {
    // zoom=18 privilégie les points d'intérêts au lieu des quartiers généraux
    fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&zoom=18`)
        .then(r => r.json())
        .then(d => { 
            if (d.display_name) {
                let lieu = d.display_name;
                // Si on a trouvé un commerce via le Radar et qu'il n'est pas dans l'adresse brute
                if (prefixName && !lieu.includes(prefixName)) {
                    lieuInput.value = prefixName + ', ' + (d.address?.city || d.address?.town || lieu.split(',').slice(-3).join(','));
                } else if (!prefixName) {
                    if (d.name && !lieu.startsWith(d.name)) lieu = d.name + ', ' + lieu;
                    lieuInput.value = lieu; 
                }
            }
        })
        .catch(() => {});
}

function clearSuggestions() {
    suggestionsDiv.innerHTML = '';
    suggestionsDiv.style.display = 'none';
}

function showSuggestions(items, onClick) {
    suggestionsDiv.innerHTML = '';
    items.forEach(item => {
        const d = document.createElement('div');
        d.className = 'suggestion-item';
        d.innerHTML = `<strong>${item.title}</strong>${item.subtitle ? `<br><small class="text-muted">${item.subtitle}</small>` : ''}`;
        d.addEventListener('click', () => { clearSuggestions(); onClick(item); });
        suggestionsDiv.appendChild(d);
    });
    suggestionsDiv.style.display = items.length ? 'block' : 'none';
}

function clearPoiMarkers() {
    poiMarkers.forEach(m => map.removeLayer(m));
    poiMarkers = [];
}

function photonSearch(query) {
    // Ajout de &lat= &lon= pour prioriser les résultats autour de la position actuelle de l'utilisateur
    const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&lat=${currentCenter.lat}&lon=${currentCenter.lng}&limit=8`;
    return fetch(url)
        .then(r => r.json())
        .then(d => (d.features || []).map(f => ({
            title: f.properties.name || f.properties.street || 'Lieu',
            subtitle: [f.properties.street, f.properties.city, f.properties.country].filter(Boolean).join(', '),
            lat: f.geometry.coordinates[1],
            lng: f.geometry.coordinates[0],
            display_name: [f.properties.name, f.properties.city, f.properties.country].filter(Boolean).join(', ')
        })));
}

function parseCoords(v) {
    const m1 = (v || '').match(/(-?\d+(?:[.,]\d+)?)\s*[,;]\s*(-?\d+(?:[.,]\d+)?)/);
    if (m1) return { lat: parseFloat(m1[1].replace(',', '.')), lng: parseFloat(m1[2].replace(',', '.')) };
    const m2 = (v || '').match(/@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
    if (m2) return { lat: parseFloat(m2[1]), lng: parseFloat(m2[2]) };
    return null;
}

function doSearch(q) {
    if (!q) return;
    geoStatusDiv.textContent = 'Recherche…';
    geoStatusDiv.style.display = 'block';
    const coords = parseCoords(q);
    if (coords) {
        setLocation(coords.lat, coords.lng, q);
        reverseGeocode(coords.lat, coords.lng);
        geoStatusDiv.style.display = 'none';
        return;
    }
    photonSearch(q).then(res => {
        geoStatusDiv.style.display = 'none';
        if (!res.length) {
            geoStatusDiv.textContent = 'Aucun résultat.';
            geoStatusDiv.style.display = 'block';
            return;
        }
        setLocation(res[0].lat, res[0].lng, res[0].display_name);
        showSuggestions(res, item => setLocation(item.lat, item.lng, item.display_name));
    }).catch(() => {
        geoStatusDiv.textContent = 'Erreur réseau.';
        geoStatusDiv.style.display = 'block';
    });
}

// ── Chargement automatique et Puces (Filtrage) ──
function clearBackgroundMarkers() {
    bgMarkers.forEach(m => { if (map.hasLayer(m)) map.removeLayer(m); });
    bgMarkers = [];
}

function applyFilter() {
    let count = 0;
    // Affiche ou masque les marqueurs selon la catégorie cliquée
    bgMarkers.forEach(m => {
        const isMatch = !activePoi || m.category === activePoi;
        if (isMatch) {
            if (!map.hasLayer(m)) m.addTo(map);
            count++;
        } else {
            if (map.hasLayer(m)) map.removeLayer(m);
        }
    });

    const geoStatusDiv = document.getElementById('geoStatus');
    if (activePoi) {
        if (count === 0) {
            geoStatusDiv.style.display = 'block';
            geoStatusDiv.textContent = `Aucun(e) ${activePoi} visible ici. Déclenchement d'une recherche plus large...`;
            fetchNearbyMapIcons(true);
        } else {
            geoStatusDiv.style.display = 'block';
            geoStatusDiv.textContent = `Filtre actif : ${count} lieu(x) affiché(s).`;
        }
    } else {
        geoStatusDiv.style.display = 'none';
    }
}

