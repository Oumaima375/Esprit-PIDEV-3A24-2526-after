<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}After Travel{% endblock %}</title>

    <script>
        (function() {
            const t = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/templatemo-crypto-dashboard.css') }}">
    {% block stylesheets %}{% endblock %}

    <style>
        /* ── FONTS ── */
        body, .sidebar, .main-content {
            font-family: 'DM Sans', sans-serif !important;
        }

        /* ── SIDEBAR BRAND ── */
        .logo {
            padding: 24px 20px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 8px;
        }
        .logo-icon {
            width: 36px; height: 36px;
            background: var(--accent-gradient);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Playfair Display', serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--bg-primary);
            flex-shrink: 0;
        }
        .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--text-primary);
            font-weight: 700;
        }

        /* ── SECTION LABELS ── */
        .nav-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 14px 18px 5px;
        }

        /* ── NAV ITEMS ── */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 18px;
            border-radius: 10px;
            margin: 1px 8px;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text-secondary);
            text-decoration: none;
            transition: background .15s, color .15s;
        }
        .nav-item:hover {
            background: var(--bg-card-hover);
            color: var(--text-primary);
            text-decoration: none;
        }
        .nav-item.active {
            background: rgba(184,115,51,.15);
            color: var(--accent-copper);
        }
        .nav-item.active .nav-icon { color: var(--accent-copper); }

        .nav-icon {
            width: 16px; height: 16px;
            flex-shrink: 0;
            opacity: .7;
        }
        .nav-item.active .nav-icon { opacity: 1; }

        /* ── MODULE BADGE ── */
        .nav-badge {
            margin-left: auto;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 20px;
            background: var(--accent-copper);
            color: var(--bg-primary);
        }

        /* ── COLLAPSIBLE MODULE GROUP ── */
        .nav-group-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 18px;
            border-radius: 10px;
            margin: 1px 8px;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            background: none;
            border: none;
            font-family: inherit;
            width: calc(100% - 16px);
            text-align: left;
            transition: background .15s, color .15s;
        }
        .nav-group-toggle:hover {
            background: var(--bg-card-hover);
            color: var(--text-primary);
        }
        .nav-group-chevron {
            margin-left: auto;
            font-size: 10px;
            transition: transform .2s;
            opacity: .5;
        }
        .nav-group-chevron.open { transform: rotate(180deg); }

        .nav-group-items {
            overflow: hidden;
            max-height: 0;
            transition: max-height .25s ease;
        }
        .nav-group-items.open { max-height: 500px; }

        .nav-sub-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 18px 7px 44px;
            border-radius: 8px;
            margin: 1px 8px;
            font-size: 13px;
            font-weight: 400;
            color: var(--text-secondary);
            text-decoration: none;
            transition: background .15s, color .15s;
        }
        .nav-sub-item:hover {
            background: var(--bg-card-hover);
            color: var(--text-primary);
            text-decoration: none;
        }
        .nav-sub-item.active {
            color: var(--accent-copper);
        }

        /* ── USER CARD ── */
        .sidebar-user-block {
            padding: 8px 12px;
        }
        .sidebar-user-card {
            border-radius: 14px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 11px;
            transition: background .2s;
            text-decoration: none;
        }
        .sidebar-user-card:hover {
            text-decoration: none;
            background: var(--bg-card-hover) !important;
        }
        [data-theme="dark"]  .sidebar-user-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
        [data-theme="light"] .sidebar-user-card { background: rgba(0,0,0,.04); border: 1px solid rgba(0,0,0,.08); }

        .sidebar-user-avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px;
            font-weight: 700;
            flex-shrink: 0;
            text-transform: uppercase;
            overflow: hidden;
            background: linear-gradient(135deg, #c2855a 0%, #e0a876 100%);
            color: #fff;
        }
        .sidebar-user-avatar img {
            width: 100%; height: 100%;
            object-fit: cover;
        }
        .sidebar-user-avatar--admin {
            background: linear-gradient(135deg, #5a7ec2 0%, #76a0e0 100%);
        }
        .sidebar-user-info { flex: 1; min-width: 0; }
        .sidebar-user-name {
            font-size: 13.5px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-primary);
        }
        .sidebar-user-sub {
            font-size: 11px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--text-secondary);
            margin-top: 2px;
        }
        .sidebar-role-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 4px;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 10.5px;
            font-weight: 600;
        }
        .sidebar-role-pill.voyageur {
            background: rgba(194,133,90,.18);
            color: var(--accent-copper);
            border: 1px solid rgba(194,133,90,.3);
        }
        .sidebar-role-pill.admin {
            background: rgba(90,126,194,.18);
            color: #76a0e0;
            border: 1px solid rgba(90,126,194,.3);
        }

        /* ── LOGOUT ── */
        .sidebar-logout-wrap {
            padding: 4px 12px 8px;
        }
        .sidebar-logout-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            color: #ef4444;
            text-decoration: none;
            transition: background .15s;
        }
        .sidebar-logout-link:hover {
            background: rgba(239,68,68,.1);
            text-decoration: none;
        }

        /* ── DIVIDER ── */
        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 6px 16px;
        }

        /* ── FLASH MESSAGES ── */
        .at-flash {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .at-flash-success { background: rgba(22,163,74,.12); color: #4ade80; border-color: rgba(22,163,74,.25); }
        .at-flash-error   { background: rgba(239,68,68,.12);  color: #f87171; border-color: rgba(239,68,68,.25); }
        .at-flash-info    { background: rgba(59,130,246,.12); color: #93c5fd; border-color: rgba(59,130,246,.25); }

        /* ── THEME TOGGLE ── */
        .sidebar-footer {
            padding: 8px 12px 16px;
        }
        .theme-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
        }
        .theme-toggle-label {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            color: var(--text-secondary);
        }
    </style>
</head>
<body>

    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menu">
        <div class="hamburger"><span></span><span></span><span></span></div>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="dashboard">

        <!-- ══════════════════════════════════════
             SIDEBAR
        ══════════════════════════════════════ -->
        <aside class="sidebar" id="sidebar">

            <!-- Brand -->
            <div class="logo">
                <div class="logo-icon">AT</div>
                <span class="logo-text">AfterTravel</span>
            </div>

            <!-- Navigation -->
            <nav class="nav-section" style="flex:1;overflow-y:auto;">

                <!-- PRINCIPAL -->
                <div class="nav-label">Principal</div>

                <a href="{{ path('app_dashboard') }}"
                   class="nav-item {{ app.request.get('_route') == 'app_dashboard' ? 'active' }}">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3"  y="3"  width="7" height="7" rx="1"/>
                        <rect x="14" y="3"  width="7" height="7" rx="1"/>
                        <rect x="3"  y="14" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                    Tableau de bord
                </a>

                <a href="{{ path('app_profile') }}"
                   class="nav-item {{ app.request.get('_route') == 'app_profile' ? 'active' }}">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Mon profil
                </a>

                <!-- MODULES (collapsible) -->
                <div class="nav-label" style="margin-top:8px;">Modules</div>

                <!-- Voyages -->
                <button class="nav-group-toggle" onclick="toggleGroup('g-voyages')" id="toggle-g-voyages">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                    Voyages
                    <span class="nav-group-chevron" id="chevron-g-voyages">&#9660;</span>
                </button>
                <div class="nav-group-items" id="g-voyages">
                    <a href="{{ path('app_voyage') }}"
                       class="nav-sub-item {{ app.request.get('_route') == 'app_voyage' ? 'active' }}">
                       &#x2022; Liste des voyages
                    </a>
                    <a href="{{ path('app_voyage_recommandations') }}"
                       class="nav-sub-item {{ app.request.get('_route') == 'app_voyage_recommandations' ? 'active' }}">
                       &#x2022; Recommandations
                    </a>
                    <a href="{{ path('app_voyage_recommandations_ia') }}"
                       class="nav-sub-item {{ app.request.get('_route') == 'app_voyage_recommandations_ia' ? 'active' }}">
                       &#x2022; IA Conseiller
                    </a>
                    <a href="{{ path('app_voyage_favoris') }}"
                       class="nav-sub-item {{ app.request.get('_route') == 'app_voyage_favoris' ? 'active' }}">
                       &#x2022; Mes favoris
                    </a>
                </div>

                <!-- Destinations -->
                <a href="{{ path('app_destination') }}"
                   class="nav-item {{ app.request.get('_route') starts with 'app_destination' ? 'active' }}">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    Destinations
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                <!-- ADMIN SECTION -->
                <div class="sidebar-divider"></div>
                <div class="nav-label">Administration</div>

                <a href="{{ path('app_dashboard') }}"
                   class="nav-item {{ app.request.get('_route') starts with 'user' ? 'active' }}">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Utilisateurs
                    <span class="nav-badge">ADM</span>
                </a>

                <a href="{{ path('users_export_csv') }}" class="nav-item">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Export CSV
                </a>

                <a href="{{ path('users_export_pdf') }}" class="nav-item">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    Export PDF
                </a>
                {% endif %}

                <!-- SITE PUBLIC -->
                <div class="sidebar-divider"></div>
                <a href="{{ path('app_home') }}" class="nav-item" style="opacity:.65">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Retour au site
                </a>

            </nav>

            <!-- User card -->
            {% if app.user %}
                {% set isAdmin = app.user.typeUtilisateur|upper == 'ADMIN' %}
                {% set initials = (app.user.prenom|first ~ app.user.nom|first)|upper %}
                <div class="sidebar-divider"></div>
                <div class="sidebar-user-block">
                    <a href="{{ path('app_profile') }}" class="sidebar-user-card">
                        <div class="sidebar-user-avatar {{ isAdmin ? 'sidebar-user-avatar--admin' : '' }}">
                            {% if app.user.photoProfil and app.user.photoProfil != 'default.png' %}
                                <img src="{{ asset('uploads/photos/' ~ app.user.photoProfil) }}"
                                     alt="{{ app.user.prenom }}"
                                     onerror="this.parentElement.textContent='{{ initials }}'">
                            {% else %}
                                {{ initials }}
                            {% endif %}
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">{{ app.user.prenom }} {{ app.user.nom }}</div>
                            <div class="sidebar-user-sub">{{ app.user.email }}</div>
                            <span class="sidebar-role-pill {{ isAdmin ? 'admin' : 'voyageur' }}">
                                {{ isAdmin ? 'Administrateur' : 'Voyageur' }}
                            </span>
                        </div>
                    </a>
                </div>
            {% endif %}

            <!-- Logout -->
            <div class="sidebar-logout-wrap">
                <a href="{{ path('_logout_main') }}" class="sidebar-logout-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Déconnexion
                </a>
            </div>

            <!-- Theme toggle -->
            <div class="sidebar-footer">
                <div class="theme-toggle">
                    <div class="theme-toggle-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="5"/>
                            <line x1="12" y1="1"  x2="12" y2="3"/>
                            <line x1="12" y1="21" x2="12" y2="23"/>
                            <line x1="4.22"  y1="4.22"  x2="5.64"  y2="5.64"/>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                            <line x1="1"  y1="12" x2="3"  y2="12"/>
                            <line x1="21" y1="12" x2="23" y2="12"/>
                            <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
                            <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
                        </svg>
                        Mode clair
                    </div>
                    <div class="theme-switch" id="themeSwitch"></div>
                </div>
            </div>

        </aside>

        <!-- ══════════════════════════════════════
             MAIN CONTENT
        ══════════════════════════════════════ -->
        <main class="main-content">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="at-flash at-flash-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'info') }}">
                        {% if label == 'success' %}&#x2713;{% elseif label == 'error' %}&#x2717;{% else %}&#x2139;{% endif %}
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}

            <footer class="copyright" style="font-family:'DM Sans',sans-serif;font-size:12px;">
                &copy; 2026 After Travel &mdash; AfterTravel Platform
            </footer>
        </main>

    </div><!-- /.dashboard -->

    <script src="{{ asset('js/templatemo-crypto-script.js') }}"></script>

    <script>
    /* Collapsible nav groups */
    function toggleGroup(id) {
        var items   = document.getElementById(id);
        var chevron = document.getElementById('chevron-' + id);
        if (!items) return;
        var isOpen = items.classList.contains('open');
        items.classList.toggle('open', !isOpen);
        if (chevron) chevron.classList.toggle('open', !isOpen);
        localStorage.setItem('nav-' + id, isOpen ? '' : '1');
    }

    /* Restore open state on load */
    (function(){
        ['g-voyages'].forEach(function(id) {
            if (localStorage.getItem('nav-' + id) === '1') {
                var el = document.getElementById(id);
                var ch = document.getElementById('chevron-' + id);
                if (el) el.classList.add('open');
                if (ch) ch.classList.add('open');
            }
        });

        /* Auto-open the group if a child is active */
        var activeChild = document.querySelector('.nav-group-items .nav-sub-item.active');
        if (activeChild) {
            var parent = activeChild.closest('.nav-group-items');
            if (parent) {
                parent.classList.add('open');
                var ch = document.getElementById('chevron-' + parent.id);
                if (ch) ch.classList.add('open');
            }
        }
    })();
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
