{% extends 'base.html.twig' %}
{% block title %}Catégorie - {{ categorie_document.libelle }}{% endblock %}
{% block body %}

<div class="container-fluid bg-info py-5 mb-5">
    <div class="container py-5 text-center">
        <h1 class="display-3 text-white">👁 Détail Catégorie</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-top-4">
                    <h4 class="mb-0">📂 {{ categorie_document.libelle }}</h4>
                </div>
                <div class="card-body p-4">
                    <table class="table table-bordered">
                        <tr>
                            <th class="bg-light">ID</th>
                            <td>{{ categorie_document.idCategorie }}</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Libellé</th>
                            <td>
                                <span class="badge bg-info text-dark fs-6">
                                    {{ categorie_document.libelle }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Description</th>
                            <td>{{ categorie_document.description ?? 'N/A' }}</td>
                        </tr>
                    </table>

                    <div class="d-flex gap-3 mt-3">
                        <a href="{{ path('app_categorie_document_edit', {'idCategorie': categorie_document.idCategorie}) }}"
                           class="btn btn-warning">✏️ Modifier</a>
                        <a href="{{ path('app_categorie_document_index') }}"
                           class="btn btn-outline-secondary">← Retour à la liste</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}